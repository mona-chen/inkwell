<%
  record = local_assigns[:record] || @post || @page
  record_type = record.is_a?(Page) ? "page" : "post"
  record_id = record&.id
  saved_html = local_assigns[:data]&.dig("html").to_s
  # Only the body is page content — the stored <head> is builder/theme scaffolding (and has,
  # historically, carried multi-MB bloat). Never ship it into the editor DOM.
  body_only_html = saved_html[/<body[^>]*>(.*?)<\/body>/m, 1].presence || saved_html
  # The preview iframe is sandboxed (no scripts) but needs the builder's design vocabulary + the
  # page's custom CSS so the built page renders with its actual styles — matching the live page.
  custom_css = local_assigns[:data]&.dig("custom_css").to_s
  preview_doc = +<<~HTML
    <!doctype html><html><head><meta charset="utf-8">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <link href="/page_builder_theme/ink-design-kit.css" rel="stylesheet">
    <style>*,*::before,*::after{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:Inter,system-ui,sans-serif}.ink-builder-content{width:100%;min-width:0}h1,h2,h3,h4,h5,h6,p,figure,blockquote{margin:0}img,svg,video,canvas{display:block;max-width:100%}</style>
    #{custom_css.present? ? "<style>#{custom_css}</style>" : ""}
    </head><body><div class="ink-builder-content">#{body_only_html}</div></body></html>
  HTML
%>
<div data-block-editor-target="block" data-type="page_builder"
     class="group relative border border-gray-200 rounded-lg p-4 bg-white hover:border-gray-300 transition-colors">
  <%= render "admin/posts/blocks/toolbar" %>
  <input type="hidden" data-field="html" value="<%= html_escape(body_only_html) %>">

  <div class="flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-9 h-9 rounded-lg bg-indigo-50 text-indigo-700 flex items-center justify-center">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z" /></svg>
      </div>
      <div>
        <div class="text-sm font-medium">Ink Builder</div>
        <div class="text-xs text-gray-400 mt-0.5">Drag-and-drop layout · saved as ERB</div>
      </div>
    </div>
    <% if record_id %>
      <%# The builder always opens in a new tab — never navigate away from the editor. %>
      <a href="/builder/<%= record_type %>/<%= record_id %>" target="_blank" rel="noopener"
         class="text-sm px-4 py-2 rounded-lg bg-gray-900 text-white font-medium shadow-sm hover:bg-black active:scale-[0.98] transition">
        Open Ink Builder
      </a>
    <% else %>
      <span class="text-xs text-gray-400">Save the <%= record_type %> first, then open the builder.</span>
    <% end %>
  </div>

  <% unless saved_html.blank? %>
    <div class="mt-4 pt-4 border-t border-gray-100">
      <div class="text-xs text-gray-400 mb-2">Preview</div>
      <div class="border border-dashed border-gray-200 rounded-lg bg-white overflow-hidden">
        <iframe sandbox="" title="Ink Builder preview" loading="lazy"
                class="w-full" style="height: 320px; border: 0; display: block;"
                srcdoc="<%= html_escape(preview_doc) %>"></iframe>
      </div>
    </div>
  <% end %>
</div>

<% if record_id %>
<%# Cross-tab: when the builder saves, this page reloads so the block reflects the new build. %>
<script>
  (function () {
    var key = 'inkwell_pb_<%= record_type %>_<%= record_id %>';
    window.addEventListener('storage', function (e) {
      if (e.key === key) { location.reload(); }
    });
  })();
</script>
<% end %>
