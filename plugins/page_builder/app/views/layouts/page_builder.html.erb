<!DOCTYPE html>
<html lang="en" data-ink-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <%= csrf_meta_tags %>
  <%= javascript_importmap_tags %>
  <title>Ink Builder — Inkwell</title>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

  <% builder_css_version = File.mtime(Rails.root.join("public/page_builder_assets/builder.css")).to_i rescue 1 %>
  <% builder_js_version = File.mtime(Rails.root.join("public/page_builder_assets/builder.js")).to_i rescue 1 %>
  <link href="/page_builder_assets/builder.css?v=<%= builder_css_version %>" rel="stylesheet" />
  <script src="/page_builder_assets/builder.js?v=<%= builder_js_version %>"></script>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/material-darker.min.css" rel="stylesheet">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/xml/xml.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/css/css.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/closebrackets.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/matchbrackets.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/selection/active-line.min.js"></script>
</head>
<body>
  <!-- Loading Overlay -->
  <div id="page-loader-overlay">
    <div class="loader"></div>
  </div>

  <script>
    // The loader must never trap the editor: external CDNs (fonts, Bootstrap, CodeMirror,
    // maps embeds) can keep `window load` from firing, which would leave an invisible overlay
    // capturing every click and hover. Fade it out on the first real readiness signal.
    function hidePageLoader() {
      var loader = document.getElementById('page-loader-overlay');
      if (loader && !loader.classList.contains('fade-out')) loader.classList.add('fade-out');
      document.body.classList.remove('loading');
    }
    window.addEventListener('load', hidePageLoader);
    window.addEventListener('DOMContentLoaded', function () {
      setTimeout(hidePageLoader, 3500);
    });
  </script>

  <header class="ink-appbar">
    <div class="ink-appbar-start">
      <button type="button" class="ink-appbar-logo" aria-label="Ink Builder" title="Ink Builder">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z"/></svg>
      </button>
      <button type="button" class="ink-appbar-action is-primary" data-panel="elements" title="Add elements" aria-label="Add elements"><span class="material-symbols-rounded">add</span><span>Add Elements</span></button>
      <button type="button" class="ink-appbar-action" data-panel="site" title="Page settings" aria-label="Page settings"><span class="material-symbols-rounded">description</span></button>
      <button type="button" class="ink-appbar-action" data-panel="history" title="History" aria-label="History"><span class="material-symbols-rounded">history</span></button>
      <button type="button" class="ink-appbar-action" data-panel="site" title="Site settings" aria-label="Site settings"><span class="material-symbols-rounded">tune</span></button>
    </div>
    <div class="ink-appbar-center" role="group" aria-label="Page and responsive preview">
      <button type="button" id="pageSwitcherButton" class="ink-appbar-document" title="Pages" aria-label="Open pages"><span class="ink-appbar-document-name">Blank</span><span class="material-symbols-rounded">expand_more</span></button>
      <div id="pageSwitcher" class="ink-page-switcher" hidden></div>
      <span class="ink-appbar-divider"></span>
      <button id="desktopModeButton" onclick="switchToDesktopMode()" type="button" class="builder-mode-button active" title="Desktop"><span class="material-symbols-rounded">desktop_windows</span></button>
      <button id="tabletModeButton" onclick="switchToTabletMode()" type="button" class="builder-mode-button" title="Tablet"><span class="material-symbols-rounded">tablet</span></button>
      <button id="mobileModeButton" onclick="switchToMobileMode()" type="button" class="builder-mode-button" title="Mobile"><span class="material-symbols-rounded">smartphone</span></button>
    </div>
    <div class="ink-appbar-end">
      <button type="button" data-action="finder" title="Finder (⌘K)" aria-label="Finder"><span class="material-symbols-rounded">search</span></button>
      <button type="button" id="structureButton" class="ink-appbar-navigator" data-action="structure" title="Navigator (Layers)" aria-label="Open Navigator">
        <svg class="ink-appbar-lucide" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/>
          <path d="m22 12.5-9.17 4.17a2 2 0 0 1-1.66 0L2 12.5"/>
          <path d="m22 17.5-9.17 4.17a2 2 0 0 1-1.66 0L2 17.5"/>
        </svg>
        <span class="ink-appbar-action-label">Navigator</span>
      </button>
      <% if defined?(AiWriter) && InstalledPlugin.find_by(slug: "ai_writer")&.active? %>
        <button type="button" id="copilotButton" data-action="copilot" title="Copilot" aria-label="Copilot"><span class="material-symbols-rounded">sparkles</span></button>
      <% end %>
      <button id="toggleButton" onclick="toggleDesignMode()" type="button" title="Preview" aria-label="Preview"><span class="material-symbols-rounded">visibility_off</span></button>
      <button id="btn-save" onclick="saveToInkwell()" type="button" class="ink-appbar-publish"><span class="material-symbols-rounded">publish</span><span>Publish</span></button>
      <button type="button" data-action="menu" title="Page actions" aria-label="Page actions"><span class="material-symbols-rounded">more_vert</span></button>
      <div class="ink-appbar-menu" data-menu hidden>
        <button type="button" data-smenu="design" onclick="enterBuilderMode('design')"><span class="material-symbols-rounded">design_services</span><span>Design</span></button>
        <button type="button" data-smenu="code" onclick="enterBuilderMode('code')"><span class="material-symbols-rounded">code</span><span>Code editor</span></button>
        <button type="button" onclick="saveDraftToInkwell()"><span class="material-symbols-rounded">save</span><span>Save draft</span></button>
        <button type="button" onclick="previewDraftPage()"><span class="material-symbols-rounded">preview</span><span>Preview page</span></button>
        <% if @record.is_a?(Page) && @record.original_import_available? %>
          <button type="button" onclick="publishOriginalImport()"><span class="material-symbols-rounded">history</span><span>Keep original import live</span></button>
        <% end %>
        <button id="visitPageButton" type="button" onclick="visitPublishedPage()"<%= " hidden" unless @record.status == "published" %>><span class="material-symbols-rounded">open_in_new</span><span>Visit page</span></button>
        <button type="button" onclick="openCaptureImporter()"><span class="material-symbols-rounded">language</span><span>Import captured site</span></button>
        <button type="button" onclick="builder?.toggleHotkeys?.()"><span class="material-symbols-rounded">help</span><span>Keyboard shortcuts</span></button>
        <button type="button" onclick="toggleTheme()"><span class="material-symbols-rounded" id="themeModeIcon">dark_mode</span><span id="themeModeLabel">Light mode</span></button>
        <button type="button" onclick="clearPage()"><span class="material-symbols-rounded">delete_sweep</span><span>Clear page</span></button>
        <button type="button" onclick="window.close()"><span class="material-symbols-rounded">close</span><span>Close editor</span></button>
      </div>
    </div>
  </header>

  <div class="ink-editor-workspace">
    <div data-smenu-container="design" class="ink-editor-design">
      <main class="ink-canvas-stage">
        <div class="spin-loader"></div>
        <div id="MainContainer" class="content-container"></div>
        <section id="PagesCanvas" class="ink-pages-canvas" aria-label="All pages" hidden></section>
      </main>

      <% if defined?(AiWriter) && InstalledPlugin.find_by(slug: "ai_writer")&.active? %>
        <aside id="CopilotDock" class="ink-copilot-dock" hidden>
          <%= render "ai_writer/builder_copilot" %>
        </aside>
      <% end %>

      <aside class="builder-sidebar">
        <div id="Sidebar">
          <div class="builder-sidebar-tabs">
            <div class="tab-item active" data-tab="widgets"><span class="material-symbols-rounded">widgets</span></div>
            <div class="tab-item" data-tab="controls"><span class="material-symbols-rounded">settings</span></div>
            <div class="tab-item" data-tab="styles"><span class="material-symbols-rounded">palette</span></div>
            <div class="tab-item" data-tab="code"><span class="material-symbols-rounded">code</span></div>
          </div>
          <div>
            <div id="WidgetsContainer" data-tab-container="widgets"></div>
            <div id="SettingsContainer" data-tab-container="controls" style="display: none;"></div>
            <div data-tab-container="styles" style="display: none;"></div>
            <div data-tab-container="code" style="display: none;" class="ink-sidebar-code">
              <label for="customCss">Custom CSS</label>
              <textarea id="customCss" rows="8" class="font-monospace"
                        placeholder="/* page-level CSS, preserved on save */&#10;.hero { background: linear-gradient(135deg,#0f172a,#1e293b); }"></textarea>
              <label for="customJs">Custom JS</label>
              <textarea id="customJs" rows="6" class="font-monospace"
                        placeholder="// page-level JS, runs on the page"></textarea>
            </div>
          </div>
        </div>
      </aside>
    </div>

    <div data-smenu-container="code" class="code-editor-container" style="display: none;">
      <div class="ink-code-workspace">
        <div class="ink-code-toolbar">
          <span class="ink-code-title"><span class="material-symbols-rounded">code</span><span>Page source</span></span>
          <p class="ink-code-help">HTML mirrors native builder elements. Page CSS and JavaScript remain editable, live, and publish with this page.</p>
          <div class="ink-code-actions">
            <button type="button" onclick="formatActiveCodeFile()" class="ink-code-button"><span class="material-symbols-rounded">format_align_left</span> Format</button>
            <button type="button" onclick="applyCodeSource(false)" class="ink-code-button">Apply</button>
            <button type="button" onclick="applyCodeSource(true)" class="ink-code-button is-primary">Apply &amp; Save</button>
          </div>
        </div>
        <div class="ink-code-body">
          <aside class="ink-code-explorer" aria-label="Page files">
            <header><span>Explorer</span><span class="material-symbols-rounded">more_horiz</span></header>
            <div class="ink-code-folder"><span class="material-symbols-rounded">expand_more</span><strong>PAGE</strong></div>
            <button type="button" class="ink-code-file is-active" data-code-file="html"><span class="ink-file-badge is-html">&lt;&gt;</span><span>page.html</span><i data-dirty-for="html"></i></button>
            <button type="button" class="ink-code-file" data-code-file="css"><span class="ink-file-badge is-css">#</span><span>page.css</span><i data-dirty-for="css"></i></button>
            <button type="button" class="ink-code-file" data-code-file="js"><span class="ink-file-badge is-js">JS</span><span>page.js</span><i data-dirty-for="js"></i></button>
          </aside>
          <main class="ink-code-main">
            <div class="ink-code-tabs" role="tablist" aria-label="Open source files">
              <button type="button" class="ink-code-tab code-file-tab is-active" data-code-file="html" role="tab" aria-selected="true"><span class="ink-file-badge is-html">&lt;&gt;</span> page.html</button>
              <button type="button" class="ink-code-tab code-file-tab" data-code-file="css" role="tab" aria-selected="false"><span class="ink-file-badge is-css">#</span> page.css</button>
              <button type="button" class="ink-code-tab code-file-tab" data-code-file="js" role="tab" aria-selected="false"><span class="ink-file-badge is-js">JS</span> page.js</button>
            </div>
            <div class="ink-code-status" data-code-guidance><strong>HTML is generated from the editable element tree.</strong> Edit structure on canvas; use CSS and JS for custom behavior.</div>
            <textarea id="codeFileHtml" class="code-editor-textarea font-monospace" spellcheck="false" data-code-editor-for="html"></textarea>
            <textarea id="codeFileCss" class="code-editor-textarea font-monospace" spellcheck="false" data-code-editor-for="css" style="display: none;"></textarea>
            <textarea id="codeFileJs" class="code-editor-textarea font-monospace" spellcheck="false" data-code-editor-for="js" style="display: none;"></textarea>
            <footer class="ink-code-footer"><span data-code-position>Ln 1, Col 1</span><span>Spaces: 2</span><span>UTF-8</span><span data-code-language>HTML</span></footer>
          </main>
        </div>
      </div>
    </div>
  </div>

  <dialog id="captureImporter" class="ink-capture-dialog" aria-labelledby="captureImporterTitle">
    <header>
      <div><span class="ink-pages-eyebrow">Native website import</span><h2 id="captureImporterTitle">Captured sites</h2></div>
      <button type="button" data-close-capture aria-label="Close"><span class="material-symbols-rounded">close</span></button>
    </header>
    <p>Choose an authorized capture. Its visual structure, copy, media, CSS, and safe motion are converted to editable builder elements. Raw site scripts are never executed.</p>
    <div class="ink-capture-list" data-capture-list><span class="ink-capture-empty">Loading captures…</span></div>
    <footer><span data-capture-status>Select a capture to inspect it.</span><button type="button" class="ink-code-button is-primary" data-import-capture disabled>Import as current page</button></footer>
  </dialog>


  <script>
    var savedStore = <%= @saved_store.to_json.html_safe %>;
    var recordType = <%= params[:record_type].to_json.html_safe %>;
    var savedCustomCss = <%= @saved_custom_css.to_json.html_safe %>;
    var savedCustomJs = <%= @saved_custom_js.to_json.html_safe %>;
    var savedSiteParts = <%= (@site_parts || {}).to_json.html_safe %>;
    var savedHtmlBody = <%= @saved_html_body.to_json.html_safe %>;
    var htmlDesign = <%= @html_design.to_json.html_safe %>;
    document.addEventListener('DOMContentLoaded', function () {
      if (document.getElementById('customCss') && savedCustomCss) document.getElementById('customCss').value = savedCustomCss;
      if (document.getElementById('customJs') && savedCustomJs) document.getElementById('customJs').value = savedCustomJs;
    });
    var recordId = <%= params[:record_id].to_json.html_safe %>;
    var recordTitle = <%= @record.title.to_json.html_safe %>;
    var publicPageUrl = <%= (@record.status == "published" ? (@record.is_a?(Page) ? "/pages/#{@record.slug}" : "/posts/#{@record.slug}") : nil).to_json.html_safe %>;
    var originalImportAvailable = <%= (@record.is_a?(Page) && @record.original_import_available?).to_json.html_safe %>;
    var previewPageUrl = <%= "/builder/#{@record.is_a?(Page) ? 'page' : 'post'}/#{@record.id}/preview".to_json.html_safe %>;
    var themeUrl = '/page_builder_theme';

    document.addEventListener('DOMContentLoaded', () => {
      window.builder = new InkBuilderV2({
        mainContainer: '#MainContainer',
        settingsContainer: '#SettingsContainer',
        widgetsContainer: '#WidgetsContainer',
        assetUploadHandler: '<%= "/builder/upload_asset" %>',
        aiHandler: null,
        carousel: false,
        customCss: savedCustomCss,
        customJs: savedCustomJs,
        siteParts: savedSiteParts,
      });

      var hasStore = savedStore && savedStore.version === 2;
      var loadPromise = Promise.resolve(hasStore ? savedStore : { version: 2, type: 'page', settings: { title: 'Blank' }, children: [] });

      loadPromise.then(function (store) {
        builder.load(store, themeUrl, () => {
          var documentName = document.querySelector('.ink-appbar-document-name');
          if (documentName && recordTitle) documentName.textContent = recordTitle;
          document.querySelector('.spin-loader').remove();
          hidePageLoader();
          if (typeof applyCustomCode === 'function') applyCustomCode();
        });
      });

      window.sidebarTabManager = new TabsManager();
      sidebarTabManager.addTab(document.querySelector('[data-tab="widgets"]'), document.querySelector('[data-tab-container="widgets"]'));
      sidebarTabManager.addTab(document.querySelector('[data-tab="controls"]'), document.querySelector('[data-tab-container="controls"]'));
      sidebarTabManager.addTab(document.querySelector('[data-tab="styles"]'), document.querySelector('[data-tab-container="styles"]'));
      sidebarTabManager.addTab(document.querySelector('[data-tab="code"]'), document.querySelector('[data-tab-container="code"]'));

      // App-bar wiring: left-panel screens, structure/finder toggles, and the actions menu.
      document.querySelectorAll('[data-panel]').forEach(function (button) {
        button.addEventListener('click', function () { if (window.builder?.openPanelScreen) window.builder.openPanelScreen(button.getAttribute('data-panel')); });
      });
      document.querySelector('[data-action="structure"]').addEventListener('click', function () { if (window.builder?.navigator) window.builder.navigator.toggle(); });
      document.querySelector('[data-action="finder"]').addEventListener('click', function () { if (window.builder?.finder) window.builder.finder.toggle(); });
      var menuButton = document.querySelector('[data-action="menu"]');
      var menuPanel = document.querySelector('[data-menu]');
      if (menuButton && menuPanel) {
        menuButton.addEventListener('click', function (event) {
          event.stopPropagation();
          menuPanel.hidden = !menuPanel.hidden;
          menuButton.classList.toggle('is-active', !menuPanel.hidden);
        });
        document.addEventListener('click', function () { menuPanel.hidden = true; menuButton.classList.remove('is-active'); });
      }
      initPageWorkspace();

      // The builder's native sidebar mode switch (Design / Code). window.smenu is the
      // builder's own TabsManager instance — it opens [data-smenu-container] for the
      // active [data-smenu] rail item, exactly like the demo expects.
      window.smenu = new TabsManager();
      smenu.addTab(document.querySelector('[data-smenu="design"]'), document.querySelector('[data-smenu-container="design"]'));
      smenu.addTab(document.querySelector('[data-smenu="code"]'), document.querySelector('[data-smenu-container="code"]'));
      smenu.openTab(document.querySelector('[data-smenu="design"]'));

      document.querySelectorAll('.smenu-item').forEach(function (item) {
        item.addEventListener('click', function () {
          enterBuilderMode(item.getAttribute('data-smenu'));
        });
      });

      initCodeMirrors();

      document.querySelectorAll('[data-code-file]').forEach(function (tab) {
        tab.addEventListener('click', function () {
          openCodeFile(tab.getAttribute('data-code-file'));
        });
      });

      switchToDesktopMode();
    });

    function persistBuilderDocument(publish) {
      var html = builder.getHtml();
      var store = builder.getData();
      var customCss = builder.customCode ? builder.customCode.getCss() : '';
      var customJs = builder.customCode ? builder.customCode.getJs() : '';
      return fetch('/builder/save', {
        method: 'POST',
        headers: {
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content,
          'Content-Type': 'application/json',
          'Accept': 'application/json'
        },
        body: JSON.stringify({ html: html, store: store, site_parts: builder.getSiteParts ? builder.getSiteParts() : {}, custom_css: customCss, custom_js: customJs, record_type: recordType, record_id: recordId, publish: Boolean(publish) })
      }).then(function (response) {
        return response.json().then(function (payload) {
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Publishing failed');
          return payload;
        });
      });
    }

    function saveToInkwell() {
      var btn = document.getElementById('btn-save');
      btn.disabled = true;
      btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Publishing...';

      persistBuilderDocument(true).then(function (payload) {
        publicPageUrl = payload.public_url || publicPageUrl;
        previewPageUrl = payload.preview_url || previewPageUrl;
        var visitButton = document.getElementById('visitPageButton');
        if (visitButton && publicPageUrl) visitButton.hidden = false;
        btn.disabled = false;
        btn.innerHTML = '<span class="material-symbols-rounded">check</span><span>Published</span>';
        setTimeout(function () { btn.innerHTML = '<span class="material-symbols-rounded">publish</span><span>Publish</span>'; }, 1400);
        try { localStorage.setItem('inkwell_pb_' + recordType + '_' + recordId, Date.now()); } catch (e) {}
      }).catch(function (error) {
        btn.disabled = false;
        btn.innerHTML = '<span class="material-symbols-rounded">error</span><span>Retry publish</span>';
        console.error(error);
      });
    }

    function publishOriginalImport() {
      if (!originalImportAvailable) return;
      if (!window.confirm('Keep the captured original version live? Your native Builder changes will remain a draft until you publish them.')) return;
      fetch('/builder/publish_original_import', {
        method: 'POST',
        headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content, 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ record_type: recordType, record_id: recordId })
      }).then(function (response) { return response.json().then(function (payload) { if (!response.ok || !payload.ok) throw new Error(payload.error || 'Could not publish original import'); return payload; }); })
        .then(function (payload) {
          publicPageUrl = payload.public_url || publicPageUrl;
          var visitButton = document.getElementById('visitPageButton');
          if (visitButton && publicPageUrl) visitButton.hidden = false;
        }).catch(function (error) { console.error(error); });
    }

    function saveDraftToInkwell() {
      persistBuilderDocument(false).then(function (payload) {
        previewPageUrl = payload.preview_url || previewPageUrl;
      }).catch(function (error) { console.error(error); });
    }

    function previewDraftPage() {
      var previewWindow = window.open('about:blank', '_blank');
      persistBuilderDocument(false).then(function (payload) {
        previewPageUrl = payload.preview_url || previewPageUrl;
        if (previewWindow) previewWindow.location.replace(previewPageUrl);
        else window.location.assign(previewPageUrl);
      }).catch(function (error) {
        if (previewWindow) previewWindow.close();
        console.error(error);
      });
    }

    function visitPublishedPage() {
      if (!publicPageUrl) return;
      window.open(publicPageUrl, '_blank', 'noopener');
    }

    function clearPage() {
      builder.clear();
      if (typeof applyCustomCode === 'function') applyCustomCode();
    }

    var pageWorkspaceData = null;
    function escapePageText(value) {
      return String(value == null ? '' : value).replace(/[&<>"']/g, function (character) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]; });
    }
    function initPageWorkspace() {
      var button = document.getElementById('pageSwitcherButton');
      var switcher = document.getElementById('pageSwitcher');
      if (!button || !switcher) return;
      if (recordType !== 'page') { button.addEventListener('click', function () { builder?.openPanelScreen?.('site'); }); return; }
      button.addEventListener('click', function (event) {
        event.stopPropagation();
        switcher.hidden = !switcher.hidden;
        button.classList.toggle('is-active', !switcher.hidden);
        if (!switcher.hidden) loadPageWorkspace();
      });
      switcher.addEventListener('click', function (event) { event.stopPropagation(); });
      document.addEventListener('click', function () { switcher.hidden = true; button.classList.remove('is-active'); });
    }
    function loadPageWorkspace() {
      var switcher = document.getElementById('pageSwitcher');
      if (pageWorkspaceData) { renderPageSwitcher(); return Promise.resolve(pageWorkspaceData); }
      switcher.innerHTML = '<div class="ink-page-switcher-loading">Loading pages…</div>';
      return fetch('/builder/workspace/pages', { headers: { 'Accept': 'application/json' } })
        .then(function (response) { if (!response.ok) throw new Error('Could not load pages'); return response.json(); })
        .then(function (payload) { pageWorkspaceData = payload; renderPageSwitcher(); return payload; })
        .catch(function (error) { switcher.innerHTML = '<div class="ink-page-switcher-loading">' + escapePageText(error.message) + '</div>'; });
    }
    function renderPageSwitcher() {
      var switcher = document.getElementById('pageSwitcher');
      var pages = pageWorkspaceData && pageWorkspaceData.pages || [];
      switcher.innerHTML = '<header><strong>Pages</strong><a href="/admin/pages/new">New page</a></header>' +
        '<button type="button" class="ink-page-overview-action" data-pages-overview><span class="material-symbols-rounded">dashboard</span><span><strong>All-pages canvas</strong><small>See every page together</small></span></button>' +
        '<div class="ink-page-switcher-list">' + pages.map(function (page) {
          var current = String(page.id) === String(recordId);
          return '<a href="' + escapePageText(page.builder_url) + '" class="' + (current ? 'is-current' : '') + '"><span class="material-symbols-rounded">' + (current ? 'radio_button_checked' : 'description') + '</span><span><strong>' + escapePageText(page.title) + '</strong><small>' + escapePageText(page.status) + ' · ' + escapePageText(page.template) + '</small></span></a>';
        }).join('') + '</div>';
      switcher.querySelector('[data-pages-overview]')?.addEventListener('click', showPagesCanvas);
    }
    function showPagesCanvas() {
      loadPageWorkspace().then(function (payload) {
        if (!payload) return;
        var canvas = document.getElementById('PagesCanvas');
        var main = document.getElementById('MainContainer');
        canvas.replaceChildren();
        var header = document.createElement('header');
        header.innerHTML = '<div><span class="ink-pages-eyebrow">Website</span><h1>All pages</h1><p>Review the whole site spatially. Select a page to continue editing it.</p></div><button type="button" data-close-pages><span class="material-symbols-rounded">close</span>Current page</button>';
        canvas.appendChild(header);
        var grid = document.createElement('div'); grid.className = 'ink-pages-grid';
        (payload.pages || []).forEach(function (page) {
          var card = document.createElement('a'); card.className = 'ink-page-card' + (String(page.id) === String(recordId) ? ' is-current' : ''); card.href = page.builder_url;
          var frame = document.createElement('iframe'); frame.title = page.title + ' preview'; frame.tabIndex = -1; frame.setAttribute('sandbox', ''); frame.srcdoc = page.preview_html || '<!doctype html><html><body style="font:16px system-ui;display:grid;min-height:100vh;place-items:center;color:#777">No builder design yet</body></html>';
          var caption = document.createElement('div'); caption.innerHTML = '<span><strong>' + escapePageText(page.title) + '</strong><small>' + escapePageText(page.status) + ' · ' + escapePageText(page.template) + '</small></span><span class="material-symbols-rounded">arrow_forward</span>';
          card.append(frame, caption); grid.appendChild(card);
        });
        canvas.appendChild(grid);
        main.hidden = true; canvas.hidden = false;
        document.body.classList.add('ink-pages-mode');
        header.querySelector('[data-close-pages]').addEventListener('click', function () { canvas.hidden = true; main.hidden = false; document.body.classList.remove('ink-pages-mode'); });
        document.getElementById('pageSwitcher').hidden = true;
      });
    }

    var selectedCaptureId = null;
    var selectedCaptureKind = 'page';
    function openCaptureImporter() {
      var dialog = document.getElementById('captureImporter');
      var menu = document.querySelector('[data-menu]');
      if (menu) menu.hidden = true;
      selectedCaptureId = null;
      dialog.querySelector('[data-import-capture]').disabled = true;
      dialog.querySelector('[data-capture-status]').textContent = 'Select a capture to inspect it.';
      dialog.showModal();
      var list = dialog.querySelector('[data-capture-list]');
      list.innerHTML = '<span class="ink-capture-empty">Loading captures…</span>';
      fetch('/builder/workspace/captures', { headers: { 'Accept': 'application/json' } })
        .then(function (response) { if (!response.ok) throw new Error('Could not load captured sites'); return response.json(); })
        .then(function (payload) {
          var captures = payload.captures || [];
          list.innerHTML = captures.length ? captures.map(function (capture) {
            return '<button type="button" data-capture-id="' + escapePageText(capture.id) + '" data-capture-kind="' + escapePageText(capture.kind || 'page') + '"><span class="material-symbols-rounded">public</span><span><strong>' + escapePageText(capture.source || capture.id) + '</strong><small>' + escapePageText(capture.pages || 1) + ' page' + (Number(capture.pages || 1) === 1 ? '' : 's') + ' · ' + escapePageText(capture.native_sections || 0) + ' native sections · ' + escapePageText(capture.captured_nodes || 0) + ' sampled nodes</small></span><span class="material-symbols-rounded">chevron_right</span></button>';
          }).join('') : '<span class="ink-capture-empty">No mapped captures yet. Run the capture and map commands first.</span>';
          list.querySelectorAll('[data-capture-id]').forEach(function (button) {
            button.addEventListener('click', function () {
              selectedCaptureId = button.getAttribute('data-capture-id');
              selectedCaptureKind = button.getAttribute('data-capture-kind') || 'page';
              list.querySelectorAll('button').forEach(function (item) { item.classList.toggle('is-selected', item === button); });
              dialog.querySelector('[data-import-capture]').disabled = false;
              dialog.querySelector('[data-capture-status]').textContent = selectedCaptureKind === 'site' ? 'Ready to create every captured route as an editable draft page.' : 'Ready to import “' + selectedCaptureId + '”. The change is undoable.';
              dialog.querySelector('[data-import-capture]').textContent = selectedCaptureKind === 'site' ? 'Import complete site' : 'Import as current page';
            });
          });
        })
        .catch(function (error) { list.innerHTML = '<span class="ink-capture-empty">' + escapePageText(error.message) + '</span>'; });
    }
    function importSelectedCapture() {
      if (!selectedCaptureId || !window.builder?.copilotTools) return;
      var confirmation = selectedCaptureKind === 'site' ? 'Create every captured route as a separate editable draft page? Existing pages will not be overwritten.' : 'Replace the current canvas with this captured-page composition? You can undo the import before saving.';
      if (!window.confirm(confirmation)) return;
      var dialog = document.getElementById('captureImporter');
      var button = dialog.querySelector('[data-import-capture]');
      button.disabled = true; button.textContent = 'Importing…';
      if (selectedCaptureKind === 'site') {
        fetch('/builder/workspace/captures/' + encodeURIComponent(selectedCaptureId) + '/import', {
          method: 'POST',
          headers: { 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content, 'Accept': 'application/json' }
        }).then(function (response) { return response.json().then(function (payload) { if (!response.ok) throw new Error(payload.error || 'Site import failed'); return payload; }); })
          .then(function (payload) { window.location.assign(payload.first_builder_url); })
          .catch(function (error) { dialog.querySelector('[data-capture-status]').textContent = error.message; button.disabled = false; button.textContent = 'Import complete site'; });
        return;
      }
      fetch('/builder/workspace/captures/' + encodeURIComponent(selectedCaptureId), { headers: { 'Accept': 'application/json' } })
        .then(function (response) { if (!response.ok) throw new Error('Could not load capture payload'); return response.json(); })
        .then(function (payload) {
          var result = JSON.parse(builder.copilotTools.apply('replace_page', payload));
          if (!result.ok) throw new Error(result.error || 'Import failed');
          if (typeof applyCustomCode === 'function') applyCustomCode();
          enterBuilderMode('design'); switchToDesktopMode(); dialog.close();
        })
        .catch(function (error) { dialog.querySelector('[data-capture-status]').textContent = error.message; })
        .finally(function () { button.disabled = false; button.textContent = 'Import as current page'; });
    }
    document.addEventListener('DOMContentLoaded', function () {
      var dialog = document.getElementById('captureImporter');
      dialog?.querySelector('[data-close-capture]')?.addEventListener('click', function () { dialog.close(); });
      dialog?.querySelector('[data-import-capture]')?.addEventListener('click', importSelectedCapture);
    });

    // Editor chrome theme (dark default / light). Persisted per user; the canvas/page
    // typography is never affected — only the chrome tokens switch palettes.
    function currentTheme() {
      return document.documentElement.getAttribute('data-ink-theme') || 'dark';
    }
    function applyTheme(theme) {
      document.documentElement.setAttribute('data-ink-theme', theme);
      var icon = document.getElementById('themeModeIcon');
      var label = document.getElementById('themeModeLabel');
      if (icon) icon.textContent = theme === 'dark' ? 'dark_mode' : 'light_mode';
      if (label) label.textContent = theme === 'dark' ? 'Light mode' : 'Dark mode';
      try { localStorage.setItem('inkwell_builder_theme', theme); } catch (e) {}
    }
    function toggleTheme() {
      applyTheme(currentTheme() === 'dark' ? 'light' : 'dark');
    }
    (function () {
      try { var saved = localStorage.getItem('inkwell_builder_theme'); if (saved === 'light' || saved === 'dark') applyTheme(saved); } catch (e) {}
    })();

    // Builder modes. The toolbar eye icon is the original Design / Preview toggle; the
    // right-sidebar smenu (Design / Code) is the Design ⇄ Code switch.
    var codeEditorsSynced = false;
    var codeMirrors = {};
    var activeCodeFile = 'html';
    var codeEditorSyncing = false;
    function initCodeMirrors() {
      if (typeof CodeMirror === 'undefined') return;
      var files = { html: 'xml', css: 'css', js: 'javascript' };
      Object.keys(files).forEach(function (file) {
        var ta = document.getElementById('codeFile' + (file === 'html' ? 'Html' : file.charAt(0).toUpperCase() + file.slice(1)));
        if (!ta || ta.getAttribute('data-cm-inited')) return;
        ta.setAttribute('data-cm-inited', '1');
        codeMirrors[file] = CodeMirror.fromTextArea(ta, {
          mode: files[file],
          theme: 'material-darker',
          lineNumbers: true,
          lineWrapping: true,
          autoCloseBrackets: true,
          matchBrackets: true,
          styleActiveLine: true,
          spellcheck: false,
          viewportMargin: 30,
          extraKeys: {
            'Cmd-S': function () { applyCodeSource(true); },
            'Ctrl-S': function () { applyCodeSource(true); },
            'Shift-Alt-F': function () { formatActiveCodeFile(); }
          }
        });
        if (file === 'html') codeMirrors[file].setOption('readOnly', 'nocursor');
        codeMirrors[file].on('change', function () { if (!codeEditorSyncing) markCodeFileDirty(file, true); updateCodeStatus(file); });
        codeMirrors[file].on('cursorActivity', function () { updateCodeStatus(file); });
      });
    }
    function openCodeFile(file) {
      activeCodeFile = file;
      document.querySelectorAll('[data-code-file]').forEach(function (item) {
        var active = item.getAttribute('data-code-file') === file;
        item.classList.toggle('is-active', active);
        if (item.getAttribute('role') === 'tab') item.setAttribute('aria-selected', active ? 'true' : 'false');
      });
      document.querySelectorAll('.code-editor-textarea').forEach(function (ta) {
        var f = ta.getAttribute('data-code-editor-for'); var visible = f === file; var cm = codeMirrors[f];
        if (cm) cm.display.wrapper.style.display = visible ? '' : 'none'; else ta.style.display = visible ? '' : 'none';
        if (visible && cm) { cm.refresh(); if (file !== 'html') cm.focus(); }
      });
      var guidance = document.querySelector('[data-code-guidance]');
      if (guidance) guidance.innerHTML = file === 'html' ? '<strong>Generated, read-only HTML.</strong> Edit structure on canvas; selectors and scripts belong in their own files.' : file === 'css' ? '<strong>Page-scoped CSS.</strong> Prefer .ink-canvas-root and element classes so styles remain portable.' : '<strong>Page JavaScript.</strong> Keep initialization idempotent and respect reduced motion.';
      updateCodeStatus(file);
    }
    function markCodeFileDirty(file, dirty) { var marker = document.querySelector('[data-dirty-for="' + file + '"]'); if (marker) marker.classList.toggle('is-dirty', dirty); }
    function updateCodeStatus(file) {
      var cm = codeMirrors[file]; if (!cm) return;
      var cursor = cm.getCursor(); var position = document.querySelector('[data-code-position]'); var language = document.querySelector('[data-code-language]');
      if (position) position.textContent = 'Ln ' + (cursor.line + 1) + ', Col ' + (cursor.ch + 1);
      if (language) language.textContent = ({ html: 'HTML', css: 'CSS', js: 'JavaScript' })[file] + ' · ' + cm.lineCount() + ' lines';
    }
    async function formatCodeFile(file) {
      if (!window.InkCodeFormatter) return;
      var formatted = await window.InkCodeFormatter.format(file, codeFileValue(file));
      codeEditorSyncing = true; setCodeFileValue(file, formatted); codeEditorSyncing = false; updateCodeStatus(file);
    }
    function formatActiveCodeFile() { return formatCodeFile(activeCodeFile).then(function () { markCodeFileDirty(activeCodeFile, activeCodeFile !== 'html'); }); }
    function codeFileValue(file) {
      var cm = codeMirrors[file];
      if (cm) return cm.getValue();
      var ta = document.getElementById('codeFile' + (file === 'html' ? 'Html' : file.charAt(0).toUpperCase() + file.slice(1)));
      return ta ? ta.value : '';
    }
    function setCodeFileValue(file, value) {
      var cm = codeMirrors[file];
      if (cm) cm.setValue(value);
      else {
        var ta = document.getElementById('codeFile' + (file === 'html' ? 'Html' : file.charAt(0).toUpperCase() + file.slice(1)));
        if (ta) ta.value = value;
      }
    }

    function toggleDesignMode() {
      enterBuilderMode(builder.getMode() == 'design' ? 'preview' : 'design');
    }
    function enterBuilderMode(mode) {
      if (mode === 'code') {
        builder.setMode('preview');
        syncCodeEditors();
        activateSmenu('code');
        Object.keys(codeMirrors).forEach(function (f) { codeMirrors[f].refresh(); });
      } else if (mode === 'design') {
        applyCodeSource(false);
        activateSmenu('design');
        builder.setMode('design');
      } else {
        applyCodeSource(false);
        activateSmenu('design');
        builder.setMode('preview');
      }
      var btn = document.getElementById('toggleButton');
      if (btn) {
        var icon = builder.getMode() == 'design' ? 'visibility_off' : 'visibility';
        btn.innerHTML = '<span class="d-flex align-items-center"><span class="material-symbols-rounded">' + icon + '</span></span>';
      }
    }
    function activateSmenu(name) {
      if (window.smenu) {
        var tab = document.querySelector('[data-smenu="' + name + '"]');
        if (tab) window.smenu.openTab(tab);
      }
    }
    function canvasDoc() {
      if (!window.builder) return null;
      return builder.iframeDoc || (builder.iframe && builder.iframe.contentDocument) || null;
    }
    function syncCodeEditors() {
      var doc = canvasDoc();
      var html = '';
      if (builder.getSourceHtml) {
        html = builder.getSourceHtml();
      } else if (builder.getHtml) {
        var full = builder.getHtml();
        var m = full.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
        html = m ? m[1] : full;
      } else {
        html = doc && doc.body ? doc.body.innerHTML : '';
      }
      codeEditorSyncing = true;
      setCodeFileValue('html', html);
      setCodeFileValue('css', document.getElementById('customCss').value);
      setCodeFileValue('js', document.getElementById('customJs').value);
      if (codeMirrors.html) codeMirrors.html.setOption('readOnly', 'nocursor');
      codeEditorSyncing = false;
      codeEditorsSynced = true;
      Promise.all(['html', 'css', 'js'].map(formatCodeFile)).then(function () {
        ['html', 'css', 'js'].forEach(function (file) { markCodeFileDirty(file, false); });
        openCodeFile(activeCodeFile);
      });
    }
    function applyCodeSource(save) {
      if (!codeEditorsSynced) return;
      var html = codeFileValue('html');
      var css = codeFileValue('css');
      var js = codeFileValue('js');

      // Prohibit inline <style>/<script>: hoist every style block into the CSS file and
      // every script block into the JS file, so the builder keeps one clean source. The
      // builder-owned widget-behavior runtime (data-ink-widget-runtime) stays in the HTML —
      // it ships with the page structure and is not user code.
      var styleParts = [];
      html = html.replace(/<style[^>]*>([\s\S]*?)<\/style>/gi, function (_, body) { styleParts.push(body); return ''; });
      var scriptParts = [];
      html = html.replace(/<script([^>]*)>([\s\S]*?)<\/script>/gi, function (_, attrs, body) {
        if (/(^|\s)data-ink-widget-runtime(\s|$)/.test(attrs)) return '<script' + attrs + '>' + body + '</scr' + 'ipt>';
        scriptParts.push(body); return '';
      });
      if (styleParts.length) css = (css.trim() ? css.trim() + '\n\n' : '') + styleParts.join('\n');
      if (scriptParts.length) js = (js.trim() ? js.trim() + ';\n\n' : '') + scriptParts.join(';\n');
      setCodeFileValue('css', css);
      setCodeFileValue('js', js);
      document.getElementById('customCss').value = css;
      document.getElementById('customJs').value = js;
      markCodeFileDirty('css', false);
      markCodeFileDirty('js', false);

      // V2 HTML is generated from the recursive document tree. The Code workspace remains the
      // source for page CSS/JS, but arbitrary HTML is no longer pushed into a detached email-era
      // PageElement model. Structural edits belong to registered canvas elements.
      if (window.builder instanceof InkBuilderV2) {
        builder.customCode.update(css, js);
        if (save) saveToInkwell();
        return;
      }

      var doc = canvasDoc();
      var m = html.match(/<body[^>]*>([\s\S]*?)<\/body>/i);
      var applied = m ? m[1] : html;
      if (doc && doc.body) doc.body.innerHTML = applied;
      // Replacing the body detaches the builder's PageElement model node, so the builder would
      // keep rendering into a dead node (frozen canvas). Re-attach the model to the new body and
      // re-render: for builder-marked HTML the store render matches the applied source; for raw
      // (HTML-first) source, paint it as the design view so it shows AND stays editable.
      if (window.builder && window.builder.pageElement) {
        var pe = window.builder.pageElement;
        var host = doc.querySelector('[builder-element="PageElement"]');
        if (!host) {
          host = doc.createElement('div');
          host.setAttribute('builder-element', 'PageElement');
          doc.body.insertBefore(host, doc.body.firstChild);
        }
        pe.domNode = host;
        pe.render();
        if (applied.indexOf('builder-element') === -1 && applied.trim()) {
          var view = doc.getElementById('__copilot_design_view');
          if (!view) { view = doc.createElement('div'); view.id = '__copilot_design_view'; }
          view.innerHTML = applied;
          host.appendChild(view);
        }
      }
      if (typeof applyCustomCode === 'function') applyCustomCode();
      if (save) saveToInkwell();
    }

    function switchToMobileMode() {
      if (window.builder && builder.setDevice) builder.setDevice('mobile');
      document.querySelector('.content-container').classList.add('mobile-mode');
      document.querySelector('.content-container').classList.remove('desktop-mode', 'tablet-mode');
      document.getElementById('mobileModeButton').classList.add('active');
      document.getElementById('desktopModeButton').classList.remove('active');
      document.getElementById('tabletModeButton').classList.remove('active');
    }

    function switchToTabletMode() {
      if (window.builder && builder.setDevice) builder.setDevice('tablet');
      document.querySelector('.content-container').classList.remove('mobile-mode', 'desktop-mode');
      document.querySelector('.content-container').classList.add('tablet-mode');
      document.getElementById('tabletModeButton').classList.add('active');
      document.getElementById('desktopModeButton').classList.remove('active');
      document.getElementById('mobileModeButton').classList.remove('active');
    }

    function switchToDesktopMode() {
      if (window.builder && builder.setDevice) builder.setDevice('desktop');
      document.querySelector('.content-container').classList.add('desktop-mode');
      document.querySelector('.content-container').classList.remove('mobile-mode', 'tablet-mode');
      document.getElementById('desktopModeButton').classList.add('active');
      document.getElementById('mobileModeButton').classList.remove('active');
      document.getElementById('tabletModeButton').classList.remove('active');
    }
  </script>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.9.2/umd/popper.min.js" integrity="sha512-2rNj2KJ+D8s1ceNasTIex6z4HWyOnEYLVC3FigGOmyQCZc2eBXKgOxQmo3oKLHyfcj53uz4QMsRCWNbLd32Q1g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.5/dist/js/bootstrap.bundle.min.js" integrity="sha384-k6d4wzSIapyDyv1kpU366/PK5hCdSbCRGRCMv+eplOQJWyd1fbcAu9OCUj5zNLiq" crossorigin="anonymous"></script>

  <%# Realtime custom code: the builder owns custom CSS/JS as a first-class capability. The Code
      tab edits flow into builder.customCode and are re-injected into the canvas iframe live. %>
  <script>
    function applyCustomCode() {
      if (!window.builder || !window.builder.customCode) return;
      var css = document.getElementById('customCss') ? document.getElementById('customCss').value : '';
      var js = document.getElementById('customJs') ? document.getElementById('customJs').value : '';
      window.builder.customCode.update(css, js);
    }
    window.applyCustomCode = applyCustomCode;

    document.addEventListener('DOMContentLoaded', function () {
      var cssInput = document.getElementById('customCss'), jsInput = document.getElementById('customJs');
      var debounce = null;
      function onChange() { clearTimeout(debounce); debounce = setTimeout(applyCustomCode, 200); }
      if (cssInput) cssInput.addEventListener('input', onChange);
      if (jsInput) jsInput.addEventListener('input', onChange);

      // Apply once the builder has initialized its canvas iframe.
      var t = setInterval(function () {
        if (window.builder && (window.builder.iframeDoc || (window.builder.iframe && window.builder.iframe.contentDocument))) {
          clearInterval(t);
          applyCustomCode();
        }
      }, 500);
    });

  </script>
  <script>
    var tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]')
    var tooltipList = [...tooltipTriggerList].map(tooltipTriggerEl => new bootstrap.Tooltip(tooltipTriggerEl))
  </script>
  <script>
    // Media gallery picker: the library iframe posts selections up to us; forward to the
    // pending InkwellMediaPicker callback so Builder.js image controls can insert from the gallery.
    window.addEventListener('message', function (e) {
      if (e.data && e.data.type === 'inkwell:media-select' && window.InkwellMediaPicker && window.InkwellMediaPicker.onSelect) {
        window.InkwellMediaPicker.onSelect(e.data.detail.url);
      }
    });
  </script>

  <%# Copilot (AI Writer plugin) — rendered inside the #CopilotDock right-side panel above %>
</body>
