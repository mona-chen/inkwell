<%# Copilot for the Ink Builder (visual page builder). Unlike the block editor, here the
    whole HTML canvas is Copilot's playground: it designs elegant, builder-native stores (real
    elements the Ink Builder can load and edit), using the {{ site.name }} / {{ loop posts:3 }}
    dynamic tokens. Rendered by the page_builder layout while this plugin is active.
    This is a specialized editor integration with its own scoped bc-* hooks; it inherits the
    builder's editor tokens and does not style the published canvas. %>
<div data-controller="builder-copilot"
     data-builder-copilot-context-value="<%= @record&.title %>"
     data-builder-copilot-site-value="<%= Current.site.name %>"
     data-builder-copilot-record-id-value="<%= @record&.id %>"
     data-builder-copilot-record-type-value="<%= @record.is_a?(Page) ? "page" : "post" %>">
  <button type="button" data-builder-copilot-target="fab" data-action="builder-copilot#open" aria-label="Open Copilot" class="bc-fab">
    <span class="bc-fab-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor" width="15" height="15"><path d="M12 2l1.9 5.7L19.6 9.6l-5.7 1.9L12 17.2l-1.9-5.7L4.4 9.6l5.7-1.9z"/><circle cx="19" cy="5" r="1.6"/><circle cx="5.5" cy="17.5" r="1.2"/></svg>
    </span>
    <span>Copilot</span>
  </button>

  <div data-builder-copilot-target="window" class="bc-window hidden">
    <div class="bc-accent-bar"></div>
    <div class="bc-header">
      <div class="bc-header-left">
        <span class="bc-logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M12 2l1.9 5.7L19.6 9.6l-5.7 1.9L12 17.2l-1.9-5.7L4.4 9.6l5.7-1.9z"/></svg>
        </span>
        <span class="bc-title">Copilot</span>
        <span class="bc-badge">Design agent</span>
        <span data-builder-copilot-target="statusDot" class="bc-dot hidden"></span>
      </div>
      <button type="button" data-action="builder-copilot#close" class="bc-icon-btn" aria-label="Close Copilot">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="14" height="14"><path d="M18 6 6 18M6 6l12 12"/></svg>
      </button>
    </div>

    <div data-builder-copilot-target="chatView" class="bc-chat">
      <div data-builder-copilot-target="transcript" class="bc-transcript" role="log" aria-live="polite" aria-label="Copilot conversation">
        <div class="bc-empty" data-copilot-empty>
          <span class="bc-empty-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3 14 9l6 2-6 2-2 6-2-6-6-2 6-2 2-6Z"/><path d="m18.5 3 .6 1.9L21 5.5l-1.9.6-.6 1.9-.6-1.9-1.9-.6 1.9-.6.6-1.9Z"/></svg>
          </span>
          <div class="bc-empty-copy">
            <strong>What are we building?</strong>
            <span>Describe the product, audience, desired action, and visual mood. Copilot will compose editable sections, responsive styles, and purposeful motion.</span>
          </div>
          <div class="bc-suggestions" aria-label="Example prompts">
            <button type="button" data-action="builder-copilot#useSuggestion" data-prompt="Design a premium landing page for a collaborative writing workspace for editorial teams. Make it warm, tactile, confident, and conversion-focused.">Editorial SaaS launch</button>
            <button type="button" data-action="builder-copilot#useSuggestion" data-prompt="Create a cinematic portfolio for an independent product designer. Use bold editorial typography, case-study proof, restrained motion, and a clear project inquiry CTA.">Designer portfolio</button>
            <button type="button" data-action="builder-copilot#useSuggestion" data-prompt="Build a distinctive waitlist page for a privacy-first personal finance app. Convey trust without generic fintech blue, explain the value clearly, and end with a strong signup CTA.">Product waitlist</button>
          </div>
        </div>
      </div>

      <div data-builder-copilot-target="designView" class="bc-design hidden">
        <div class="bc-design-head">
          <span class="bc-design-label">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="13" height="13" aria-hidden="true"><path d="M12 3v3m0 12v3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1M3 12h3m12 0h3M5.6 18.4l2.1-2.1m8.6-8.6 2.1-2.1"/></svg>
            Design history
          </span>
          <div class="bc-design-actions">
            <button type="button" data-builder-copilot-target="undoCheckpoint" data-action="builder-copilot#undoCheckpoint" class="bc-btn bc-btn-ghost">Undo</button>
            <button type="button" data-builder-copilot-target="apply" data-action="builder-copilot#apply" class="bc-btn bc-btn-accent">Apply design</button>
          </div>
        </div>
        <div data-builder-copilot-target="checkpoints" class="bc-checkpoints"></div>
        <div class="bc-design-hint">Every change is a checkpoint — Undo or click a chip to step back.</div>
      </div>

      <div class="bc-input-area">
        <div class="bc-brand-row">
          <label class="bc-brand-label" for="bc-brand">Design language</label>
          <span class="bc-brand-wrap">
            <select data-builder-copilot-target="brand" id="bc-brand" class="bc-brand" aria-label="Design aesthetic">
              <option value="">Auto — pick a fitting aesthetic</option>
              <option value="linear.app">Linear — minimal, precise, lavender</option>
              <option value="stripe">Stripe — purple gradients, elegant</option>
              <option value="vercel">Vercel — black &amp; white precision</option>
              <option value="cursor">Cursor — sleek dark, gradient accents</option>
              <option value="framer">Framer — bold black &amp; blue, motion-first</option>
              <option value="supabase">Supabase — dark emerald, code-first</option>
              <option value="notion">Notion — warm minimalism, serif headings</option>
              <option value="raycast">Raycast — dark chrome, vibrant accents</option>
              <option value="posthog">PostHog — playful, developer dark UI</option>
              <option value="resend">Resend — minimal dark, monospace accents</option>
              <option value="airbnb">Airbnb — warm coral, rounded, photography</option>
              <option value="spotify">Spotify — vibrant green on dark</option>
              <option value="figma">Figma — vibrant multi-color, playful</option>
              <option value="shopify">Shopify — dark-first cinematic, neon green</option>
              <option value="coinbase">Coinbase — clean blue, institutional trust</option>
              <option value="binance">Binance — bold yellow on monochrome</option>
              <option value="apple">Apple — premium white space, cinematic</option>
              <option value="nike">Nike — monochrome, massive display type</option>
              <option value="tesla">Tesla — radical subtraction, cinematic</option>
            </select>
          </span>
        </div>
        <div class="bc-modes" role="group" aria-label="Design mode">
          <button type="button" data-builder-copilot-target="mode" data-mode="design" data-action="builder-copilot#setMode" class="bc-mode">Design</button>
          <button type="button" data-builder-copilot-target="mode" data-mode="add_section" data-action="builder-copilot#setMode" class="bc-mode">Add section</button>
          <button type="button" data-builder-copilot-target="mode" data-mode="rewrite" data-action="builder-copilot#setMode" class="bc-mode">Rewrite</button>
        </div>
        <textarea data-builder-copilot-target="prompt" rows="2" data-action="keydown->builder-copilot#promptKeydown"
                  placeholder="Describe the page you want — tell me your site's story and I'll design it…" class="bc-prompt"></textarea>
        <div class="bc-input-row">
          <span data-builder-copilot-target="status" class="bc-status"></span>
          <button type="button" data-builder-copilot-target="send" data-action="builder-copilot#send" class="bc-btn bc-btn-send" aria-label="Generate">
            <span>Generate</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <style>
    .hidden { display: none !important; }

    /* ---- design tokens ---- */
    .bc-window {
      --bc-bg: #ffffff;
      --bc-surface: #f8fafc;
      --bc-surface-2: #f1f5f9;
      --bc-border: #e6eaf0;
      --bc-border-strong: #cbd5e1;
      --bc-text: #0f172a;
      --bc-muted: #64748b;
      --bc-faint: #94a3b8;
      --bc-accent: #6366f1;
      --bc-accent-2: #8b5cf6;
      --bc-accent-soft: #eef2ff;
      --bc-accent-ink: #4338ca;
      --bc-ok: #10b981;
      --bc-danger: #ef4444;
      --bc-radius: 12px;
      --bc-shadow: 0 24px 60px rgba(15, 23, 42, .22), 0 4px 14px rgba(15, 23, 42, .08);
    }

    .bc-fab {
      position: fixed;
      bottom: 18px;
      right: 18px;
      z-index: 9000;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      height: 40px;
      padding: 0 16px;
      border: 0;
      border-radius: 9999px;
      background: linear-gradient(135deg, var(--bc-accent), var(--bc-accent-2));
      color: #fff;
      font: 600 13.5px/1 -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", sans-serif;
      letter-spacing: .01em;
      cursor: pointer;
      box-shadow: 0 8px 24px rgba(99, 102, 241, .4);
      transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;
    }
    .bc-fab:hover { filter: brightness(1.06); box-shadow: 0 10px 30px rgba(99, 102, 241, .5); }
    .bc-fab:active { transform: scale(.97); }
    .bc-fab-icon { display: inline-flex; }

    .bc-window {
      position: fixed;
      bottom: 70px;
      right: 18px;
      z-index: 9001;
      width: 424px;
      max-width: calc(100vw - 36px);
      height: 640px;
      max-height: calc(100vh - 140px);
      display: flex;
      flex-direction: column;
      overflow: hidden;
      border: 1px solid var(--bc-border);
      border-radius: 18px;
      background: var(--bc-bg);
      box-shadow: var(--bc-shadow);
      font: 14px/1.5 -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", sans-serif;
      color: var(--bc-text);
    }
    /* Right-side dock: the Copilot fills the #CopilotDock panel in the builder workspace. */
    .bc-window.bc-docked {
      --bc-bg: var(--ink-editor-panel, #202124);
      --bc-surface: var(--ink-editor-surface, #27292c);
      --bc-surface-2: var(--ink-editor-dropdown, #303236);
      --bc-border: var(--ink-editor-border, #3b3d42);
      --bc-border-strong: var(--ink-editor-faint, #5f6368);
      --bc-text: var(--ink-editor-text, #f1f3f4);
      --bc-muted: var(--ink-editor-muted, #b4b8be);
      --bc-faint: var(--ink-editor-faint, #8a9099);
      --bc-accent: var(--ink-editor-accent-bright, #e5498d);
      --bc-accent-2: var(--ink-editor-accent, #b0004b);
      --bc-accent-soft: rgba(229, 73, 141, .13);
      --bc-accent-ink: var(--ink-editor-accent-bright, #ff76b1);
      position: static;
      width: 100%;
      height: 100%;
      max-width: none;
      max-height: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
    }
    .bc-window.bc-docked .bc-accent-bar { display: none; }
    .bc-window.bc-docked .bc-header { background: var(--bc-bg); border-bottom-color: var(--bc-border); }

    .bc-accent-bar { height: 3px; flex: none; background: linear-gradient(90deg, var(--bc-accent), var(--bc-accent-2)); }

    .bc-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex: none;
      padding: 11px 14px 11px 16px;
      border-bottom: 1px solid var(--bc-border);
      background: var(--bc-bg);
    }
    .bc-header-left { display: flex; align-items: center; gap: 9px; min-width: 0; }
    .bc-logo {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      border-radius: 7px;
      color: #fff;
      background: linear-gradient(135deg, var(--bc-accent), var(--bc-accent-2));
      flex: none;
    }
    .bc-title { font-size: 14px; font-weight: 700; color: var(--bc-text); letter-spacing: -.01em; }
    .bc-badge {
      border-radius: 9999px;
      background: var(--bc-accent-soft);
      color: var(--bc-accent-ink);
      padding: 2px 8px;
      font-size: 10px;
      font-weight: 600;
      letter-spacing: .02em;
    }
    .bc-dot {
      width: 7px;
      height: 7px;
      border-radius: 9999px;
      background: var(--bc-ok);
      box-shadow: 0 0 0 3px rgba(16, 185, 129, .18);
      animation: bc-pulse 1.2s ease-in-out infinite;
    }
    .bc-icon-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: var(--bc-faint);
      cursor: pointer;
      transition: background .12s ease, color .12s ease;
    }
    .bc-icon-btn:hover { background: var(--bc-surface-2); color: var(--bc-text); }

    .bc-chat { display: flex; flex-direction: column; min-height: 0; flex: 1; }
    .bc-transcript {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      background: var(--bc-bg);
      scrollbar-width: thin;
      scrollbar-color: var(--bc-border-strong) transparent;
    }

    .bc-empty {
      min-height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 14px;
      padding: 22px 2px;
      color: var(--bc-text);
    }
    .bc-empty-mark {
      display: grid;
      place-items: center;
      width: 42px;
      height: 42px;
      border: 1px solid var(--bc-border);
      border-radius: 13px;
      color: var(--bc-accent);
      background: var(--bc-surface);
      box-shadow: 0 8px 24px rgba(0, 0, 0, .14);
    }
    .bc-empty-mark svg { width: 23px; height: 23px; }
    .bc-empty-copy { display: flex; flex-direction: column; gap: 6px; }
    .bc-empty-copy strong { font-size: 17px; line-height: 1.2; letter-spacing: -.025em; }
    .bc-empty-copy span { max-width: 34ch; color: var(--bc-muted); font-size: 12.5px; line-height: 1.55; }
    .bc-suggestions { display: flex; flex-direction: column; gap: 7px; }
    .bc-suggestions button {
      display: flex;
      align-items: center;
      min-height: 38px;
      padding: 8px 11px;
      border: 1px solid var(--bc-border);
      border-radius: 9px;
      background: var(--bc-surface);
      color: var(--bc-text);
      font: 600 12px/1.25 inherit;
      text-align: left;
      cursor: pointer;
      transition: border-color .14s ease, background .14s ease, transform .14s ease;
    }
    .bc-suggestions button::after { content: "→"; margin-left: auto; color: var(--bc-faint); font-size: 15px; }
    .bc-suggestions button:hover { border-color: var(--bc-accent); background: var(--bc-accent-soft); transform: translateX(2px); }
    .bc-suggestions button:focus-visible { outline: 2px solid var(--bc-accent); outline-offset: 2px; }

    /* user / assistant bubbles */
    .bc-user { display: flex; justify-content: flex-end; }
    .bc-user > div {
      max-width: 84%;
      border-radius: 14px 14px 4px 14px;
      background: linear-gradient(135deg, var(--bc-accent), var(--bc-accent-2));
      color: #fff;
      padding: 9px 13px;
      white-space: pre-wrap;
      word-break: break-word;
      font-size: 13.5px;
      line-height: 1.5;
    }
    .bc-bubble {
      position: relative;
      max-width: 92%;
      align-self: flex-start;
      white-space: pre-wrap;
      word-break: break-word;
      border: 1px solid var(--bc-border);
      border-radius: 4px 14px 14px 14px;
      background: var(--bc-surface);
      color: var(--bc-text);
      padding: 9px 13px;
      font-size: 13.5px;
      line-height: 1.55;
    }
    .bc-bubble::before {
      content: "";
      position: absolute;
      top: 0;
      left: -1px;
      width: 3px;
      bottom: 0;
      border-radius: 0 0 0 3px;
      background: linear-gradient(180deg, var(--bc-accent), var(--bc-accent-2));
      opacity: .8;
    }
    .bc-error {
      border: 1px solid #fecdd3;
      background: #fff1f2;
      color: #be123c;
      padding: 9px 12px;
      border-radius: 10px;
      font-size: 12.5px;
    }
    .bc-log {
      display: flex;
      align-items: center;
      gap: 7px;
      align-self: flex-start;
      font-size: 12px;
      color: var(--bc-muted);
    }
    .bc-log-arrow { color: var(--bc-faint); }

    /* thinking / working card */
    .bc-thinking {
      display: flex;
      gap: 10px;
      align-self: flex-start;
      width: 100%;
      border: 1px dashed var(--bc-border-strong);
      border-radius: 12px;
      background: var(--bc-surface);
      padding: 9px 12px;
    }
    .bc-thinking-dot {
      flex: none;
      width: 8px;
      height: 8px;
      margin-top: 5px;
      border-radius: 9999px;
      background: linear-gradient(135deg, var(--bc-accent), var(--bc-accent-2));
      animation: bc-pulse 1s ease-in-out infinite;
    }
    .bc-thinking-body { min-width: 0; flex: 1; }
    .bc-thinking-label {
      font-size: 10.5px;
      font-weight: 700;
      color: var(--bc-faint);
      text-transform: uppercase;
      letter-spacing: .09em;
    }
    .bc-thinking-text {
      margin-top: 4px;
      max-height: 96px;
      overflow-y: auto;
      white-space: pre-wrap;
      word-break: break-word;
      font-family: ui-monospace, Menlo, monospace;
      font-size: 11.5px;
      color: var(--bc-muted);
    }
    @keyframes bc-pulse { 50% { opacity: .35; } }

    /* plan / section preview */
    .bc-plan {
      align-self: stretch;
      border: 1px solid var(--bc-border);
      border-radius: 12px;
      background: var(--bc-surface);
      padding: 10px 12px;
    }
    .bc-plan-title { font-size: 12px; font-weight: 700; color: var(--bc-text); margin-bottom: 8px; }
    .bc-plan-body { display: flex; flex-direction: column; gap: 6px; }
    .bc-plan-sec {
      font-size: 12.5px;
      color: var(--bc-text);
      cursor: pointer;
      border: 1px solid transparent;
      border-radius: 8px;
      padding: 4px 6px;
      margin: 0 -6px;
      transition: all .15s ease;
    }
    .bc-plan-sec:hover { background: var(--bc-surface); }
    .bc-section-active { background: var(--bc-accent-soft); border-color: #c7d2fe; }
    .bc-section-updated { border-color: #a7f3d0; background: #ecfdf5; }
    .bc-plan-sec-label { font-weight: 600; }
    .bc-plan-els { margin-top: 3px; display: flex; flex-wrap: wrap; gap: 4px; }
    .bc-plan-el {
      border: 1px solid var(--bc-border);
      background: var(--bc-surface);
      border-radius: 9999px;
      padding: 1px 8px;
      font-size: 10px;
      color: var(--bc-muted);
    }
    .bc-plan-actions { margin-top: 8px; display: flex; align-items: center; gap: 10px; }
    .bc-plan-hint { font-size: 11px; color: var(--bc-faint); }

    /* design history tray */
    .bc-design {
      flex: none;
      border-top: 1px solid var(--bc-border);
      padding: 10px 16px 12px;
      background: var(--bc-surface);
    }
    .bc-design-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
    .bc-design-label {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 11px;
      font-weight: 700;
      color: var(--bc-muted);
      text-transform: uppercase;
      letter-spacing: .07em;
    }
    .bc-design-label svg { color: var(--bc-accent); }
    .bc-design-actions { display: flex; gap: 6px; }
    .bc-design-hint { font-size: 11px; color: var(--bc-faint); margin-top: 8px; }
    .bc-btn-ghost { background: var(--bc-bg); color: var(--bc-text); border: 1px solid var(--bc-border-strong); }
    .bc-btn-ghost:hover { background: var(--bc-surface-2); }

    .bc-checkpoints { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 4px; }
    .bc-checkpoint {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      max-width: 100%;
      border: 1px solid var(--bc-border);
      background: var(--bc-bg);
      color: var(--bc-muted);
      border-radius: 9999px;
      padding: 3px 10px 3px 4px;
      font-size: 11.5px;
      cursor: pointer;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      transition: all .12s ease;
    }
    .bc-checkpoint:hover { background: var(--bc-accent-soft); border-color: #c7d2fe; color: var(--bc-accent-ink); }
    .bc-checkpoint-active { background: var(--bc-accent); color: #fff; border-color: var(--bc-accent); }
    .bc-checkpoint-active:hover { background: var(--bc-accent-ink); color: #fff; }
    .bc-checkpoint-tag {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 18px;
      height: 18px;
      border-radius: 9999px;
      background: var(--bc-surface-2);
      color: var(--bc-muted);
      font-size: 10px;
      font-weight: 700;
    }
    .bc-checkpoint-active .bc-checkpoint-tag { background: rgba(255, 255, 255, .2); color: #fff; }

    /* composer */
    .bc-input-area {
      flex: none;
      border-top: 1px solid var(--bc-border);
      padding: 10px 14px 12px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: var(--bc-bg);
    }
    .bc-brand-row { display: flex; align-items: center; gap: 8px; }
    .bc-brand-label { font-size: 10.5px; font-weight: 700; color: var(--bc-faint); text-transform: uppercase; letter-spacing: .07em; white-space: nowrap; }
    .bc-brand-wrap { position: relative; flex: 1; min-width: 0; display: block; }
    .bc-brand {
      width: 100%;
      appearance: none;
      border: 1px solid var(--bc-border);
      border-radius: 8px;
      background: var(--bc-surface);
      color: var(--bc-text);
      font-size: 12.5px;
      font-family: inherit;
      padding: 6px 26px 6px 9px;
      cursor: pointer;
    }
