      cursor: pointer;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .bc-checkpoint:hover { background: #eef2ff; border-color: #c7d2fe; }
    .bc-checkpoint-active { background: #111827; color: #fff; border-color: #111827; }
    .bc-checkpoint-tag { font-weight: 600; }

    .bc-input-area { border-top: 1px solid #f3f4f6; padding: 12px 16px; display: flex; flex-direction: column; gap: 8px; }
    .bc-brand-row { display: flex; align-items: center; gap: 8px; }
    .bc-brand-label { font-size: 11px; font-weight: 600; color: #6b7280; text-transform: uppercase; letter-spacing: .05em; white-space: nowrap; }
    .bc-brand {
      flex: 1; min-width: 0; border: 1px solid #e5e7eb; border-radius: 8px;
      background: #fff; color: #374151; font-size: 12px; font-family: inherit; padding: 6px 8px;
    }
