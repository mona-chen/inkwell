            if (e.name === "AbortError") this.addAssistantMessage(this.stopReason === "timeout" ? "The provider took too long, so I stopped this run safely. Try a more focused request or run it again." : "Generation stopped. No incomplete tool payload was applied.")
            else this.addError(e.message)
          } finally {
            clearTimeout(this.requestTimer)
            this.requestTimer = null
            this.abortController = null
            this.setStatus("", false)
            this.busy = false
            this.setSendRunning(false)
          }
          return
        }
        try {
          const resp = await fetch("/plugins/ai_writer/chat", {
            method: "POST",
            headers: { "X-CSRF-Token": csrf, "Content-Type": "application/json", "Accept": "text/event-stream" },
            signal: this.abortController.signal,
            body: JSON.stringify({
              mode: this.mode, prompt, html: this.currentHtml(), store: this.currentStore(),
              context: this.contextValue, site: this.siteValue, recordType: this.recordTypeValue,
              brand: this.hasBrandTarget ? this.brandTarget.value : "",
              customCss: baseCss, customJs: baseJs,
              env: "html", history: this.history,
              editSection: editIndex == null ? null : editIndex,
              currentSections: this.pendingSpec ? this.pendingSpec.elementLists : null
            })
          })
          if (!resp.ok) { const j = await resp.json().catch(() => ({})); throw new Error(j.error || "Copilot failed (" + resp.status + ")") }
          const { content, design } = await this.streamResponse(resp)
          this.handleResponse(content, design)
          this.setStatus("", false)
        } catch (e) {
          this.endThinking()
          if (e.name === "AbortError") this.addAssistantMessage(this.stopReason === "timeout" ? "The provider took too long, so I stopped this run safely. Try a more focused request or run it again." : "Generation stopped.")
          else this.addError(e.message)
          this.setStatus("", false)
        } finally {
          clearTimeout(this.requestTimer)
          this.requestTimer = null
          this.abortController = null
          this.busy = false
          this.setSendRunning(false)
        }
      }

      setSendRunning(running) {
        const label = this.sendTarget.querySelector("span")
        if (label) label.textContent = running ? "Stop" : "Generate"
        this.sendTarget.setAttribute("aria-label", running ? "Stop generation" : "Generate")
        this.sendTarget.classList.toggle("is-stopping", running)
        this.sendTarget.disabled = false
      }

      // Read the SSE stream. reasoning_content (the model's thinking) is shown in the
      // thinking area but kept separate from `content` (the actual reply). Each "design" event
      // (streamed after an edit tool executes) is applied to the canvas LIVE so the design
      // morphs as the model works, not just when it finishes.
      async streamResponse(resp) {
        const reader = resp.body.getReader()
        const decoder = new TextDecoder()
        let buffer = ""
        let content = ""
        let reasoning = ""
        let design = null
        let tools = null
        while (true) {
          const { done, value } = await reader.read()
          if (done) break
          buffer += decoder.decode(value, { stream: true })
          const lines = buffer.split("\n")
          buffer = lines.pop()
          for (const line of lines) {
            const s = line.trim()
            if (!s.startsWith("data:")) continue
            const payload = s.slice(5).trim()
            if (payload === "[DONE]") continue
            let evt
            try { evt = JSON.parse(payload) } catch { continue }
            if (evt.error) throw new Error(evt.error)
            const delta = evt.choice && evt.choice.delta
            const c = delta && (delta.content || "")
            const r = delta && (delta.reasoning_content || "")
            if (r) reasoning += r
            if (c) content += c
            if (evt.tool) this.appendToolTurn(evt.tool.name, evt.tool.args)
            if (evt.tools) tools = evt.tools
            if (evt.design && evt.design.elementLists) {
              design = evt.design
              this.applyDesignLive(evt.design)
            }
          }
        }
        return { content, reasoning, design, tools }
      }

      // Client-driven Copilot loop: the server relays the model's tool calls; this widget
      // executes them against the LIVE v2 store via builder.copilotTools (each edit morphs the
      // canvas and is undoable), then posts the results back to resume the loop.
      async clientSend(prompt, signal) {
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content
        const tools = window.builder.copilotTools.TOOLS
        let finalContent = ""
        let lastContent = ""
        let changed = false
        let mutationRetry = false
        let url = "/plugins/ai_writer/chat"
        let body = {
          mode: this.mode, prompt, env: "html", clientTools: true,
          context: this.contextValue, site: this.siteValue, brand: this.hasBrandTarget ? this.brandTarget.value : "",
          history: this.history, designIndex: window.builder.copilotTools.index(),
          tools: JSON.stringify(tools)
        }
        try {
          for (let round = 0; round < 16; round++) {
            const resp = await fetch(url, {
              method: "POST",
              headers: { "X-CSRF-Token": csrf, "Content-Type": "application/json", "Accept": "text/event-stream" },
              signal: signal,
              body: JSON.stringify(body)
            })
            if (!resp.ok) { const j = await resp.json().catch(() => ({})); throw new Error(j.error || "Copilot failed (" + resp.status + ")") }
            const streamed = await this.streamResponse(resp)
            lastContent = streamed.content || lastContent
            if (!streamed.tools || !streamed.tools.calls || !streamed.tools.calls.length) {
              // A design action without a builder mutation is never a successful Copilot run.
              // Models occasionally answer conversationally despite having the full tool surface;
              // give them one explicit recovery pass instead of showing the old generic prompt.
              if (!changed && !mutationRetry && ["design", "rewrite", "add_section"].includes(this.mode)) {
                mutationRetry = true
                url = "/plugins/ai_writer/chat"
                body = { ...body, prompt: prompt + "\n\nExecute this now with the mutating builder tools. Do not ask a follow-up question or only describe a proposal." }
                continue
              }
              finalContent = streamed.content || lastContent
              break
            }
            const results = streamed.tools.calls.map((call) => {
              const execution = this.executeTool(call.name, call.arguments)
              if (execution.mutated) changed = true
              return { id: call.id, content: execution.content }
            })
            url = "/plugins/ai_writer/tool_result"
            body = { session_id: streamed.tools.session_id, results }
          }
          this.handleClientReply(finalContent || lastContent, changed)
        } catch (e) {
          this.endThinking()
          throw e
        }
      }

      executeTool(name, args) {
        try {
          const out = window.builder.copilotTools.apply(name, args || {})
          this.appendToolTurn(name, args)
          return { content: String(out), mutated: window.builder.copilotTools.isMutation(name) }
        } catch (e) { return { content: "tool error: " + e.message, mutated: false } }
      }

      // Client-tools path: edits already morphed the canvas live; checkpoint the v2 store only
      // when tools actually changed something (a plain chat reply gets no design checkpoint).
      handleClientReply(text, changed) {
        this.endThinking()
        if (changed) {
          this.addAssistantMessage(text || "Updated the design.")
          this.designViewTarget.classList.remove("hidden")
          this.pushCheckpoint(text || "Design update")
          if (typeof window.applyCustomCode === "function") window.applyCustomCode()
        } else {
          this.addAssistantMessage(text || "I couldn’t safely apply that request because no builder change was produced. Please retry; the page has been left untouched.")
        }
        this.history.push({ role: "user", content: this.promptTarget.value.trim() })
        this.history.push({ role: "assistant", content: text || "" })
        this.promptTarget.value = ""
      }

      // Apply a streamed design state to the canvas immediately (live editing). No checkpoint is
      // pushed here — the final state gets one checkpoint when the message completes.
      applyDesignLive(design) {
        if (!design || !design.elementLists) return
        this.pendingSpec = { elementLists: design.elementLists }
        if (design.customCss != null) this.customCss = design.customCss
        if (design.customJs != null) this.customJs = design.customJs
        this.designHtml = specToHtml(this.pendingSpec)
        this.designViewTarget.classList.remove("hidden")
        this.previewOnCanvas()
        this._liveApplied = true
      }

      handleResponse(text, design) {
        this.endThinking()

        // Tool-based edits were applied live (including the review-and-refine phase), so the
        // design state on the canvas is authoritative — show the confirmation and checkpoint.
        if (this._liveApplied) {
          this._liveApplied = false
          this.addAssistantMessage(text || "Updated the design.")
          this.showPlan(this.pendingSpec)
          this.designViewTarget.classList.remove("hidden")
          this.pushCheckpoint(text || "Design update")
          this.history.push({ role: "user", content: this.promptTarget.value.trim() })
          this.history.push({ role: "assistant", content: text || "" })
          this.promptTarget.value = ""
          return
        }

        // Tool-based edits (non-streamed path): apply the final design verbatim.
        if (design && design.elementLists) {
          this.pendingSpec = { elementLists: design.elementLists }
          if (design.customCss != null) this.customCss = design.customCss
          if (design.customJs != null) this.customJs = design.customJs
          this.designHtml = specToHtml(this.pendingSpec)
          this.addAssistantMessage(text || "Updated the design.")
          this.showPlan(this.pendingSpec)
          this.designViewTarget.classList.remove("hidden")
          this.previewOnCanvas()
          this.pushCheckpoint(text || "Design update")
          this.history.push({ role: "user", content: this.promptTarget.value.trim() })
          this.history.push({ role: "assistant", content: text || "" })
          this.promptTarget.value = ""
          return
        }

        const parsed = this.parseDesign(text)
        const spec = parsed && parsed.spec && parsed.spec.elementLists ? parsed.spec : null
        const ops = parsed && parsed.ops && parsed.ops.length ? parsed.ops : null
        const editIndex = this.editingSection

        // "Add section" mode must never wipe the existing design: a full-spec reply is treated
        // as the NEW section(s) to append, not as a replacement.
        if (this.mode === "add_section" && spec && !ops && this.pendingSpec) {
          this.pendingSpec.elementLists = this.pendingSpec.elementLists.concat(spec.elementLists)
          if (parsed.customCss) this.customCss = parsed.customCss
          if (parsed.customJs) this.customJs = parsed.customJs
          this.designHtml = specToHtml(this.pendingSpec)
          this.addAssistantMessage(parsed.reply || "Added " + spec.elementLists.length + " section(s) to your design.")
          this.showPlan(this.pendingSpec)
          this.previewOnCanvas()
          this.pushCheckpoint(parsed.reply || "Added section(s)")
        } else if (ops && this.pendingSpec) {
          // Precision edits ("sed" on the current design): apply ops, re-render in place.
          const changed = this.applyOps(ops)
          if (changed) {
            if (parsed.customCss) this.customCss = parsed.customCss
            if (parsed.customJs) this.customJs = parsed.customJs
            this.designHtml = specToHtml(this.pendingSpec)
            this.addAssistantMessage(parsed.reply || "Applied your edits to the current design.")
            this.showPlan(this.pendingSpec)
            this.previewOnCanvas()
            this.pushCheckpoint(parsed.reply || "Precise edits")
            this.logAction("Applied " + ops.length + " precise edit(s)")
          } else {
            this.addAssistantMessage(parsed.reply || "I couldn't apply those edits to the current design — the section or element may not exist.")
          }
        } else if (editIndex != null && spec && this.pendingSpec && this.pendingSpec.elementLists[editIndex]) {
          // Surgical edit: merge the model's returned (single) section into the design.
          const newSection = spec.elementLists[0]
          this.pendingSpec.elementLists[editIndex] = newSection
          if (parsed.customCss) this.customCss = parsed.customCss
          if (parsed.customJs) this.customJs = parsed.customJs
          this.designHtml = specToHtml(this.pendingSpec)
          this.addAssistantMessage(parsed.reply || "Updated section " + (editIndex + 1) + ".")
          this.logAction("Updated section " + (editIndex + 1))
          this.updatePlanRow(editIndex, newSection)
          this.previewOnCanvas()
          this.pushCheckpoint(parsed.reply || "Updated section " + (editIndex + 1))
        } else if (spec) {
          this.pendingSpec = spec
          if (parsed.customCss) this.customCss = parsed.customCss
          if (parsed.customJs) this.customJs = parsed.customJs
          this.designHtml = specToHtml(spec)
          this.addAssistantMessage(parsed.reply || "Here's a proposed design.")
          this.showPlan(spec)
          this.designViewTarget.classList.remove("hidden")
          this.previewOnCanvas()
          this.pushCheckpoint(parsed.reply || "Design")
        } else if (parsed && parsed.html) {
          this.addAssistantMessage(parsed.reply || "Here's a design for your page.")
          this.pendingSpec = null
          this.design = parsed.html
          this.previewOnCanvas()
          this.designViewTarget.classList.remove("hidden")
          this.pushCheckpoint(parsed.reply || "Design")
        } else if (parsed && parsed.reply) {
          this.addAssistantMessage(parsed.reply)
        } else {
          this.addAssistantMessage(text ? "Hmm, that didn't come through as a design or a reply — try again." : "No response — check Settings → Copilot.")
        }
        this.history.push({ role: "user", content: this.promptTarget.value.trim() })
        this.history.push({ role: "assistant", content: parsed && parsed.reply ? parsed.reply : (text || "") })
        this.promptTarget.value = ""
      }

      // ---- checkpoints (undo/step-back for AI changes) --------------------------------

      // Snapshot the current design as the latest checkpoint. Each successful change becomes a
      // restore point, so a bad AI edit is always one click away.
      pushCheckpoint(label) {
        const snapshot = {
          spec: this.pendingSpec ? JSON.parse(JSON.stringify(this.pendingSpec)) : null,
          designHtml: this.designHtml,
          customCss: this.customCss || "",
          customJs: this.customJs || "",
          design: this.design || "",
          store: (window.builder && window.builder.getData) ? JSON.parse(JSON.stringify(window.builder.getData())) : null,
          label: String(label || "Change").slice(0, 60)
        }
        // Truncate history so it can't grow forever.
        this.checkpoints = this.checkpoints.slice(-24)
        this.checkpoints.push(snapshot)
        this.checkpointIndex = this.checkpoints.length - 1
        this.renderCheckpoints()
      }

      renderCheckpoints() {
        this.designViewTarget.classList.toggle("hidden", this.checkpoints.length === 0)
        const chips = this.checkpoints.map((cp, i) =>
          '<button type="button" class="bc-checkpoint' + (i === this.checkpointIndex ? " bc-checkpoint-active" : "") + '" data-checkpoint="' + i + '" title="Restore this design state">' +
          '<span class="bc-checkpoint-tag">' + (i + 1) + "</span> " + esc(cp.label) + "</button>"
        ).join("")
        this.checkpointsTarget.innerHTML = chips
        this.undoCheckpointTarget.disabled = this.checkpointIndex <= 0
      }

      restoreCheckpoint(index) {
        const cp = this.checkpoints[index]
        if (!cp) return
        this.checkpointIndex = index
        this.pendingSpec = cp.spec ? JSON.parse(JSON.stringify(cp.spec)) : null
        this.designHtml = cp.designHtml
        this.customCss = cp.customCss
        this.customJs = cp.customJs
        this.design = cp.design
        // Client-tools checkpoints snapshot the v2 store; restore it directly.
        if (cp.store && window.builder && window.builder.parse) {
          window.builder.clear()
          window.builder.parse(cp.store)
          window.builder.render()
          if (window.builder.customCode) window.builder.customCode.update(this.customCss || "", this.customJs || "")
          if (typeof window.applyCustomCode === "function") window.applyCustomCode()
        } else if (this.designHtml) {
          this.previewOnCanvas()
        }
        this.renderCheckpoints()
        this.showPlan(this.pendingSpec || { elementLists: [] })
        this.logAction("Restored checkpoint " + (index + 1))
      }

      undoCheckpoint() {
        if (this.checkpointIndex > 0) this.restoreCheckpoint(this.checkpointIndex - 1)
      }

      // Show the current design on the builder canvas. Store-backed designs were already
      // rendered as editable builder elements by specToHtml; here we just ensure the design's
      // custom CSS tokens (the researched brand stylesheet) are live on the canvas. Raw HTML
      // designs (model legacy output) are painted directly.
      previewOnCanvas() {
        if (!this.designHtml && !this.design) return
        const doc = window.builder && (window.builder.iframeDoc || (window.builder.iframe && window.builder.iframe.contentDocument))
        if (!doc || !doc.body) return
        if (!this.pendingSpec && !(this.designHtml && this.designHtml.indexOf('builder-element') > -1)) {
          doc.body.innerHTML = this.designHtml || this.design
        }
        // Inject the design's own tokens (brand --cp-* overrides) into the canvas so the
        // on-canvas preview reflects the researched design system, without touching the Code tab.
        const old = doc.getElementById("__copilot_design_tokens")
        if (old) old.remove()
        if (this.customCss) {
          const st = doc.createElement("style")
          st.id = "__copilot_design_tokens"
          st.textContent = this.customCss
          doc.head.appendChild(st)
        }
        if (typeof window.applyCustomCode === "function") window.applyCustomCode()
      }

      // Update a plan-card section row in place after a surgical edit.
      updatePlanRow(index, sec) {
        const row = this.transcriptTarget.querySelector('[data-section-row][data-index="' + index + '"]')
        if (!row) return
        const els = sec && sec.elements || []
        const pills = els.map((e) => "<span class=\"bc-plan-el\">" + esc(e.name || "Element") + "</span>").join(" ")
        const firstText = esc((els[0] && els[0].text || "").slice(0, 70))
        row.innerHTML = '<span class="bc-plan-sec-label">Section ' + (index + 1) + ':</span> ' + firstText +
          '<div class="bc-plan-els">' + pills + '</div>'
        row.classList.add("bc-section-updated")
      }

      // Render the proposed design as a plan card, so the user reviews before applying.
      showPlan(spec) {
        const sections = spec.elementLists || []
        const items = sections.map((sec, i) => {
          const els = sec && sec.elements || []
          const pills = els.map((e) => "<span class=\"bc-plan-el\">" + esc(e.name || "Element") + "</span>").join(" ")
          const firstText = esc((els[0] && els[0].text || "").slice(0, 70))
          return '<div class="bc-plan-sec" data-section-row data-index="' + i + '" title="Click to edit this section">' +
            '<span class="bc-plan-sec-label">Section ' + (i + 1) + ':</span> ' + firstText +
            '<div class="bc-plan-els">' + pills + "</div></div>"
        }).join("")
        this.transcriptTarget.insertAdjacentHTML("beforeend",
          '<div class="bc-plan"><div class="bc-plan-title">Proposed design — review before applying</div>' +
          '<div class="bc-plan-body">' + items + "</div>" +
          '<div class="bc-plan-actions"><span class="bc-plan-hint">Click a section to edit it surgically, or preview below and hit Apply.</span></div></div>')
        this.scrollTranscript()
      }

      // Apply the proposed design to the page: saves the rendered HTML through the builder's
      // save endpoint. The published page renders the design (the builder's public output is
      // the saved HTML). The canvas itself edits its own store, which this third-party builder
      // won't reliably load from AI-generated content — so after applying we point the user at
      // the live page rather than pretending the canvas changed.
      async apply() {
        const html = this.designHtml || this.design
        if (!html) { this.addError("No design to apply yet."); return }
        const btn = this.applyTarget
        const original = btn.textContent
        btn.disabled = true
        btn.textContent = "Saving…"
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content
        // designHtml is the builder's own full <html> doc (store-rendered); legacy raw-HTML
        // designs are fragments — normalize them to a full document for the save endpoint.
        const fullDoc = /<html[\s>]/i.test(html) ? html : "<html><head></head><body>" + html + "</body></html>"
        // Preserve the page's custom CSS/JS: use the design's custom code if the model
        // provided it, otherwise keep the builder Code tab's values — so nothing is stripped.
        const tabCss = document.getElementById("customCss") ? document.getElementById("customCss").value : ""
        const tabJs = document.getElementById("customJs") ? document.getElementById("customJs").value : ""
        const customCss = this.customCss || tabCss
        const customJs = this.customJs || tabJs
        // The design's builder store (element data = source of truth): reopening the builder
        // loads it as real, editable elements.
        const store = this.pendingSpec ? completeStore(this.pendingSpec) : null
        try {
          const resp = await fetch("/builder/save", {
            method: "POST",
            headers: { "X-CSRF-Token": csrf, "Content-Type": "application/json", "Accept": "application/json" },
            body: JSON.stringify({ html: fullDoc, store: store, custom_css: customCss, custom_js: customJs, record_type: this.recordTypeValue, record_id: this.recordIdValue })
          })
          const j = await resp.json().catch(() => ({}))
          if (!resp.ok) throw new Error(j.error || "Save failed (" + resp.status + ")")
          btn.textContent = "Applied"
          this.logAction("Design applied to the page.")
          const viewPath = (this.recordTypeValue === "page" ? "/pages/" : "/posts/") + this.recordIdValue
          this.showViewLink(viewPath)
        } catch (e) {
          btn.textContent = original
          this.addError(e.message)
          btn.disabled = false
        }
      }

      // A prominent "view it live" link after applying a design.
      showViewLink(path) {
        this.transcriptTarget.insertAdjacentHTML("beforeend",
          '<div class="bc-plan" style="border-color:#a7f3d0;background:#ecfdf5"><div class="bc-plan-title">Design saved to your page</div>' +
          '<div class="bc-plan-body"><a href="' + esc(path) + '" target="_blank" rel="noopener" class="bc-btn" style="display:inline-flex;width:auto">View it live →</a></div>' +
          '<div class="bc-plan-hint" style="margin-top:6px">The canvas edits its own store, so AI-generated pages render on the published page. Re-open the builder to keep editing the theme layout.</div></div>')
        this.scrollTranscript()
      }

      // ---- surgical section editing ---------------------------------------------

      // Select a section from the plan card to edit surgically (highlight + target).
      selectSection(event) {
        const idx = Number(event.currentTarget.dataset.index)
        this.editingSection = idx
        this.transcriptTarget.querySelectorAll("[data-section-row]").forEach((row) => {
          row.classList.toggle("bc-section-active", Number(row.dataset.index) === idx)
        })
        this.setStatus("Editing section " + (idx + 1) + " — tell Copilot what to change.", false)
        this.promptTarget.focus()
      }

      clearSection() {
        this.editingSection = null
        this.transcriptTarget.querySelectorAll("[data-section-row]").forEach((row) => row.classList.remove("bc-section-active"))
        this.setStatus("", false)
      }

      // Find the target section index: explicit "edit/change section N" in the prompt, else a
      // selected row. "Add/insert a section" is a positional insert — never a surgical edit.
      targetSectionIndex(prompt) {
        const p = String(prompt || "")
        if (/\b(add|insert|append|create|new)\b.*\bsection\b/i.test(p)) return null
        const m = p.match(/section\s+(\d+)/i)
        if (m) return Math.max(0, Number(m[1]) - 1)
        return this.editingSection
      }

      // Parse the model's reply into a design. Tries JSON first (in case a provider still
      // returns {reply, spec|store|html}), then the simple marked-text format (REPLY:/BG:/H1:/H5:/P:/BUTTON:/LIST:)
      // which reasoning models produce far more reliably than JSON.
      parseDesign(text) {
        if (!text) return null
        const cleaned = String(text).replace(/```json|```/g, "")
        const starts = []
        for (let i = 0; i < cleaned.length; i++) if (cleaned[i] === "{") starts.push(i)
        for (const start of starts) {
          let depth = 0
          for (let i = start; i < cleaned.length; i++) {
            if (cleaned[i] === "{") depth++
            else if (cleaned[i] === "}") {
              depth--
              if (depth === 0) {
                try {
                  const obj = JSON.parse(cleaned.slice(start, i + 1))
                  if (obj && (
                    typeof obj.html === "string" ||
                    (obj.spec && obj.spec.elementLists) ||
                    (obj.store && obj.store.elementLists) ||
                    typeof obj.reply === "string"
                  )) return obj
                } catch { /* try next */ }
                break
              }
            }
          }
        }
        return this.parseDesignText(text)
      }

      // The marked-text design format the model replies with. Returns {reply, spec, customCss, customJs, ops}.
      // Supports CSS: and JS: blocks (page-level custom code) after the design sections, plus
      // precision ops (sed-style edits against the current design — see the system prompt).
      parseDesignText(text) {
        let reply = ""
        let customCss = ""
        let customJs = ""
        const sections = []
        const ops = []
        let current = null
        let mode = "design"
        let opAddSection = null
        const startSection = (bg) => {
          current = { bg: bg || null, elements: [] }
          sections.push(current)
        }
        const elementFromLine = (m) => {
          const type = m[1].toUpperCase()
          const content = m[2].trim()
          switch (type) {
            case "H5": return { name: "H5Element", template: "H5", text: content }
            case "H1": return { name: "H1Element", template: "H1", text: content }
            case "P": return { name: "PElement", template: "P", text: content, align: "left" }
            case "BUTTON": return { name: "ButtonElement", template: "Button", text: content }
            case "LIST": return { name: "ListElement", template: "List", text: content.split("|").map((s) => s.trim()).join("\n"), align: "left" }
            case "IMG": return { name: "ImageElement", template: "Image", text: content }
            case "DIVIDER": return { name: "DividerElement", template: "Divider", text: "" }
          }
        }

        String(text || "").split("\n").forEach((rawLine) => {
          const line = rawLine.trim()
          if (!line && mode !== "css" && mode !== "js") return

          // ---- precision ops (sed on the current design spec) ----
          const addEl = line.match(/^ADD\s+SECTION\s+(\d+)\s+ELEMENT\s+(H5|H1|P|BUTTON|LIST|IMG|DIVIDER):\s*(.*)$/i)
          const editEl = line.match(/^EDIT\s+SECTION\s+(\d+)\s+ELEMENT\s+(\d+)\s+(\w+):\s*(.*)$/i)
          const editSec = line.match(/^EDIT\s+SECTION\s+(\d+)\s+(\w+):\s*(.*)$/i)
          const remEl = line.match(/^REMOVE\s+SECTION\s+(\d+)\s+ELEMENT\s+(\d+)$/i)
          const remSec = line.match(/^REMOVE\s+SECTION\s+(\d+)$/i)
          const addSec = line.match(/^ADD\s+SECTION(?:\s+(AFTER|BEFORE)\s+(\d+))?(?:\s+(\d+))?(?:\s+bg:\s*(.*))?$/i)
          const movSec = line.match(/^MOVE\s+SECTION\s+(\d+)\s+(before|after|to)\s+(\d+)$/i)
          if (addEl) {
            opAddSection = null
            const name = addEl[2].toUpperCase()
            ops.push({ op: "add_element", section: Number(addEl[1]) - 1, name: name, text: addEl[3].trim() })
            return
          }
          if (editEl) {
            opAddSection = null
            ops.push({ op: "edit_element", section: Number(editEl[1]) - 1, element: Number(editEl[2]), field: editEl[3].toLowerCase(), value: editEl[4].trim() })
            return
          }
          if (editSec) {
            opAddSection = null
            ops.push({ op: "edit_section", section: Number(editSec[1]) - 1, field: editSec[2].toLowerCase(), value: editSec[3].trim() })
            return
          }
          if (remEl) {
            opAddSection = null
            ops.push({ op: "remove_element", section: Number(remEl[1]) - 1, element: Number(remEl[2]) })
            return
          }
          if (remSec) {
            opAddSection = null
            ops.push({ op: "remove_section", section: Number(remSec[1]) - 1 })
            return
          }
          if (addSec) {
            const position = (addSec[1] || "").toLowerCase()
            const target = addSec[2] != null ? Number(addSec[2]) : (addSec[3] != null ? Number(addSec[3]) : null)
            const op = { op: "add_section", position: position || (target != null ? "at" : "append"), target: target, bg: (addSec[4] || "").trim() || null, elements: [] }
            ops.push(op)
            opAddSection = op
            return
          }
          if (movSec) {
            opAddSection = null
            ops.push({ op: "move_section", section: Number(movSec[1]) - 1, where: movSec[2].toLowerCase(), target: Number(movSec[3]) - 1 })
            return
          }

          if (/^REPLY:/i.test(line)) { reply = line.replace(/^REPLY:/i, "").trim(); return }
          if (/^CSS:/i.test(line)) { mode = "css"; return }
          if (/^JS:/i.test(line)) { mode = "js"; return }
          if (/^BG:/i.test(line)) { mode = "design"; startSection(line.replace(/^BG:/i, "").trim()); return }
          if (mode === "css") { customCss += rawLine + "\n"; return }
          if (mode === "js") { customJs += rawLine + "\n"; return }

          // Magic design-kit markers (renderSection knows how to render each).
          if (/^AURORA:(?:\s*(.*))?$/i.test(line)) { const g = line.match(/^AURORA:\s*(.*)$/i); if (!current) startSection(null); current.aurora = true; const p = String(g[1] || "").split("|").map((s) => s.trim()); if (p[0]) current.bg = p[0]; if (p.length >= 2) { current.auroraFrom = p[1]; current.auroraTo = p[2] || p[1] } return }
          if (/^SHIMMER:\s*(.*)$/i.test(line)) { const g = line.match(/^SHIMMER:\s*(.*)$/i); if (!current) startSection(null); current.elements.push({ name: "ShimmerTitleElement", template: "ShimmerTitle", text: g[1].trim() }); return }
          if (/^GRADIENT:\s*(.*)$/i.test(line)) {
            const g = line.match(/^GRADIENT:\s*(.*)$/i)
            const p = String(g[1]).split("|").map((s) => s.trim())
            const el = { name: "GradientTitleElement", template: "GradientTitle", text: p.length > 1 ? p[p.length - 1] : p[0] }
            if (p.length >= 2) { el.from = p[0]; el.to = p[1] || p[0] }
            if (!current) startSection(null)
            current.elements.push(el)
            return
          }
          if (/^MARQUEE:\s*(.*)$/i.test(line)) { const g = line.match(/^MARQUEE:\s*(.*)$/i); if (!current) startSection(null); current.elements.push({ name: "MarqueeElement", template: "Marquee", text: g[1].trim() }); return }
          if (/^SPOTLIGHT/i.test(line)) { if (!current) startSection(null); current.spotlight = true; return }
          if (/^BENTO/i.test(line)) { if (!current) startSection(null); current.bento = true; return }
          if (/^CARD:\s*(.*)$/i.test(line)) { const g = line.match(/^CARD:\s*(.*)$/i); const p = String(g[1]).split("|").map((s) => s.trim()); if (!current) startSection(null); if (!current.bento) current.bento = true; current.elements.push({ name: "BentoCardElement", template: "BentoCard", text: p[0] + (p[1] != null ? "|" + p[1] : ""), span: p[2] && p[2].toLowerCase() === "wide" ? "wide" : p[2] && p[2].toLowerCase() === "tall" ? "tall" : "" }); return }
          if (/^SPOTCARD:\s*(.*)$/i.test(line)) { const g = line.match(/^SPOTCARD:\s*(.*)$/i); if (!current) startSection(null); current.elements.push({ name: "SpotlightCardElement", template: "SpotlightCard", text: g[1].trim() }); return }
          if (/^STAT:\s*(.*)$/i.test(line)) { const g = line.match(/^STAT:\s*(.*)$/i); if (!current) startSection(null); current.elements.push({ name: "StatElement", template: "Stat", text: g[1].trim() }); return }
          if (/^EFFECT:\s*(.*)$/i.test(line)) { const g = line.match(/^EFFECT:\s*(.*)$/i); if (!current) startSection(null); current.effect = g[1].trim().toLowerCase(); return }
          if (/^NOISE/i.test(line)) { if (!current) startSection(null); current.noise = true; return }

          const m = line.match(/^(H5|H1|P|BUTTON|LIST|IMG|DIVIDER):\s*(.*)$/i)
          if (!m) return
          if (opAddSection) { opAddSection.elements.push(elementFromLine(m)); return }
          const el = elementFromLine(m)
          if (el) { if (!current) startSection(null); current.elements.push(el) }
        })

        const spec = sections.length ? { elementLists: sections } : null
        return { reply, spec, customCss: customCss.trim(), customJs: customJs.trim(), ops }
      }

      // ---- precision edits (our "sed" on the design spec) ------------------------------

      // Apply an array of ops to this.pendingSpec (the current design as its compact store).
      // Section and element indices are 0-based. Returns true if anything changed.
      applyOps(ops) {
        if (!ops || !ops.length || !this.pendingSpec || !this.pendingSpec.elementLists) return false
        const sections = this.pendingSpec.elementLists
        let changed = false
        ops.forEach((op) => {
          switch (op.op) {
            case "edit_element": {
              const el = sections[op.section] && sections[op.section].elements[op.element]
              if (!el) return
              if (op.field === "text" || op.field === "label") el.text = op.value
              else if (op.field === "align") el.align = op.value
              changed = true
              break
            }
            case "edit_section": {
              const sec = sections[op.section]
              if (!sec) return
              if (op.field === "bg") sec.bg = op.value || null
              changed = true
              break
            }
            case "add_element": {
              const sec = sections[op.section]
              if (!sec) return
              const name = op.name + "Element"
              const el = { name: name, template: op.name === "DIVIDER" ? "Divider" : op.name, text: op.text }
              if (op.name === "P" || op.name === "LIST") el.align = "left"
              if (op.name === "LIST") el.text = op.text.split("|").map((s) => s.trim()).join("\n")
              sec.elements.push(el)
              changed = true
              break
            }
            case "remove_element": {
              const sec = sections[op.section]
              if (sec && sec.elements && op.element >= 0 && op.element < sec.elements.length) {
                sec.elements.splice(op.element, 1)
                changed = true
              }
              break
            }
            case "remove_section": {
              if (op.section >= 0 && op.section < sections.length) { sections.splice(op.section, 1); changed = true }
              break
            }
            case "add_section": {
              const newSec = { bg: op.bg || null, elements: op.elements || [] }
              if (op.position === "after" && op.target != null) {
                sections.splice(Math.min(op.target + 1, sections.length), 0, newSec)
              } else if (op.target != null) {
                sections.splice(Math.max(0, Math.min(op.target, sections.length)), 0, newSec)
              } else {
                sections.push(newSec)
              }
              changed = true
              break
            }
            case "move_section": {
              if (op.section < 0 || op.section >= sections.length) return
              const el = sections[op.section]
              sections.splice(op.section, 1)
              let at = op.target
              if (op.where === "after") at += 1
              at = Math.max(0, Math.min(at, sections.length))
              sections.splice(at, 0, el)
              changed = true
              break
            }
          }
        })
        return changed
      }

      // ---- transcript helpers ----------------------------------------------------

      addUserMessage(text) {
        this.transcriptTarget.querySelector("[data-copilot-empty]")?.remove()
        this.transcriptTarget.insertAdjacentHTML("beforeend",
          '<div class="bc-user"><div>' + esc(text) + "</div></div>")
        this.scrollTranscript()
      }

      beginThinking() {
        this.transcriptTarget.insertAdjacentHTML("beforeend",
          '<div data-builder-copilot-target="thinking" class="bc-thinking"><div class="bc-thinking-dot"></div>' +
          '<div class="bc-thinking-body"><div class="bc-thinking-label">Designing</div>' +
          '<div class="bc-thinking-text"></div></div></div>')
        this.scrollTranscript()
      }

      appendThinking(delta) {
        const el = this.transcriptTarget.querySelector("[data-builder-copilot-target='thinking']")
        if (!el) return
        const body = el.querySelector(".bc-thinking-text")
        if (body) { body.textContent += delta; this.scrollTranscript() }
      }

      // Show concise progress labels without leaking arguments, generated copy, or reasoning.
      appendToolTurn(name, args) {
        const el = this.transcriptTarget.querySelector("[data-builder-copilot-target='thinking']")
        this._toolTurns = this._toolTurns || []
        this._toolTurns.push({ name: name, args: args })
        if (!el) return
        const body = el.querySelector(".bc-thinking-text")
        if (!body) return
        const labels = {
          get_capabilities: "Studying available elements",
          read_design: "Reading the current page",
          read_element: "Inspecting an element",
          read_custom_code: "Reviewing page effects",
          compose_landing_page: "Composing the art-directed page",
          replace_page: "Composing the full page",
          append_tree: "Adding the new section",
          audit_design: "Checking the rendered result",
          set_styles: "Refining responsive styles",
          update_element: "Refining content",
          set_custom_css: "Applying the art direction",
          set_custom_js: "Adding progressive interaction",
          css_edit: "Polishing visual details"
        }
        body.textContent += (body.textContent ? "\n" : "") + (labels[name] || "Refining the design")
        this.scrollTranscript()
      }

      endThinking() {
        const box = this.transcriptTarget.querySelector("[data-builder-copilot-target='thinking']")
        if (!box) return
        const text = (box.querySelector(".bc-thinking-text") || {}).textContent || ""
        // Keep a subtle completion record without exposing hidden reasoning or tool payloads.
        if (text.trim()) {
          this.transcriptTarget.insertAdjacentHTML("beforeend",
            '<div class="bc-log"><span class="bc-log-arrow">✓</span><span>' +
            (this._toolTurns && this._toolTurns.length ? "Completed " + this._toolTurns.length + " design step" + (this._toolTurns.length === 1 ? "" : "s") : "Design pass complete") +
            "</span></div>")
          this.scrollTranscript()
        }
        box.remove()
        this._toolTurns = []
      }

      addAssistantMessage(text) {
        if (!text) return
        this.transcriptTarget.insertAdjacentHTML("beforeend",
          '<div class="bc-bubble">' + esc(text) + "</div>")
        this.scrollTranscript()
      }

      addError(text) {
        let message = String(text || "Copilot could not complete the request.")
        if (/deserialize|tools\[\d+\]|missing field [`']type/i.test(message)) {
          message = "The AI provider rejected the design-tool connection. Please retry; if it continues, check that the configured provider supports OpenAI-compatible function tools."
        } else if (message.length > 280 || /\{\s*["']error/i.test(message)) {
          message = "Copilot could not complete this design request. Please retry, or use a more focused prompt if the provider continues to fail."
        }
        this.transcriptTarget.insertAdjacentHTML("beforeend",
          '<div class="bc-error" role="alert">' + esc(message) + "</div>")
        this.scrollTranscript()
      }

      logAction(text) {
        this.transcriptTarget.insertAdjacentHTML("beforeend",
          '<div class="bc-log"><span class="bc-log-arrow">↳</span><span>' + esc(text) + "</span></div>")
        this.scrollTranscript()
      }

      scrollTranscript() {
        this.transcriptTarget.scrollTop = this.transcriptTarget.scrollHeight
      }

      setStatus(text, busy) {
        this.statusTarget.textContent = text
        this.statusDotTarget.classList.toggle("hidden", !busy)
      }
    }

    application.register("builder-copilot", BuilderCopilotController)
  </script>
</div>
