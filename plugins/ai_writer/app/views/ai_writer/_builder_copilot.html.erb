          this.stopReason = "cancelled"
          this.abortController?.abort()
          return
        }
        const prompt = this.promptTarget.value.trim()
        if (!prompt) return
        this.busy = true
        this.stopReason = null
        this.abortController = new AbortController()
        this.setSendRunning(true)
        this.requestTimer = setTimeout(() => {
          this.stopReason = "timeout"
          this.abortController?.abort()
        }, 180000)
        this.setStatus("Thinking…", true)

        const editIndex = this.targetSectionIndex(prompt)
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content
        this._liveApplied = false
        // Seed the server-side working copy with the current custom CSS/JS (the working design's
        // code, else the builder Code tab's saved page code) so precision css_edit tools build
        // on the existing stylesheet instead of replacing it.
        const baseCss = this.customCss || (document.getElementById("customCss") ? document.getElementById("customCss").value : "")
        const baseJs = this.customJs || (document.getElementById("customJs") ? document.getElementById("customJs").value : "")
        this.addUserMessage(prompt)
        this.beginThinking()
