  <script type="module">
    import { Controller } from "@hotwired/stimulus"
    import { application } from "controllers/application"

    function esc(s) {
      return String(s == null ? "" : s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;")
    }

    // Exact default formats the builder's theme expects. Content elements (H1/P/Button) use
    // this simple formats object; sections are GridElement -> CellElement -> elementLists.
    const ELEMENT_FORMATS = {
      text_color: null, background_color: null, background_image: null,
      background_position: "center", background_size: "100%", background_repeat: "no-repeat",
      padding_top: 0, padding_right: 0, padding_bottom: 0, padding_left: 0, text_align: "center"
    }
    const CELL_FORMATS = {
      background_color: null, background_image: null, background_position: "center",
      background_size: "100%", background_repeat: "no-repeat", padding_top: 0,
      padding_right: 0, padding_bottom: 0, padding_left: 0, width: "", height: ""
    }
    const SECTION_FORMATS = {
      font_size: null, font_style: null, text_color: null, font_family: "inherit",
      font_weight: null, padding_top: 0, padding_left: 0, padding_right: 0,
      padding_bottom: 0, background_size: "100%", background_color: "#ffffff",
      background_image: null, background_repeat: "no-repeat", background_position: "center"
    }
    const LEFT_ALIGNED = { PElement: true, ListElement: true, DescriptionImageElement: true }

    // Element names the builder's ElementFactory actually accepts (switch cases + window
    // globals). Anything else makes createElement alert + throw and blanks the canvas, so we
    // map unknown model output to a safe paragraph element.
    const SAFE_ELEMENTS = {
      H1Element: true, H2Element: true, H3Element: true, H4Element: true, H5Element: true,
      PElement: true, ListElement: true, ImageElement: true, ButtonElement: true,
      LinkElement: true, BlockElement: true, GridElement: true, CellElement: true,
      DescriptionImageElement: true, SocialIconsElement: true, AlertElement: true,
      VideoElement: true, TableElement: true, MenuElement: true, RSSElement: true,
      TextInputElement: true, RadioElement: true, SelectElement: true,
      PricingTableElement: true, YoutubeElement: true
    }

    // Turn a compact spec { elementLists: [{ bg, elements: [{name,template,text,align}] }] } into
    // the builder's hierarchical store — the EXACT shape the builder itself produces: each
    // section is an ARRAY wrapping a GridElement whose cells are CellElements holding the content
    // elements. AI-only element names (GradientTitleElement, SpotlightCardElement, …) map onto
    // real builder elements + formats, so the design is 100% editable in the canvas. Element
    // styling flows from formats (inline) + the per-page .cp-* vocabulary; the design look lives
    // in the page custom CSS.
    function completeStore(spec) {
      const sections = (spec && spec.elementLists) || []
      // Drop sections with no content (a bare bg/effect would render as a giant empty colored
      // block); every emitted section must carry real, editable content.
      const elementLists = sections.map(buildSection).filter(Boolean)
      return { name: "PageElement", theme: "1_Column_Layout", formats: SECTION_FORMATS, elementLists }
    }

    // Design-system cascade: text colors are NOT inlined — the .cp-* vocabulary (var(--pb-*)
    // tokens) + the page's custom CSS drive them, so a Copilot-generated --pb-* design re-themes
    // EVERY element consistently. Only structure (size/align/effects) and design-required colors
    // (stat numbers on dark stat cards, gradient-title fallback) are set here.
    const H1_EL = (text, size, color, effect) => { const o = { name: "H1Element", template: "H1", formats: Object.assign({}, ELEMENT_FORMATS, { font_size: size || 40 }) }; if (color) o.formats.text_color = color; if (effect) o.formats.text_effect = effect; if (text != null) o.text = text; return o }
    const H5_EL = (text, align) => { const o = { name: "H5Element", template: "H5", formats: Object.assign({}, ELEMENT_FORMATS, { text_align: align || "center" }) }; if (text != null) o.text = text; return o }
    const P_EL = (text, align) => { const o = { name: "PElement", template: "P", formats: Object.assign({}, ELEMENT_FORMATS, { text_align: align || "center" }) }; if (text != null) o.text = text; return o }
    const BTN_EL = (text, effect) => { const o = { name: "ButtonElement", template: "Button", text: String(text == null ? "" : text), url: "#", formats: Object.assign({}, ELEMENT_FORMATS, { text_align: "center" }) }; if (effect) o.formats.button_effect = effect; return o }
    const LIST_EL = (text) => ({ name: "ListElement", template: "List", text: String(text == null ? "" : text), align: "left", formats: Object.assign({}, ELEMENT_FORMATS, { text_align: "left" }) })
    const CELL_OF = (blocks, extra) => ({ name: "CellElement", template: "Cell", elementLists: [blocks], formats: Object.assign({}, CELL_FORMATS, extra || {}) })

    function buildSection(sec) {
      const bg = (sec && sec.bg) || "#ffffff"
      const els = (sec && (sec.elements || [])) || []
      if (!els.length) return null
      const hero = [], cards = [], bentoCards = [], stats = [], marquees = [], buttons = [], lists = []
      let idx = 0
      while (idx < els.length && ["H5Element", "H1Element", "PElement", "GradientTitleElement", "ShimmerTitleElement"].includes(els[idx].name)) {
        hero.push(els[idx]); idx++
      }
      while (idx < els.length) {
        const e = els[idx]
        if (e.name === "H5Element" && els[idx + 1] && els[idx + 1].name === "PElement") { cards.push({ t: e.text || "", b: els[idx + 1].text || "" }); idx += 2 }
        else if (e.name === "SpotlightCardElement") { cards.push({ t: (e.text || "").split("|")[0] || "", b: (e.text || "").split("|")[1] || "" }); idx++ }
        else if (e.name === "BentoCardElement") { bentoCards.push({ t: (e.text || "").split("|")[0] || "", b: (e.text || "").split("|")[1] || "", span: e.span || "" }); idx++ }
        else if (e.name === "StatElement") { stats.push({ n: (e.text || "").split("|")[0] || "", l: (e.text || "").split("|")[1] || "" }); idx++ }
        else if (e.name === "MarqueeElement") { marquees.push(String(e.text || "")); idx++ }
        else if (e.name === "ButtonElement") { buttons.push(e); idx++ }
        else if (e.name === "ListElement") { lists.push(e); idx++ }
        else if (e.name === "PElement") { hero.push(e); idx++ }
        else idx++
      }

      const gformats = Object.assign({}, SECTION_FORMATS, { background_color: bg })
      if (sec && sec.aurora) gformats.section_effect = "aurora"
      else if (sec && sec.effect === "grid") gformats.section_effect = "grid"
      else if (sec && sec.effect === "dots") gformats.section_effect = "dots"
      else if (sec && sec.noise) gformats.section_effect = "noise"

      let layout = "columns", cells = []
      if (marquees.length) {
        layout = "marquee"
        const items = marquees[0].split("|").map((x) => x.trim()).filter(Boolean)
        cells = items.map((name) => CELL_OF([P_EL(name)]))
      } else if (bentoCards.length) {
        layout = "bento"
        cells = bentoCards.map((c) => CELL_OF([H5_EL(c.t, "left"), P_EL(c.b, "left")], c.span ? { span: c.span } : {}))
      } else if (stats.length) {
        layout = "stats"
        cells = stats.map((s) => CELL_OF([H1_EL(s.n, 40, "#ffffff"), H5_EL(s.l)]))
      } else if (cards.length) {
        layout = "spotlight"
        cells = cards.map((c) => CELL_OF([H5_EL(c.t, "left"), P_EL(c.b, "left")]))
      }

      const heroBlocks = []
      hero.forEach((e) => {
        if (e.name === "H5Element") heroBlocks.push(H5_EL(e.text))
        else if (e.name === "H1Element") heroBlocks.push(H1_EL(e.text, 40))
        else if (e.name === "GradientTitleElement") heroBlocks.push(H1_EL(e.text, 40, "#ffffff", "gradient"))
        else if (e.name === "ShimmerTitleElement") heroBlocks.push(H1_EL(e.text, 40, "#ffffff", "shiny"))
        else if (e.name === "PElement") heroBlocks.push(P_EL(e.text))
      })
      buttons.forEach((b, i) => heroBlocks.push(BTN_EL(b.text, i === 0 ? "shimmer" : "none")))
      lists.forEach((l) => heroBlocks.push(LIST_EL(l.text)))

      if (heroBlocks.length) {
        gformats.padding_top = 80; gformats.padding_bottom = 80
        cells.unshift(CELL_OF(heroBlocks))
      } else {
        gformats.padding_top = 64; gformats.padding_bottom = 64
      }
      if (!cells.length) cells = [CELL_OF([])]

      return [{
        name: "GridElement", template: "Grid", type: null,
        formats: Object.assign({}, gformats, { layout }),
        cells: cells
      }]
    }

    // Content elements of a section (digs through Grid -> Cell -> elementLists).
    function sectionElements(sec) {
      if (Array.isArray(sec)) return sec
      const cells = sec && sec.cells
      if (cells && cells[0] && cells[0].elementLists && cells[0].elementLists[0]) return cells[0].elementLists[0]
      return []
    }

    // Builder pattern for Copilot output: the design IS a builder store (element data = source
    // of truth). The builder renders it on the canvas, so previews and saved pages carry real
    // builder markers and stay 100% editable. Styling comes from element formats (inline) plus
    // the per-page .cp-* vocabulary + the design's custom CSS — never hand-built inline HTML.

    // Render a design spec through the builder: rebuild the store, render it on the canvas as
    // editable elements, and return the builder's own HTML (the source of truth for save).
    function specToHtml(spec) {
      if (!spec || !spec.elementLists || !spec.elementLists.length) return ""
      try {
        const store = completeStore(spec)
        if (window.builder && window.builder.clear) {
          window.builder.clear()
          window.builder.parse(store)
          window.builder.render()
          if (window.builder.applyCustomCode) window.builder.applyCustomCode()
          return window.builder.getHtml()
        }
      } catch (e) { console.error("Copilot store render failed:", e) }
      return ""
    }


    // Accept either a compact spec (client completes formats) or a full builder store.
    function toStore(design) {
      if (design.spec && design.spec.elementLists) return completeStore(design.spec)
      if (design.store && design.store.elementLists) return design.store
      return null
    }

    class BuilderCopilotController extends Controller {
      static targets = ["fab", "window", "transcript", "prompt", "send", "status", "statusDot", "mode", "designView", "apply", "undoCheckpoint", "checkpoints", "brand"]
      static values = { context: String, site: String, recordId: String, recordType: String }

      connect() {
        // Right-side dock (part of the builder workspace): fill it and hide the floating FAB.
        // Without a dock (standalone) the classic floating window is appended to the body.
        this.dock = document.getElementById("CopilotDock")
        this.copilotButton = document.getElementById("copilotButton")
        if (this.dock) {
          this.windowTarget.classList.add("bc-docked")
          this.fabTarget?.classList.add("hidden")
        } else if (this.element.parentElement !== document.body) {
          document.body.appendChild(this.element)
        }
        if (this.copilotButton) {
          this._copilotToggle = () => this.toggle()
          this.copilotButton.addEventListener("click", this._copilotToggle)
        }
        this.mode = "design"
        this.history = []
        this.busy = false
        this.abortController = null
        this.requestTimer = null
        this.design = ""
        this.designHtml = ""
        this.pendingSpec = null
        this.editingSection = null
        this.checkpoints = []
        this.checkpointIndex = -1
        this.markActiveModes()
        // Delegate section clicks: Stimulus doesn't re-scan data-action on dynamically
        // inserted rows, so we bind a delegated listener on the transcript instead.
        this._sectionClick = (e) => {
          const row = e.target.closest("[data-section-row]")
          if (row) { e.preventDefault(); this.selectSection({ currentTarget: row }) }
        }
        this.transcriptTarget.addEventListener("click", this._sectionClick)
        this._checkpointClick = (e) => {
          const chip = e.target.closest("[data-checkpoint]")
          if (chip) this.restoreCheckpoint(Number(chip.dataset.checkpoint))
        }
        this.checkpointsTarget.addEventListener("click", this._checkpointClick)
      }

      disconnect() {
        this.abortController?.abort()
        clearTimeout(this.requestTimer)
        if (this.copilotButton && this._copilotToggle) this.copilotButton.removeEventListener("click", this._copilotToggle)
        if (this.transcriptTarget && this._sectionClick) this.transcriptTarget.removeEventListener("click", this._sectionClick)
        if (this.checkpointsTarget && this._checkpointClick) this.checkpointsTarget.removeEventListener("click", this._checkpointClick)
      }

      toggle(event) { this.windowTarget.classList.contains("hidden") ? this.open(event) : this.close(event) }

      open(event) {
        event && event.preventDefault()
        if (this.dock) {
          this.dock.hidden = false
          this.windowTarget.classList.remove("hidden")
          if (this.copilotButton) this.copilotButton.classList.add("is-active")
          this.promptTarget?.focus()
          return
        }
        const closed = this.windowTarget.classList.contains("hidden")
        this.windowTarget.classList.toggle("hidden", !closed)
        if (closed) this.promptTarget.focus()
      }

      close(event) {
        event && event.preventDefault()
        if (this.dock) {
          this.dock.hidden = true
          this.windowTarget.classList.add("hidden")
          if (this.copilotButton) this.copilotButton.classList.remove("is-active")
          return
        }
        this.windowTarget.classList.add("hidden")
      }

      setMode(event) {
        this.mode = event.currentTarget.dataset.mode
        this.markActiveModes()
      }

      markActiveModes() {
        this.modeTargets.forEach((b) => {
          b.classList.toggle("bc-mode-active", b.dataset.mode === this.mode)
        })
      }

      promptKeydown(event) {
        if (event.key === "Enter" && !event.shiftKey) { event.preventDefault(); this.send() }
      }

      useSuggestion(event) {
        event.preventDefault()
        this.promptTarget.value = event.currentTarget.dataset.prompt || ""
        this.promptTarget.focus()
      }

      currentHtml() {
        try { return (window.builder && window.builder.getHtml) ? window.builder.getHtml() : "" } catch { return "" }
      }

      currentStore() {
        try { return (window.builder && window.builder.getData) ? window.builder.getData() : {} } catch { return {} }
      }

      async send() {
