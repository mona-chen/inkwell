    @keyframes bc-pulse { 50% { opacity: .35; } }

    .bc-plan { border: 1px solid #e5e7eb; border-radius: 10px; background: #fff; padding: 10px 12px; }
    .bc-plan-title { font-size: 12px; font-weight: 600; color: #111827; margin-bottom: 8px; }
