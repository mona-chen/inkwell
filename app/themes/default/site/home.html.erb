<%# The default theme's front page — a premium editorial landing.
    Full-bleed page: <main> drops its gutter (full_bleed), so the hero spans edge-to-edge
    and each following section supplies its own max-w-7xl gutter. %>
<% content_for :full_bleed, true %>
<% content_for :title, Current.site.setting("tagline").presence || "Inkwell" %>

<% featured = @posts.first %>
<% rest = @posts.drop(1) %>

<!-- Hero — full-width -->
<section class="relative overflow-hidden py-20 sm:py-32">
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-[#f3ede3] via-[#faf8f5] to-[#fcfbf9]"></div>
  <div class="mx-auto max-w-4xl px-5 text-center sm:px-8">
    <p class="text-xs font-semibold uppercase tracking-[0.25em] text-indigo-600"><%= Current.site.name %></p>
    <h1 class="font-serif-display mx-auto mt-6 max-w-3xl text-5xl font-semibold leading-[1.05] tracking-tight sm:text-7xl">
      <%= Current.site.setting("tagline").presence || "Writing worth reading." %>
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-gray-600">
      Long-form stories on design, engineering, and the craft of building for the web — written to be read, not skimmed.
    </p>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a href="#latest" class="btn btn-primary btn-lg">Start reading</a>
      <a href="#newsletter" class="btn btn-secondary btn-lg">Get the newsletter</a>
    </div>
  </div>
</section>

<!-- Featured story -->
<% if featured %>
  <section class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid grid-cols-1 items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-7">
        <% img = featured.featured_image_url %>
        <%= link_to post_path(featured), class: "block group" do %>
          <div class="aspect-[16/10] w-full overflow-hidden rounded-2xl bg-[#f3ede3] shadow-sm">
            <% if img %>
              <img src="<%= img %>" alt="" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]">
            <% else %>
              <div class="flex h-full items-center justify-center font-serif-display text-2xl text-gray-400"><%= featured.title %></div>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="lg:col-span-5">
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-600">
          <%= featured.categories.map(&:name).join(" · ").presence || "Featured story" %>
        </p>
        <h2 class="font-serif-display mt-4 text-3xl font-semibold leading-[1.15] tracking-tight sm:text-4xl">
          <%= link_to featured.title, post_path(featured), class: "transition-colors hover:text-indigo-700" %>
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-gray-600">
          <%= featured.excerpt.presence || truncate(featured.content_blocks.find { |b| b["type"] == "paragraph" }&.dig("data", "text").to_s, length: 200) %>
        </p>
        <div class="mt-6 flex items-center gap-3">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-[#1a1a1a] text-sm font-semibold text-white">
            <%= featured.author.name.first.upcase %>
          </span>
          <div class="text-sm">
            <div class="font-medium text-gray-800"><%= featured.author.name %></div>
            <div class="text-gray-500"><%= featured.published_at&.strftime("%B %-d, %Y") %></div>
          </div>
        </div>
        <div class="mt-8">
          <%= link_to post_path(featured), class: "btn btn-primary" do %>
            Read the story
            <span aria-hidden="true">→</span>
          <% end %>
        </div>
      </div>
    </div>
  </section>
<% end %>

<!-- Latest writing -->
<section id="latest" class="mx-auto mt-24 max-w-7xl px-5 sm:px-8">
  <div class="section-head">
    <div>
      <div class="kicker">Fresh from the desk</div>
      <h2>Latest writing</h2>
    </div>
    <div class="rule"></div>
  </div>

  <% if rest.any? %>
    <div class="grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      <% rest.each do |post| %>
        <article class="group flex flex-col">
          <% img = post.featured_image_url %>
          <% if img %>
            <%= link_to post_path(post) do %>
              <div class="mb-5 aspect-[16/10] w-full overflow-hidden rounded-xl bg-[#f3ede3]">
                <img src="<%= img %>" alt="" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03]">
              </div>
            <% end %>
          <% end %>
          <div class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gray-400">
            <%= post.categories.map(&:name).join(" · ").presence || "Journal" %>
          </div>
          <h3 class="font-serif-display mt-2 text-xl font-semibold leading-snug tracking-tight">
            <%= link_to post.title, post_path(post), class: "transition-colors group-hover:text-indigo-700" %>
          </h3>
          <p class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-gray-600">
            <%= post.excerpt.presence || truncate(post.content_blocks.find { |b| b["type"] == "paragraph" }&.dig("data", "text").to_s, length: 120) %>
          </p>
          <div class="mt-5 flex items-center gap-2 text-xs text-gray-400">
            <span><%= post.author.name %></span>
            <span class="text-gray-300">·</span>
            <span><%= post.published_at&.strftime("%b %-d, %Y") %></span>
          </div>
        </article>
      <% end %>
    </div>
  <% end %>
</section>

<!-- Newsletter CTA -->
<section id="newsletter" class="mx-auto mt-24 max-w-5xl px-5 sm:px-8">
  <div class="relative overflow-hidden rounded-3xl bg-[#1a1a1a] px-8 py-16 text-center text-white sm:px-16">
    <div class="absolute -right-24 -top-24 h-64 w-64 rounded-full bg-indigo-500/20 blur-3xl"></div>
    <div class="absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-indigo-500/10 blur-3xl"></div>
    <div class="relative">
      <h2 class="font-serif-display text-3xl font-semibold tracking-tight sm:text-4xl">Never miss a story</h2>
      <p class="mx-auto mt-4 max-w-md text-sm leading-relaxed text-white/70">
        Join the newsletter for new writing on design and engineering, delivered a few times a month. No spam, unsubscribe anytime.
      </p>
      <%= form_with url: "/plugins/newsletter/subscribers", method: :post, local: true, class: "mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row" do %>
        <input type="email" name="email" placeholder="you@example.com" required
               class="flex-1 rounded-full border border-white/20 bg-white/10 px-5 py-3 text-sm text-white placeholder:text-white/50 focus:border-white focus:outline-none focus:ring-2 focus:ring-white/30">
        <button type="submit" class="btn btn-primary btn-lg bg-white text-[#1a1a1a] hover:bg-[#f3f0ea]">Subscribe</button>
      <% end %>
    </div>
  </div>
</section>
