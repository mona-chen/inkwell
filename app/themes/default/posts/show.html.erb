<%# Sidebar widget area: when the admin has placed sidebar widgets, the post reads in a
    two-column layout with the widgets on the right (max-w-3xl article preserved). %>
<% sidebar_widgets = render_widget_area(:sidebar) %>
<div class="mx-auto max-w-7xl <%= sidebar_widgets ? "lg:grid lg:grid-cols-[1fr_300px] lg:gap-12" : "" %>">
<article class="mx-auto max-w-3xl <%= sidebar_widgets ? "lg:mx-0" : "" %>">
  <% crumb_crumbs = [{ label: "Posts", path: posts_path }] %>
  <% if (cat = @post.categories.first) %><% crumb_crumbs << { label: cat.name, path: posts_path(category: cat.slug) } %><% end %>
  <% crumb_crumbs << { label: @post.title, path: nil } %>
  <%= render "partials/breadcrumbs", crumbs: crumb_crumbs %>

  <header class="text-center">
    <% if @post.categories.any? %>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-indigo-600">
        <%= @post.categories.map { |c| link_to(c.name, posts_path(category: c.slug), class: "hover:underline") }.join(" · ").html_safe %>
      </p>
    <% end %>
    <h1 class="font-serif-display mt-5 text-4xl font-semibold leading-[1.1] tracking-tight sm:text-5xl">
      <%= @post.title %>
    </h1>
    <div class="mt-6 flex items-center justify-center gap-3 text-sm text-gray-500">
      <span class="flex h-9 w-9 items-center justify-center rounded-full bg-[#1a1a1a] text-xs font-semibold text-white">
        <%= @post.author.name.first.upcase %>
      </span>
      <span class="font-medium text-gray-700">
        <%= link_to @post.author.name, author_path(@post.author), class: "transition-colors hover:text-indigo-700" %>
      </span>
      <span class="text-gray-300">·</span>
      <time datetime="<%= @post.published_at&.iso8601 %>"><%= @post.published_at&.strftime("%B %-d, %Y") %></time>
      <span class="text-gray-300">·</span>
      <span><%= @post.reading_time %> min read</span>
    </div>
  </header>

  <% if @post.excerpt.present? %>
    <p class="mx-auto mt-10 max-w-2xl text-center font-serif-display text-xl italic leading-relaxed text-gray-600">
      <%= @post.excerpt %>
    </p>
  <% end %>

  <div class="mt-12 h-px w-full bg-[#e8e4dc]"></div>

  <%# Featured image hero %>
  <% featured_img = @post.featured_image&.url %>
  <% featured_img ||= @post.content_blocks.find { |b| b["type"] == "image" }&.dig("data", "url") %>
  <% if featured_img %>
    <div class="mx-auto mt-12 max-w-3xl overflow-hidden rounded-2xl bg-[#f3ede3] shadow-sm">
      <img src="<%= featured_img %>" alt="<%= @post.featured_image&.alt_text || @post.featured_image_alt %>" class="aspect-[16/9] w-full object-cover">
    </div>
  <% end %>

  <div class="prose-content mt-10 text-[17px] leading-[1.85] text-[#2a2a2a]">
    <%= BlockRenderer.render(@post.content_blocks, self) %>
  </div>

  <% if @post.tags.any? %>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-2">
      <% @post.tags.each do |tag| %>
        <%= link_to "##{tag.name}", tag_posts_path(tag.slug), class: "rounded-full border border-[#e8e4dc] px-3 py-1 text-xs text-gray-500 transition-colors hover:border-indigo-300 hover:text-indigo-600" %>
      <% end %>
    </div>
  <% end %>

  <%# Share row %>
  <div class="mt-12 flex items-center justify-center gap-2 border-y border-[#e8e4dc] py-6">
    <span class="mr-2 text-sm text-gray-500">Share:</span>
    <a href="https://twitter.com/intent/tweet?url=<%= post_url(@post) %>&text=<%= @post.title %>" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">X</a>
    <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= post_url(@post) %>" target="_blank" rel="noopener" class="btn btn-secondary btn-sm">LinkedIn</a>
    <a href="mailto:?subject=<%= @post.title %>&body=<%= post_url(@post) %>" class="btn btn-secondary btn-sm">Email</a>
    <a href="<%= root_path %>/feed.xml" class="btn btn-ghost btn-sm">RSS</a>
  </div>

  <%= render "site/comments", post: @post %>
</article>

<% if sidebar_widgets %>
  <aside class="mt-10 space-y-4 lg:mt-0">
    <%= sidebar_widgets %>
  </aside>
<% end %>
</div>

<%# Prev / next %>
<nav class="mx-auto mt-16 max-w-3xl grid grid-cols-1 gap-4 sm:grid-cols-2" aria-label="Post navigation">
  <% if @prev_post %>
    <%= link_to post_path(@prev_post), class: "group rounded-xl border border-[#e8e4dc] p-5 transition-colors hover:bg-[#f6f4ef]" do %>
      <div class="text-xs font-semibold uppercase tracking-widest text-gray-400">← Previous</div>
      <div class="font-serif-display mt-1.5 text-lg font-semibold leading-snug transition-colors group-hover:text-indigo-700"><%= @prev_post.title %></div>
    <% end %>
  <% else %>
    <div></div>
  <% end %>
  <% if @next_post %>
    <%= link_to post_path(@next_post), class: "group rounded-xl border border-[#e8e4dc] p-5 text-right transition-colors hover:bg-[#f6f4ef]" do %>
      <div class="text-xs font-semibold uppercase tracking-widest text-gray-400">Next →</div>
      <div class="font-serif-display mt-1.5 text-lg font-semibold leading-snug transition-colors group-hover:text-indigo-700"><%= @next_post.title %></div>
    <% end %>
  <% end %>
</nav>

<% if @related_posts.any? %>
  <section class="mx-auto mt-20 max-w-3xl">
    <div class="section-head">
      <h2>Keep reading</h2>
      <div class="rule"></div>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      <% @related_posts.each do |post| %>
        <a href="<%= post_path(post) %>" class="group rounded-xl border border-[#e8e4dc] p-4 transition-colors hover:bg-[#f6f4ef]">
          <div class="text-[11px] font-semibold uppercase tracking-widest text-gray-400"><%= post.categories.map(&:name).first.presence || "Journal" %></div>
          <div class="font-serif-display mt-1.5 text-base font-semibold leading-snug transition-colors group-hover:text-indigo-700"><%= post.title %></div>
          <div class="mt-2 text-xs text-gray-400"><%= post.reading_time %> min read</div>
        </a>
      <% end %>
    </div>
  </section>
<% end %>
