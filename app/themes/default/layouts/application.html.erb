<% page_content = yield %>
<!doctype html>
<html lang="en">
<head><%= render "public_theme/head" %></head>
<body class="publication-body" data-public-theme="default">
  <% full_bleed = content_for?(:full_bleed) %>
  <% hide_chrome = content_for?(:hide_chrome) %>
  <a href="#publication-main" class="publication-skip">Skip to content</a>
  <%= render "site/admin_bar" unless hide_chrome %>
  <% unless hide_chrome %>
    <header class="publication-header">
      <div class="publication-header-inner">
        <%= link_to public_theme_navigation_url(main_app.root_path), class: "publication-brand" do %>
          <% if (logo = Current.site.logo_item) %><img src="<%= logo.url %>" alt="<%= Current.site.name %>"><% else %><%= Current.site.name %><% end %>
        <% end %>
        <div class="publication-desktop-nav"><%= render "public_theme/navigation", location: "header" %></div>
        <details class="publication-mobile-menu">
          <summary>Menu <span aria-hidden="true">+</span></summary>
          <%= render "public_theme/navigation", location: "header" %>
        </details>
      </div>
    </header>
  <% end %>
  <main id="publication-main" tabindex="-1" class="publication-main <%= full_bleed ? 'is-full-bleed py-0' : 'publication-container' %>"><%= page_content %></main>
  <% unless hide_chrome %>
    <footer class="publication-footer publication-container">
      <div class="publication-footer-top">
        <div><%= link_to Current.site.name, public_theme_navigation_url(main_app.root_path), class: "publication-brand" %><p><%= Current.site.setting("tagline").presence || "Independent writing. A considered perspective." %></p></div>
        <%= render "public_theme/navigation", location: "footer" %>
      </div>
      <% if (widgets = render_widget_area(:footer_1)) %><div class="publication-footer-widgets"><%= widgets %></div><% end %>
      <% if (widgets = render_widget_area(:footer_2)) %><div class="publication-footer-widgets"><%= widgets %></div><% end %>
      <div class="publication-colophon"><span>© <%= Time.current.year %> <%= Current.site.name %></span><a href="/feed.xml">Follow via RSS ↗</a></div>
    </footer>
  <% end %>
  <%= raw Inkwell::Hooks.filter(:body_scripts, "", site: Current.site) %>
</body>
</html>
