<% heading = (@category || @tag)&.name.presence || (params[:q].present? ? "Search results" : "Journal") %>
<% content_for :title, "#{heading} — #{Current.site.name}" %>
<header class="publication-archive-head"><span class="publication-eyebrow">The archive</span><h1 class="publication-title"><%= heading %></h1><p><%= params[:q].present? ? "Results for “#{params[:q]}”" : "All the writing, in one place." %></p></header>
<%= form_with url: main_app.posts_path, method: :get, class: "publication-search" do |form| %>
  <%= form.label :q, "Search the journal", class: "publication-eyebrow" %>
  <div><%= form.search_field :q, value: params[:q], placeholder: "Search articles…" %><%= form.submit "Search" %></div>
<% end %>
<%= render "public_theme/post_list", posts: @posts %>
<%= render "public_theme/pagination", posts: @posts %>
