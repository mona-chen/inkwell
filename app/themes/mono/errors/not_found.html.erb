<% content_for :title, "Not found" %>
<section class="py-16">
  <p class="text-xs text-green-700 mb-2">// 404: no such path</p>
  <h1 class="text-lg font-bold mb-3"># path not found</h1>
  <p class="text-green-400 mb-6">
    The link may be broken, the post may have been unpublished, or the page never existed.
  </p>
  <%= link_to "cd ~", root_path, class: "text-green-300 underline underline-offset-2 hover:text-green-100" %>
</section>
