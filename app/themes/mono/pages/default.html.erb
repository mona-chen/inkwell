<% content_for :title, page.title %>
<article class="publication-page">
  <% unless page.hide_title? %>
    <header class="publication-page-head"><span class="publication-eyebrow"><%= Current.site.name %></span><h1 class="publication-title"><%= page.title %></h1></header>
  <% end %>
  <div class="<%= page.content_blocks.any? { |block| block['type'] == 'page_builder' } ? 'publication-native-builder' : 'publication-prose' %>"><%= BlockRenderer.render(page.content_blocks, self) %></div>
</article>
