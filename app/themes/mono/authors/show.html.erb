<% content_for :title, @author.name %>
<header class="publication-author-head">
  <span class="publication-eyebrow">Contributor</span>
  <h1 class="publication-title"><%= @author.name %></h1>
  <p><%= @author.bio.presence || "Writing for #{Current.site.name}." %></p>
  <span class="publication-meta"><%= pluralize(@posts.total_count, "article") %></span>
</header>
<%= render "public_theme/post_list", posts: @posts %>
<%= render "public_theme/pagination", posts: @posts %>
