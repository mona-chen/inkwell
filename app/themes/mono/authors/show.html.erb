<% content_for :title, @author.name %>
<div>
  <p class="text-xs text-green-700 mb-1">$ whoami</p>
  <h1 class="text-lg font-bold mb-2"><%= @author.name %></h1>
  <p class="text-green-300 mb-8">
    <%= @author.bio.presence || "#{@author.name} writes for #{Current.site.name}." %>
  </p>

  <p class="text-xs text-green-700 mb-4">$ ls posts --author=<%= @author.to_param %></p>

  <% if @posts.empty? %>
    <p class="text-green-700">// nothing published yet</p>
  <% else %>
    <div class="space-y-8">
      <% @posts.each do |post| %>
        <article class="border-b border-green-900 pb-6">
          <h2 class="text-base font-bold">
            <%= link_to "> #{post.title}", post_path(post), class: "hover:text-green-200" %>
          </h2>
          <p class="text-xs text-green-700 mt-1">
            <%= post.published_at&.strftime("%Y-%m-%d") %>
            <% if post.categories.any? %> · <%= post.categories.map(&:name).join(", ") %><% end %>
          </p>
          <p class="text-green-400 mt-2">
            <%= post.excerpt.presence || truncate(post.content_blocks.find { |b| b["type"] == "paragraph" }&.dig("data", "text").to_s, length: 140) %>
          </p>
        </article>
      <% end %>
    </div>

    <% if @posts.total_pages > 1 %>
      <nav class="mt-10 flex items-center justify-between text-xs text-green-700" aria-label="Pagination">
        <% if @posts.prev_page %>
          <%= link_to "← newer", url_for(page: @posts.prev_page), class: "hover:text-green-300" %>
        <% else %>
          <span></span>
        <% end %>
        <span><%= @posts.current_page %>/<%= @posts.total_pages %></span>
        <% if @posts.next_page %>
          <%= link_to "older →", url_for(page: @posts.next_page), class: "hover:text-green-300" %>
        <% else %>
          <span></span>
        <% end %>
      </nav>
    <% end %>
  <% end %>
</div>
