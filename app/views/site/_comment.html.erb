<div class="text-sm">
  <div class="flex items-center gap-2">
    <span class="font-medium text-gray-800"><%= comment.author_name %></span>
    <span class="text-xs text-gray-400"><%= comment.created_at.strftime("%b %-d, %Y") %></span>
  </div>
  <p class="mt-1.5 leading-relaxed text-gray-700"><%= comment.body %></p>
  <% if comment.children.approved.any? %>
    <div class="mt-4 ml-4 space-y-4 border-l-2 border-[#e8e4dc] pl-5">
      <% comment.children.approved.each { |reply| render "site/comment", comment: reply } %>
    </div>
  <% end %>
</div>
