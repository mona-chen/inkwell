<%= form_with model: [post, Comment.new], local: true, class: "mt-10 space-y-3" do |f| %>
  <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
    <%= f.text_field :guest_name, placeholder: "Name", class: "rounded-lg border border-[#ddd8cf] bg-white px-3.5 py-2.5 text-sm placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
    <%= f.text_field :guest_email, placeholder: "Email (not published)", class: "rounded-lg border border-[#ddd8cf] bg-white px-3.5 py-2.5 text-sm placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
  </div>
  <%= f.text_area :body, placeholder: "Add a comment…", rows: 4, class: "w-full rounded-lg border border-[#ddd8cf] bg-white px-3.5 py-2.5 text-sm placeholder:text-gray-400 focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-200" %>
  <%= f.submit "Post comment", class: "rounded-full bg-[#1a1a1a] px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-black" %>
<% end %>
