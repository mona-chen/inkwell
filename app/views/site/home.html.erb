<div class="space-y-10">
  <% @posts.each do |post| %>
    <article>
      <h2 class="text-2xl font-bold mb-2"><%= link_to post.title, post_path(post) %></h2>
      <p class="text-sm text-gray-500 mb-3"><%= post.published_at&.strftime("%B %-d, %Y") %></p>
      <p class="text-gray-600"><%= post.excerpt.presence || truncate(post.content_blocks.find { |b| b["type"] == "paragraph" }&.dig("data", "text").to_s, length: 200) %></p>
    </article>
  <% end %>
</div>
