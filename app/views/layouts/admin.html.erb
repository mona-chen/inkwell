<%# Admin layout: renders the Nitro Kit AppShell through the Phlex Admin::Layout component.
    Page content (ERB) is yielded into the shell's main region. %>
<%= render Admin::Layout.new(title: (content_for?(:title) ? yield(:title) : "Dashboard"), user: (current_user if defined?(current_user))) do %>
  <% if notice %><div class="mb-6 px-4 py-3 bg-green-50 text-green-800 rounded-lg text-sm border border-green-100"><%= notice %></div><% end %>
  <% if alert %><div class="mb-6 px-4 py-3 bg-red-50 text-red-800 rounded-lg text-sm border border-red-100"><%= alert %></div><% end %>
  <%= yield %>
<% end %>
