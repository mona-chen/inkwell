<%# Admin layout: renders the Nitro Kit AppShell through the Phlex Admin::Layout component.
    Page content (ERB) is yielded into the shell's main region. %>
<%= render Admin::Layout.new(title: (content_for?(:title) ? yield(:title) : "Home"), user: (current_user if defined?(current_user))) do %>
  <% if notice %><div class="mb-6 px-4 py-3 bg-success/10 text-success rounded-lg text-sm border border-success/30"><%= notice %></div><% end %>
  <% if alert %><div class="mb-6 px-4 py-3 bg-danger/10 text-danger rounded-lg text-sm border border-danger/30"><%= alert %></div><% end %>
  <%= yield %>
<% end %>
