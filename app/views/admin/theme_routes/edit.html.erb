<% content_for :title, @route.display_title %>
<div class="mb-6 flex flex-wrap items-start justify-between gap-4">
  <div>
    <div class="mb-2 flex items-center gap-2">
      <span class="rounded-md bg-primary/10 px-2 py-1 text-xs font-semibold uppercase tracking-wide text-primary">Theme</span>
      <span class="text-sm text-muted-foreground"><%= @route.theme_release_id %> · <%= @route.route_key %></span>
    </div>
    <h1 class="text-2xl font-semibold text-foreground"><%= @route.display_title %></h1>
    <p class="mt-1 text-sm text-muted-foreground"><code><%= @route.path %></code></p>
  </div>
  <div class="flex flex-wrap gap-2">
    <%= link_to "Preview", preview_admin_theme_route_path(@route), class: "rounded-lg border border-border px-3 py-2 text-sm font-medium text-foreground hover:bg-muted" %>
    <% if @route.published? %>
      <%= button_to "Move to draft", unpublish_admin_theme_route_path(@route), method: :post, class: "rounded-lg border border-border px-3 py-2 text-sm font-medium text-foreground hover:bg-muted" %>
    <% else %>
      <%= button_to "Publish", publish_admin_theme_route_path(@route), method: :post, class: "rounded-lg bg-primary px-3 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90" %>
    <% end %>
  </div>
</div>

<% if @route.errors.any? %>
  <div role="alert" class="mb-4 text-sm text-destructive">
    <strong>Check these details:</strong>
    <ul><% @route.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
  </div>
<% end %>

<%= form_with model: [:admin, @route], class: "grid gap-6 lg:grid-cols-[minmax(0,2fr)_minmax(18rem,1fr)]" do |f| %>
  <%= hidden_field_tag "theme_route[revision]", @route.revision %>
  <div class="space-y-5 rounded-xl bg-card p-5 ring-1 ring-border/60">
    <div>
      <%= f.label :title_override, "Title override", class: "mb-1 block text-sm font-medium text-foreground" %>
      <%= f.text_field :title_override, class: "w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :seo_title, "SEO title", class: "mb-1 block text-sm font-medium text-foreground" %>
      <%= f.text_field :seo_title, class: "w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :meta_description, "Meta description", class: "mb-1 block text-sm font-medium text-foreground" %>
      <%= f.text_area :meta_description, rows: 4, class: "w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :canonical_url, "Canonical URL", class: "mb-1 block text-sm font-medium text-foreground" %>
      <%= f.text_field :canonical_url, class: "w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" %>
    </div>
    <div>
      <%= f.label :social_image_id, "Social image (media ID)", class: "mb-1 block text-sm font-medium text-foreground" %>
      <%= f.number_field :social_image_id, class: "w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" %>
      <% if @route.social_image %><p class="mt-1 text-xs text-muted-foreground"><%= @route.social_image.url %></p><% end %>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :robots, "Robots", class: "mb-1 block text-sm font-medium text-foreground" %>
        <%= f.select :robots, [["Index, follow", "index, follow"], ["No index, follow", "noindex, follow"], ["Index, nofollow", "index, nofollow"], ["No index, nofollow", "noindex, nofollow"]], {}, class: "w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" %>
      </div>
      <div>
        <%= f.label :status, "Status", class: "mb-1 block text-sm font-medium text-foreground" %>
        <%= f.select :status, ThemeRoute::STATUSES, {}, class: "w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" %>
      </div>
    </div>
    <div>
      <%= f.label :schema_json, "JSON-LD schema (JSON)", class: "mb-1 block text-sm font-medium text-foreground" %>
      <%= f.text_area :schema_json, value: (@route.schema_json.presence || {}).to_json, rows: 6, class: "w-full rounded-lg border border-border bg-background px-3 py-2 font-mono text-xs" %>
    </div>
    <div>
      <%= f.label :draft_data, "Draft data (JSON)", class: "mb-1 block text-sm font-medium text-foreground" %>
      <%= f.text_area :draft_data, value: @route.draft_data.to_json, rows: 4, class: "w-full rounded-lg border border-border bg-background px-3 py-2 font-mono text-xs" %>
    </div>
    <div>
      <label class="flex items-center gap-2 text-sm font-medium text-foreground">
        <%= f.check_box :sitemap, class: "h-4 w-4 accent-primary" %> Include in sitemap
      </label>
    </div>
    <%= f.submit "Save theme route", class: "rounded-lg bg-primary px-4 py-2 text-sm font-medium text-primary-foreground hover:bg-primary/90" %>
  </div>

  <aside class="space-y-5">
    <section class="rounded-xl bg-card p-5 ring-1 ring-border/60">
      <h2 class="mb-3 text-sm font-semibold text-foreground">Navigation</h2>
      <div class="space-y-3">
        <div>
          <%= f.label :navigation_location, "Menu location", class: "mb-1 block text-xs font-medium text-muted-foreground" %>
          <%= f.select :navigation_location, [["None", nil], ["Header", "header"], ["Footer", "footer"]], {}, class: "w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" %>
        </div>
        <div>
          <%= f.label :navigation_label, "Label", class: "mb-1 block text-xs font-medium text-muted-foreground" %>
          <%= f.text_field :navigation_label, class: "w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" %>
        </div>
        <div>
          <%= f.label :navigation_position, "Position", class: "mb-1 block text-xs font-medium text-muted-foreground" %>
          <%= f.number_field :navigation_position, class: "w-full rounded-lg border border-border bg-background px-3 py-2 text-sm" %>
        </div>
      </div>
    </section>

    <section class="rounded-xl bg-card p-5 ring-1 ring-border/60">
      <h2 class="mb-3 text-sm font-semibold text-foreground">Revision history</h2>
      <% if @route.revisions.empty? %>
        <p class="text-sm text-muted-foreground">No revisions yet.</p>
      <% else %>
        <ul class="space-y-2">
          <% @route.revisions.each do |revision| %>
            <li class="flex items-center justify-between gap-3 text-sm">
              <span>#<%= revision.revision_number %> · <%= l revision.created_at, format: :short %></span>
              <%= button_to "Restore", restore_admin_theme_route_path(@route, revision_id: revision.id), method: :post, class: "text-xs font-medium text-primary" %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </section>
  </aside>
<% end %>
