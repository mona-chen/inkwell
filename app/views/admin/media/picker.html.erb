<%# Media picker grid — rendered inside a Turbo Frame dialog in the block editor.
    Must be wrapped in <turbo-frame> matching the requesting frame's id (Turbo sends it in
    the Turbo-Frame header), otherwise Turbo reports "Content missing". %>
<turbo-frame id="<%= @picker_frame %>">
  <div id="media_picker_grid" class="grid grid-cols-3 sm:grid-cols-4 gap-3 p-4">
    <% @media_items.each do |item| %>
      <%= render Admin::MediaPickerItem.new(item: item) %>
    <% end %>
  </div>

  <% if @media_items.empty? %>
    <div class="px-4 pb-4 text-center text-sm text-muted-foreground">
      No media yet — upload files in the Media library.
    </div>
  <% end %>
</turbo-frame>

