<div class="bg-white rounded-lg shadow-sm p-4 space-y-4">
  <div>
    <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Status</label>
    <%= f.select :status, %w[draft published scheduled], {}, class: "mt-1 w-full text-sm border rounded px-2 py-1.5",
        data: { status_select: true } %>
  </div>

  <div data-schedule-field class="<%= post.status == "scheduled" ? "" : "hidden" %>">
    <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Schedule for</label>
    <%= f.datetime_local_field :scheduled_for,
        value: post.scheduled_for&.strftime("%Y-%m-%dT%H:%M"),
        class: "mt-1 w-full text-sm border rounded px-2 py-1.5" %>
  </div>

  <div data-controller="media-picker">
    <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Featured image</label>
    <div class="mt-1.5 flex items-center gap-3">
      <div data-media-picker-target="preview" class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-gray-200 bg-gray-50">
        <% if post.featured_image %>
          <img src="<%= post.featured_image.url %>" class="h-full w-full object-cover" alt="">
        <% else %>
          <span class="text-xs text-gray-400">None</span>
        <% end %>
      </div>
      <div class="flex-1 space-y-1.5">
        <input type="hidden" name="post[featured_image_id]" value="<%= post.featured_image_id %>" data-media-picker-target="urlField">
        <button type="button" data-action="media-picker#open" class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 hover:text-gray-900">
          Choose image
        </button>
        <% if post.featured_image %>
          <button type="button" data-action="click->media-picker#clear" class="block text-xs text-gray-400 hover:text-red-600">Remove</button>
        <% end %>
      </div>
    </div>
  </div>

  <div>
    <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Excerpt</label>
    <%= f.text_area :excerpt, rows: 3, class: "mt-1 w-full text-sm border rounded px-2 py-1.5" %>
  </div>

  <div>
    <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Categories</label>
    <div class="mt-1 space-y-1 max-h-28 overflow-y-auto">
      <% Term.categories.each do |category| %>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="post[category_ids][]" value="<%= category.id %>"
                 <%= "checked" if post.categories.include?(category) %> class="rounded">
          <%= category.name %>
        </label>
      <% end %>
    </div>
  </div>

  <div>
    <label class="text-xs font-medium text-gray-500 uppercase tracking-wide">Tags</label>
    <div class="mt-1 space-y-1 max-h-28 overflow-y-auto">
      <% Term.tags.each do |tag| %>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="post[tag_ids][]" value="<%= tag.id %>"
                 <%= "checked" if post.tags.include?(tag) %> class="rounded">
          <%= tag.name %>
        </label>
      <% end %>
    </div>
  </div>

  <%= f.submit "Save draft", name: "save_draft",
      class: "w-full bg-white border border-gray-200 text-gray-700 rounded-lg py-2 text-sm font-medium hover:bg-gray-50 active:scale-[0.98] transition-colors cursor-pointer" %>

  <% unless post.new_record? %>
    <button type="submit" formaction="<%= publish_admin_post_path(post) %>" formmethod="post"
            class="w-full bg-gray-900 text-white rounded-lg py-2 text-sm font-medium shadow-sm hover:bg-black active:scale-[0.98] transition-colors cursor-pointer">
      Publish
    </button>
  <% end %>

  <% unless post.new_record? %>
    <%= link_to "View revision history", admin_post_revisions_path(post), class: "block text-center text-sm text-gray-500 hover:text-gray-900" %>
  <% end %>
</div>

<%# Featured-image picker dialog %>
<dialog data-media-picker-target="dialog" data-action="click->media-picker#backdropClose"
        class="m-auto w-[42rem] max-w-full rounded-2xl border border-gray-200 bg-white p-0 shadow-2xl backdrop:bg-black/40">
  <div class="flex items-center justify-between border-b border-gray-100 px-4 py-3">
    <h3 class="text-sm font-semibold text-gray-900">Choose a featured image</h3>
    <button type="button" data-action="media-picker#close" class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-700" aria-label="Close">✕</button>
  </div>
  <div class="max-h-[60vh] overflow-y-auto">
    <turbo-frame id="featured-image-frame" data-media-picker-target="frame"
                 data-src="<%= admin_media_path(picker: 1) %>">
      <div class="p-4 text-center text-sm text-gray-400">Loading…</div>
    </turbo-frame>
  </div>
</dialog>

<script>
  (function () {
    const select = document.querySelector('[data-status-select]');
    const field = document.querySelector('[data-schedule-field]');
    if (!select || !field) return;
    const sync = () => field.classList.toggle('hidden', select.value !== 'scheduled');
    select.addEventListener('change', sync);
  })();
</script>
