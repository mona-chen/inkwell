<div class="bg-background rounded-lg shadow-sm p-4 space-y-4">
  <div>
    <label class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Status</label>
    <%= f.select :status, %w[draft published scheduled], {}, class: "mt-1 w-full text-sm border rounded px-2 py-1.5",
        data: { status_select: true } %>
  </div>

  <div data-schedule-field class="<%= post.status == "scheduled" ? "" : "hidden" %>">
    <label class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Schedule for</label>
    <%= f.datetime_local_field :scheduled_for,
        value: post.scheduled_for&.strftime("%Y-%m-%dT%H:%M"),
        class: "mt-1 w-full text-sm border rounded px-2 py-1.5" %>
  </div>

  <div data-controller="media-picker">
    <label class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Featured image</label>
    <div class="mt-1.5 flex items-center gap-3">
      <div data-media-picker-target="preview" class="flex h-20 w-20 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-border bg-muted">
        <% if post.featured_image %>
          <img src="<%= post.featured_image.url %>" class="h-full w-full object-cover" alt="">
        <% else %>
          <span class="text-xs text-muted-foreground">None</span>
        <% end %>
      </div>
      <div class="flex-1 space-y-1.5">
        <input type="hidden" name="post[featured_image_id]" value="<%= post.featured_image_id %>" data-media-picker-target="urlField">
        <button type="button" data-action="media-picker#open" class="inline-flex items-center gap-1.5 rounded-lg border border-border px-3 py-1.5 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground">
          Choose image
        </button>
        <% if post.featured_image %>
          <button type="button" data-action="click->media-picker#clear" class="block text-xs text-muted-foreground hover:text-danger">Remove</button>
        <% end %>
      </div>
    </div>
  </div>

  <div>
    <label class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Excerpt</label>
    <%= f.text_area :excerpt, rows: 3, class: "mt-1 w-full text-sm border border-border rounded px-2 py-1.5 bg-background text-foreground" %>
  </div>

  <div class="rounded-lg border border-border bg-muted/30 p-3 space-y-3">
    <h3 class="text-xs font-semibold text-foreground">SEO</h3>
    <div>
      <label class="text-xs font-medium text-muted-foreground">SEO Title</label>
      <p class="text-[10px] text-muted-foreground/60 mb-1">Override the page title for search engines.</p>
      <%= f.text_field :seo_title, placeholder: post.title, class: "mt-0.5 w-full text-sm border border-border rounded px-2 py-1.5 bg-background text-foreground placeholder:text-muted-foreground" %>
    </div>
    <div>
      <label class="text-xs font-medium text-muted-foreground">Meta Description</label>
      <p class="text-[10px] text-muted-foreground/60 mb-1">155 characters recommended for search snippets.</p>
      <%= f.text_area :seo_description, rows: 2, placeholder: "Auto-generated from content if left empty", class: "w-full text-sm border border-border rounded px-2 py-1.5 bg-background text-foreground placeholder:text-muted-foreground resize-none" %>
    </div>
    <div>
      <label class="text-xs font-medium text-muted-foreground">Focus Keyword</label>
      <%= f.text_field :seo_focus_keyword, placeholder: "e.g. customer support platforms", class: "mt-0.5 w-full text-sm border border-border rounded px-2 py-1.5 bg-background text-foreground placeholder:text-muted-foreground" %>
    </div>
    <div class="flex items-center gap-4">
      <label class="flex items-center gap-1.5 text-xs text-muted-foreground">
        <%= f.check_box :noindex, class: "rounded accent-primary" %> Noindex
      </label>
      <label class="flex items-center gap-1.5 text-xs text-muted-foreground">
        <%= f.check_box :nofollow, class: "rounded accent-primary" %> Nofollow
      </label>
    </div>
  </div>

  <div>
    <label class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Categories</label>
    <div class="mt-1 space-y-1 max-h-28 overflow-y-auto">
      <% Term.categories.each do |category| %>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="post[category_ids][]" value="<%= category.id %>"
                 <%= "checked" if post.categories.include?(category) %> class="accent-current">
          <%= category.name %>
        </label>
      <% end %>
    </div>
  </div>

  <div>
    <label class="text-xs font-medium text-muted-foreground uppercase tracking-wide">Tags</label>
    <div class="mt-1 space-y-1 max-h-28 overflow-y-auto">
      <% Term.tags.each do |tag| %>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" name="post[tag_ids][]" value="<%= tag.id %>"
                 <%= "checked" if post.tags.include?(tag) %> class="accent-current">
          <%= tag.name %>
        </label>
      <% end %>
    </div>
  </div>

  <%= f.submit post.status == "published" ? "Update" : "Save draft", name: "save_draft",
      class: "w-full bg-background border border-border text-muted-foreground rounded-lg py-2 text-sm font-medium hover:bg-muted active:scale-[0.98] transition-colors cursor-pointer" %>

  <% unless post.new_record? %>
    <button type="submit" formaction="<%= publish_admin_post_path(post) %>" formmethod="post"
            class="w-full bg-canvas text-white rounded-lg py-2 text-sm font-medium shadow-sm hover:bg-foreground active:scale-[0.98] transition-colors cursor-pointer">
      Publish
    </button>
  <% end %>

  <% unless post.new_record? %>
    <%= link_to "View revision history", admin_post_revisions_path(post), class: "block text-center text-sm text-muted-foreground hover:text-foreground" %>
  <% end %>
</div>

<%# Featured-image picker dialog %>
<dialog data-media-picker-target="dialog" data-action="click->media-picker#backdropClose"
        class="m-auto w-[42rem] max-w-full rounded-2xl border border-border bg-background p-0 shadow-2xl backdrop:bg-black/40">
  <div class="flex items-center justify-between border-b border-border px-4 py-3">
    <h3 class="text-sm font-semibold text-foreground">Choose a featured image</h3>
    <button type="button" data-action="media-picker#close" class="rounded-md p-1 text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Close">✕</button>
  </div>
  <div class="max-h-[60vh] overflow-y-auto">
    <turbo-frame id="featured-image-frame" data-media-picker-target="frame"
                 data-src="<%= admin_media_path(picker: 1) %>">
      <div class="p-4 text-center text-sm text-muted-foreground">Loading…</div>
    </turbo-frame>
  </div>
</dialog>

<script>
  (function () {
    const select = document.querySelector('[data-status-select]');
    const field = document.querySelector('[data-schedule-field]');
    if (!select || !field) return;
    const sync = () => field.classList.toggle('hidden', select.value !== 'scheduled');
    select.addEventListener('change', sync);
  })();
</script>
