<%# Post inspector sidebar — state-first, not form-first. %>
<%# Sections are collapsed by default; interaction reveals configuration. %>

<%# ── Status ─────────────────────────────────────────────────────── %>
<div class="mb-4">
  <div class="flex items-center gap-2">
    <span class="inline-flex items-center gap-1.5 text-sm font-medium">
      <% if post.status == "published" %>
        <span class="h-2 w-2 rounded-full bg-success"></span>
        Published
      <% elsif post.status == "scheduled" %>
        <span class="h-2 w-2 rounded-full bg-info"></span>
        Scheduled
      <% else %>
        <span class="h-2 w-2 rounded-full bg-warning"></span>
        Draft
      <% end %>
    </span>
    <span class="text-xs text-muted-foreground">· Public</span>
  </div>
<% if post.published_at %>
    <p class="text-xs text-muted-foreground mt-1"><%= post.published_at.strftime("%b %-d, %Y at %-l:%M %P") %></p>
<% end %>
<% if post.persisted? %>
  <a href="<%= admin_post_revisions_path(post) %>" class="mt-2 inline-flex items-center gap-1 text-xs font-medium text-muted-foreground hover:text-primary">
    <%= render Ink::Icon.new(:history, size: :xs) %>
    Revision history
  </a>
<% end %>
</div>

<hr class="border-border mb-4">

<%# ── Featured Image ────────────────────────────────────────────── %>
<div class="mb-4" data-controller="media-picker">
  <h3 class="text-[10px] font-semibold text-muted-foreground uppercase tracking-[.04em] mb-2">Featured image</h3>
  <%= f.hidden_field :featured_image_id, data: { media_picker_target: "urlField" } %>
  <%= f.hidden_field :featured_image_alt, data: { media_picker_target: "altField" } %>
  <div data-media-picker-target="preview" class="flex h-32 items-center justify-center overflow-hidden rounded-lg border border-border bg-muted/30">
    <% if post.featured_image %>
      <img src="<%= post.featured_image.url %>" alt="" class="h-full w-full object-cover">
    <% else %>
      <span class="text-xs text-muted-foreground">No featured image</span>
    <% end %>
  </div>
  <div class="mt-2 flex gap-2">
    <button type="button" data-action="media-picker#open" class="inline-flex h-7 items-center rounded-md border border-border px-2 text-[11px] font-semibold text-foreground hover:bg-muted">
      <%= post.featured_image ? "Replace" : "Choose image" %>
    </button>
    <% if post.featured_image %>
      <button type="button" data-action="media-picker#clear" class="inline-flex h-7 items-center rounded-md px-2 text-[11px] font-semibold text-muted-foreground hover:bg-muted hover:text-foreground">Remove</button>
    <% end %>
  </div>
  <dialog data-media-picker-target="dialog" data-action="click->media-picker#backdropClose" class="m-auto w-[42rem] max-w-[calc(100vw-2rem)] rounded-xl border border-border bg-background p-0 shadow-2xl backdrop:bg-black/50">
    <div class="flex items-center justify-between border-b border-border px-4 py-3">
      <h3 class="text-sm font-semibold text-foreground">Choose featured image</h3>
      <button type="button" data-action="media-picker#close" class="rounded-md p-1 text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Close">✕</button>
    </div>
    <div class="max-h-[60vh] overflow-y-auto">
      <turbo-frame id="featured-image-picker-frame" data-media-picker-target="frame" data-src="<%= admin_media_path(picker: 1) %>">
        <div class="p-4 text-center text-sm text-muted-foreground">Loading…</div>
      </turbo-frame>
    </div>
  </dialog>
</div>

<hr class="border-border mb-4">

<%# ── Organize ──────────────────────────────────────────────────── %>
<div class="mb-4">
  <h3 class="text-[10px] font-semibold text-muted-foreground uppercase tracking-[.04em] mb-2">Organize</h3>
  <div class="space-y-3">
    <div>
      <label class="text-xs text-muted-foreground">Category</label>
      <div class="mt-1 flex flex-wrap gap-1.5">
        <% post.categories.each do |cat| %>
          <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 text-primary text-xs px-2 py-0.5 font-medium">
            <%= cat.name %>
          </span>
        <% end %>
        <a href="<%= admin_taxonomies_path(taxonomy: "category") %>" class="text-[11px] font-medium text-muted-foreground hover:text-primary">Manage</a>
      </div>
    </div>
    <div>
      <label class="text-xs text-muted-foreground">Tags</label>
      <div class="mt-1 flex flex-wrap gap-1.5">
        <% post.tags.each do |tag| %>
          <span class="inline-flex items-center gap-1 rounded-full bg-muted text-foreground text-xs px-2 py-0.5">
            <%= tag.name %>
          </span>
        <% end %>
        <a href="<%= admin_taxonomies_path(taxonomy: "tag") %>" class="text-[11px] font-medium text-muted-foreground hover:text-primary">Manage</a>
      </div>
    </div>
  </div>
</div>

<hr class="border-border mb-4">

<%# ── Discovery (Excerpt + SEO + Social) ─────────────────────────── %>
<div class="mb-4">
  <h3 class="text-[10px] font-semibold text-muted-foreground uppercase tracking-[.04em] mb-3">Discovery</h3>

  <details class="group mb-2">
    <summary class="flex items-center justify-between text-sm text-foreground cursor-pointer py-1 hover:text-primary transition-colors">
      <span>Excerpt</span>
      <%= render Ink::Icon.new(:chevron_right, size: :xs) %>
    </summary>
    <div class="mt-2 pl-0">
      <%= f.text_area :excerpt, rows: 4, placeholder: "A brief summary for search results and social cards…", class: "w-full text-sm border border-border rounded-lg px-3 py-2 bg-background text-foreground placeholder:text-muted-foreground resize-none focus:outline-none focus:ring-2 focus:ring-ring/20" %>
    </div>
  </details>

  <%# Plugin-owned discovery panels (SEO, analytics, etc.). %>
  <% Array(Inkwell::Hooks.filter(:post_editor_panels, [], post: post)).each do |panel| %>
    <%= raw panel %>
  <% end %>

  <details class="group">
    <summary class="flex items-center justify-between text-sm text-foreground cursor-pointer py-1 hover:text-primary transition-colors">
      <span>Discussion</span>
      <%= render Ink::Icon.new(:chevron_right, size: :xs) %>
    </summary>
    <div class="mt-2 pl-0">
      <p class="text-xs text-muted-foreground">Comments: <%= post.comments.count %> total, <%= post.comments.pending.count %> pending</p>
    </div>
  </details>
</div>

<hr class="border-border mb-4">

<%# ── Advanced ──────────────────────────────────────────────────── %>
  <details class="group">
    <summary class="flex items-center justify-between text-sm text-foreground cursor-pointer py-1 hover:text-primary transition-colors">
      <span>Advanced</span>
      <%= render Ink::Icon.new(:chevron_right, size: :xs) %>
    </summary>
  <div class="mt-2 pl-0 space-y-3">
    <div>
      <label class="text-xs text-muted-foreground">Categories</label>
      <div class="mt-1 space-y-1 max-h-28 overflow-y-auto">
        <% Term.categories.each do |category| %>
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="post[category_ids][]" value="<%= category.id %>"
                   <%= "checked" if post.categories.include?(category) %> class="rounded accent-current">
            <%= category.name %>
          </label>
        <% end %>
      </div>
    </div>
    <div>
      <label class="text-xs text-muted-foreground">Tags</label>
      <div class="mt-1 space-y-1 max-h-28 overflow-y-auto">
        <% Term.tags.each do |tag| %>
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="post[tag_ids][]" value="<%= tag.id %>"
                   <%= "checked" if post.tags.include?(tag) %> class="rounded accent-current">
            <%= tag.name %>
          </label>
        <% end %>
      </div>
    </div>
  </div>
</details>
