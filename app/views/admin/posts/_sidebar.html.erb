<%# Post inspector sidebar — state-first, not form-first. %>
<%# Sections are collapsed by default; interaction reveals configuration. %>

<%# ── Status ─────────────────────────────────────────────────────── %>
<div class="mb-4">
  <div class="flex items-center gap-2">
    <span class="inline-flex items-center gap-1.5 text-sm font-medium">
      <% if post.status == "published" %>
        <span class="h-2 w-2 rounded-full bg-success"></span>
        Published
      <% elsif post.status == "scheduled" %>
        <span class="h-2 w-2 rounded-full bg-info"></span>
        Scheduled
      <% else %>
        <span class="h-2 w-2 rounded-full bg-warning"></span>
        Draft
      <% end %>
    </span>
    <span class="text-xs text-muted-foreground">· Public</span>
  </div>
  <% if post.published_at %>
    <p class="text-xs text-muted-foreground mt-1"><%= post.published_at.strftime("%b %-d, %Y at %-l:%M %P") %></p>
  <% end %>
</div>

<hr class="border-border mb-4">

<%# ── Featured Image ────────────────────────────────────────────── %>
<div class="mb-4">
  <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-2">Featured image</h3>
  <% if post.featured_image %>
    <div class="relative rounded-lg overflow-hidden border border-border">
      <img src="<%= post.featured_image.url %>" alt="" class="w-full h-32 object-cover">
      <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
    </div>
  <% else %>
    <div class="rounded-lg border-2 border-dashed border-border p-6 text-center cursor-pointer hover:border-muted-foreground transition-colors">
      <%= render NitroKit::Icon.new(:image, size: :md) %>
      <p class="text-xs text-muted-foreground mt-1">Add an image</p>
    </div>
  <% end %>
</div>

<hr class="border-border mb-4">

<%# ── Organize ──────────────────────────────────────────────────── %>
<div class="mb-4">
  <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-2">Organize</h3>
  <div class="space-y-3">
    <div>
      <label class="text-xs text-muted-foreground">Category</label>
      <div class="mt-1 flex flex-wrap gap-1.5">
        <% post.categories.each do |cat| %>
          <span class="inline-flex items-center gap-1 rounded-full bg-primary/10 text-primary text-xs px-2 py-0.5 font-medium">
            <%= cat.name %>
          </span>
        <% end %>
        <button type="button" class="inline-flex items-center gap-1 rounded-full border border-border text-xs px-2 py-0.5 text-muted-foreground hover:text-foreground hover:border-muted-foreground transition-colors">
          <span class="text-[12px]">+</span>
        </button>
      </div>
    </div>
    <div>
      <label class="text-xs text-muted-foreground">Tags</label>
      <div class="mt-1 flex flex-wrap gap-1.5">
        <% post.tags.each do |tag| %>
          <span class="inline-flex items-center gap-1 rounded-full bg-muted text-foreground text-xs px-2 py-0.5">
            <%= tag.name %>
            <button type="button" class="text-muted-foreground hover:text-foreground ml-0.5">&times;</button>
          </span>
        <% end %>
        <button type="button" class="inline-flex items-center gap-1 rounded-full border border-border text-xs px-2 py-0.5 text-muted-foreground hover:text-foreground hover:border-muted-foreground transition-colors">
          <span class="text-[12px]">+</span>
        </button>
      </div>
    </div>
  </div>
</div>

<hr class="border-border mb-4">

<%# ── Discovery (Excerpt + SEO + Social) ─────────────────────────── %>
<div class="mb-4">
  <h3 class="text-xs font-semibold text-muted-foreground uppercase tracking-wide mb-3">Discovery</h3>

  <details class="group mb-2">
    <summary class="flex items-center justify-between text-sm text-foreground cursor-pointer py-1 hover:text-primary transition-colors">
      <span>Excerpt</span>
      <%= render NitroKit::Icon.new(:chevron_right, size: :xs) %>
    </summary>
    <div class="mt-2 pl-0">
      <%= f.text_area :excerpt, rows: 4, placeholder: "A brief summary for search results and social cards…", class: "w-full text-sm border border-border rounded-lg px-3 py-2 bg-background text-foreground placeholder:text-muted-foreground resize-none focus:outline-none focus:ring-2 focus:ring-ring/20" %>
    </div>
  </details>

  <details class="group mb-2">
    <summary class="flex items-center justify-between text-sm text-foreground cursor-pointer py-1 hover:text-primary transition-colors">
      <span>SEO</span>
      <%= render NitroKit::Icon.new(:chevron_right, size: :xs) %>
    </summary>
    <div class="mt-2 pl-0 space-y-3">
      <div>
        <label class="text-xs text-muted-foreground">Search title</label>
        <%= f.text_field :seo_title, placeholder: post.title, class: "mt-1 w-full text-sm border border-border rounded px-2 py-1.5 bg-background text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring/20" %>
      </div>
      <div>
        <label class="text-xs text-muted-foreground">Description</label>
        <%= f.text_area :seo_description, rows: 2, placeholder: "Auto-generated from content if left empty", class: "w-full text-sm border border-border rounded px-2 py-1.5 bg-background text-foreground placeholder:text-muted-foreground resize-none focus:outline-none focus:ring-2 focus:ring-ring/20" %>
      </div>
      <div class="flex items-center gap-4">
        <label class="flex items-center gap-1.5 text-xs text-muted-foreground">
          <%= f.check_box :noindex, class: "rounded accent-primary" %> Noindex
        </label>
        <label class="flex items-center gap-1.5 text-xs text-muted-foreground">
          <%= f.check_box :nofollow, class: "rounded accent-primary" %> Nofollow
        </label>
      </div>
    </div>
  </details>

  <details class="group">
    <summary class="flex items-center justify-between text-sm text-foreground cursor-pointer py-1 hover:text-primary transition-colors">
      <span>Discussion</span>
      <%= render NitroKit::Icon.new(:chevron_right, size: :xs) %>
    </summary>
    <div class="mt-2 pl-0">
      <p class="text-xs text-muted-foreground">Comments: <%= post.comments.count %> total, <%= post.comments.pending.count %> pending</p>
    </div>
  </details>
</div>

<hr class="border-border mb-4">

<%# ── Advanced ──────────────────────────────────────────────────── %>
  <details class="group">
    <summary class="flex items-center justify-between text-sm text-foreground cursor-pointer py-1 hover:text-primary transition-colors">
      <span>Advanced</span>
      <%= render NitroKit::Icon.new(:chevron_right, size: :xs) %>
    </summary>
  <div class="mt-2 pl-0 space-y-3">
    <div>
      <label class="text-xs text-muted-foreground">Categories</label>
      <div class="mt-1 space-y-1 max-h-28 overflow-y-auto">
        <% Term.categories.each do |category| %>
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="post[category_ids][]" value="<%= category.id %>"
                   <%= "checked" if post.categories.include?(category) %> class="rounded accent-current">
            <%= category.name %>
          </label>
        <% end %>
      </div>
    </div>
    <div>
      <label class="text-xs text-muted-foreground">Tags</label>
      <div class="mt-1 space-y-1 max-h-28 overflow-y-auto">
        <% Term.tags.each do |tag| %>
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="post[tag_ids][]" value="<%= tag.id %>"
                   <%= "checked" if post.tags.include?(tag) %> class="rounded accent-current">
            <%= tag.name %>
          </label>
        <% end %>
      </div>
    </div>
  </div>
</details>
