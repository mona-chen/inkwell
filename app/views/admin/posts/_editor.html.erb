<%# The block editor. `post.content` seeds the initial blocks server-side (rendered as real
    fields, not JSON dumped into a textarea) so it degrades gracefully with JS disabled — you'd
    just get a flat reorderable list without drag animation, still fully editable and submittable.

    Autosave: the controller serializes the blocks to the hidden field, and a debounced fetch
    PATCHes the record in the background (the same update endpoint the form submits to), so
    work is never lost. Undo/redo + a live "Saved / Saving…" indicator live in the toolbar. %>

<div data-controller="block-editor"
     data-block-editor-types-value="<%= BlockRenderer.registered_types.to_json %>"
     data-block-editor-save-url-value="<%= post.new_record? ? nil : admin_post_path(post) %>"
     data-block-editor-resource-key-value="post"
     class="admin-block-editor grid gap-6">

  <div class="relative min-w-0 w-full">
    <%# Hidden field carries the serialized draft blocks. Bound to draft_content so the
        form's "Save draft" persists them (autosave also PATCHes the same key). %>
    <input type="hidden" name="post[draft_content]" data-block-editor-target="hiddenField" value="<%= html_escape(post.editing_blocks.to_json) %>">

    <%# Editor toolbar: undo/redo + save status + add block %>
    <div class="sticky top-14 z-20 -mx-1 mb-5 flex min-h-10 items-center justify-between gap-3 border-y border-border/70 bg-background/90 px-1 py-1.5 backdrop-blur-xl">
      <div class="flex items-center gap-1">
        <button type="button" data-action="block-editor#toggleFocus" aria-pressed="false" title="Focus on writing" class="ink-writing-focus-toggle">Focus</button>
        <button type="button" data-action="block-editor#undo"
                class="inline-flex h-7 items-center gap-1 rounded-md px-2 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground disabled:cursor-not-allowed disabled:opacity-40"
                data-block-editor-target="undoButton" title="Undo (Ctrl+Z)" aria-label="Undo">
          ↺ Undo
        </button>
        <button type="button" data-action="block-editor#redo"
                class="inline-flex h-7 items-center gap-1 rounded-md px-2 text-xs font-medium text-muted-foreground hover:bg-muted hover:text-foreground disabled:cursor-not-allowed disabled:opacity-40"
                data-block-editor-target="redoButton" title="Redo (Ctrl+Y)" aria-label="Redo">
          ↻ Redo
        </button>
      </div>

      <div class="flex min-w-0 items-center justify-end gap-2">
        <span data-block-editor-target="wordCount" class="text-xs text-muted-foreground">
          0 words · < 1 min read
        </span>
        <span data-block-editor-target="saveStatus" class="text-xs text-muted-foreground">
          <%= post.new_record? ? "New — not saved yet" : "Saved" %>
        </span>
        <%# Plugin-injected editor controls (e.g. the AI Writer plugin's button + dialog) %>
        <% BlockRenderer.editor_toolbar_partials.each { |p| concat(render(p, record: post)) } %>
        <%= render "admin/posts/blocks/picker" %>
        <span class="mx-0.5 hidden h-5 w-px bg-border sm:block"></span>
        <% if post.status == "published" %>
          <button type="submit"
                  class="inline-flex h-8 items-center rounded-lg border border-border bg-background px-3 text-xs font-semibold text-foreground transition-colors hover:bg-muted">
            Save draft
          </button>
        <% else %>
          <button type="submit" name="save_draft" value="1"
                  class="inline-flex h-8 items-center rounded-lg border border-border bg-background px-3 text-xs font-semibold text-foreground transition-colors hover:bg-muted">
            Save draft
          </button>
        <% end %>
        <% if post.persisted? %>
          <button type="submit" formaction="<%= publish_admin_post_path(post) %>" formmethod="post"
                  class="inline-flex h-8 items-center rounded-lg bg-primary px-3 text-xs font-semibold text-primary-foreground shadow-sm transition-colors hover:bg-primary/90">
            <%= post.status == "published" ? "Update" : "Publish" %>
          </button>
        <% end %>
      </div>
    </div>

    <div data-block-editor-target="list" class="relative space-y-1 min-h-24">
      <% post.editing_blocks.each do |block| %>
        <%= render BlockRenderer.editor_partial(block['type']), data: block["data"], record: post %>
      <% end %>
    </div>

    <%# Floating slash-command ("/") insertion menu, positioned by the Stimulus controller %>
    <div data-block-editor-target="slashMenu" class="hidden absolute z-20 left-0 w-48 bg-background border border-border rounded-lg shadow-lg py-1"></div>

    <button type="button" data-block-editor-target="emptyState" data-action="block-editor#addBlock" data-block-editor-type-param="paragraph"
            class="ink-writing-start <%= 'hidden' unless post.editing_blocks.empty? %>">
      <span>Start writing…</span>
      <small>Click here to write. Type / to add a heading, image, or another block.</small>
    </button>

    <%# Hidden <template> elements the Stimulus controller clones when a block type is picked %>
    <%= render "admin/posts/blocks/templates" %>
  </div>

  <aside class="admin-block-editor__inspector min-w-0 space-y-4">
    <%= render "admin/posts/sidebar", f: f, post: post %>
  </aside>
</div>

<%# Full-width plugin workspaces belong after the editor, outside the narrow inspector. %>
<% Array(Inkwell::Hooks.filter(:post_editor_after_content, [], post: post)).each do |panel| %>
  <%= raw panel %>
<% end %>
