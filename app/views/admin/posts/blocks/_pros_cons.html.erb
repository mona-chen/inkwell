<% data = local_assigns[:data] || {} %>
<div data-block-editor-target="block" data-type="pros_cons" class="group relative py-1.5 px-1 -mx-1 rounded transition-colors">
  <%= render "admin/posts/blocks/toolbar" %>
  <div class="ink-sblock ink-sblock--pros-cons">
    <%= render "admin/posts/blocks/block_label", type: "pros_cons", hint: "Pros/cons or “Choose X if…”" %>
    <div class="ink-sblock__columns">
      <% [ [ "pros", "Pros", "Choose Ruut if…" ], [ "cons", "Cons", "Choose the alternative if…" ] ].each do |key, fallback, example| %>
        <div class="ink-sblock__column ink-sblock__column--<%= key %>" data-controller="item-list" data-item-list-placeholder-value="Point" data-item-list-max-value="12">
          <input type="text" data-field="<%= key %>_title" data-action="input->block-editor#serialize" value="<%= data["#{key}_title"] %>" placeholder="<%= fallback %> — or e.g. <%= example %>" class="ink-sblock__title" aria-label="<%= fallback %> title">
          <input type="hidden" data-field="<%= key %>" data-field-format="json" data-item-list-target="field" data-action="input->block-editor#serialize" value="<%= Array(data[key].presence || []).to_json %>">
          <div class="ink-items" data-item-list-target="rows"></div>
        </div>
      <% end %>
    </div>
  </div>
</div>
