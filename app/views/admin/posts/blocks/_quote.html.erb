<div data-block-editor-target="block" data-type="quote"
     class="group relative py-1.5 px-1 -mx-1 rounded transition-colors hover:bg-white/5">
  <%= render "admin/posts/blocks/toolbar" %>
  <textarea data-field="text" data-action="input->block-editor#onInput keydown->block-editor#onKeydown" rows="2"
            placeholder="Quote text" class="w-full border-0 focus:ring-0 resize-none italic text-lg p-0 bg-transparent text-foreground placeholder:text-muted-foreground"><%= local_assigns[:data]&.dig("text") %></textarea>
  <input data-field="attribution" data-action="input->block-editor#serialize" type="text"
         value="<%= local_assigns[:data]&.dig("attribution") %>" placeholder="Attribution (optional)"
         class="w-full text-sm border-0 focus:ring-0 mt-2 p-0 bg-transparent text-foreground placeholder:text-muted-foreground">
</div>
