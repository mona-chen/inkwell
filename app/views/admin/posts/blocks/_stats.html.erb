<% data = local_assigns[:data] || {} %>
<div data-block-editor-target="block" data-type="stats" class="group relative py-1.5 px-1 -mx-1 rounded transition-colors">
  <%= render "admin/posts/blocks/toolbar" %>
  <div class="ink-sblock ink-sblock--stats" data-controller="item-list" data-item-list-max-value="4" data-item-list-add-label-value="Add stat"
       data-item-list-fields-value="<%= [ { key: "value", label: "Value", placeholder: "70%", strong: true }, { key: "label", label: "Label", placeholder: "lower cost per contact" }, { key: "note", label: "Note", placeholder: "Optional detail" } ].to_json %>">
    <%= render "admin/posts/blocks/block_label", type: "stats", hint: "2–4 headline numbers" %>
    <input type="hidden" data-field="items" data-field-format="json" data-item-list-target="field" data-action="input->block-editor#serialize" value="<%= Array(data["items"].presence || []).to_json %>">
    <div class="ink-items" data-item-list-target="rows"></div>
    <input type="text" data-field="source" data-action="input->block-editor#serialize" value="<%= data["source"] %>" placeholder="Source (optional)" class="ink-sblock__note" aria-label="Stats source">
  </div>
</div>
