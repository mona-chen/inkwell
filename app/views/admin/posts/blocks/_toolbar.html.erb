<%# Shared per-block floating toolbar: drag handle + reorder + insert + duplicate + delete.
    Shown on hover (when nothing is selected) and on selection (block gets `.block-selected`).
    Hover-reveal is suppressed once a block is selected — see `.editor-has-selection` rules in
    application.css — so moving toward an open toolbar never trips a neighboring block's. %>
<div class="block-toolbar absolute -left-8 top-4 z-50 flex flex-col rounded-lg border border-gray-200 bg-white shadow-sm py-1">
  <button type="button" data-block-editor-target="dragHandle"
          class="flex items-center justify-center w-8 h-8 text-gray-500 hover:bg-gray-100 hover:text-gray-900 cursor-grab"
          title="Drag to reorder" aria-label="Drag to reorder">⠿</button>
  <button type="button" data-action="block-editor#insertAbove"
          class="flex items-center justify-center w-8 h-8 text-gray-500 hover:bg-gray-100 hover:text-gray-900"
          title="Insert above" aria-label="Insert block above">↥</button>
  <button type="button" data-action="block-editor#moveUp"
          class="flex items-center justify-center w-8 h-8 text-gray-500 hover:bg-gray-100 hover:text-gray-900"
          title="Move up" aria-label="Move block up">↑</button>
  <button type="button" data-action="block-editor#moveDown"
          class="flex items-center justify-center w-8 h-8 text-gray-500 hover:bg-gray-100 hover:text-gray-900"
          title="Move down" aria-label="Move block down">↓</button>
  <button type="button" data-action="block-editor#insertBelow"
          class="flex items-center justify-center w-8 h-8 text-gray-500 hover:bg-gray-100 hover:text-gray-900"
          title="Insert below" aria-label="Insert block below">↧</button>
  <button type="button" data-action="block-editor#duplicateBlock"
          class="flex items-center justify-center w-8 h-8 text-gray-500 hover:bg-gray-100 hover:text-gray-900"
          title="Duplicate" aria-label="Duplicate block">⧉</button>
  <button type="button" data-action="block-editor#removeBlock"
          class="flex items-center justify-center w-8 h-8 text-gray-500 hover:bg-red-50 hover:text-red-600"
          title="Delete block" aria-label="Delete block">✕</button>
</div>
