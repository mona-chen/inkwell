<div class="block-toolbar composer-block-controls">
  <button type="button" data-block-editor-target="dragHandle" class="composer-block-grip" title="Drag to reorder" aria-label="Drag to reorder"><%= render Ink::Icon.new(:grip_vertical, size: :sm) %></button>
  <details class="composer-block-menu" data-action="toggle->block-editor#blockMenuToggled">
    <summary aria-label="Block actions" title="Block actions"><%= render Ink::Icon.new(:ellipsis, size: :sm) %></summary>
    <div class="composer-block-popover">
      <p>BLOCK ACTIONS</p>
      <button type="button" data-action="block-editor#insertAbove">Insert above <%= render Ink::Icon.new(:arrow_up, size: :xs) %></button>
      <button type="button" data-action="block-editor#insertBelow">Insert below <%= render Ink::Icon.new(:arrow_down, size: :xs) %></button>
      <button type="button" data-action="block-editor#moveUp">Move up <kbd>⌘ ⇧ ↑</kbd></button>
      <button type="button" data-action="block-editor#moveDown">Move down <kbd>⌘ ⇧ ↓</kbd></button>
      <button type="button" data-action="block-editor#duplicateBlock">Duplicate <%= render Ink::Icon.new(:copy, size: :xs) %></button>
      <div class="composer-convert-options">
        <p>TURN INTO</p>
        <button type="button" data-action="block-editor#changeBlockType" data-block-editor-type-param="paragraph">Text</button>
        <button type="button" data-action="block-editor#changeBlockType" data-block-editor-type-param="heading" data-block-editor-level-param="2">Heading 2</button>
        <button type="button" data-action="block-editor#changeBlockType" data-block-editor-type-param="heading" data-block-editor-level-param="3">Heading 3</button>
        <button type="button" data-action="block-editor#changeBlockType" data-block-editor-type-param="rich_text">Formatted text <%= render Ink::Icon.new(:bold, size: :xs) %></button>
      </div>
      <button type="button" data-action="block-editor#removeBlock" class="composer-delete">Delete block <%= render Ink::Icon.new(:trash_2, size: :xs) %></button>
    </div>
  </details>
</div>
