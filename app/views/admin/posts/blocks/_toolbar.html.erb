<%# Per-block toolbar: drag handle + context menu. Hidden by default, revealed on hover/focus. %>
<div class="block-toolbar absolute -left-8 top-1/2 -translate-y-1/2 z-50 flex flex-col rounded-lg border border-border bg-background shadow-sm py-1 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none group-hover:pointer-events-auto">
  <button type="button" data-block-editor-target="dragHandle"
          class="flex items-center justify-center w-7 h-7 text-muted-foreground hover:text-foreground hover:bg-muted cursor-grab rounded"
          title="Drag to reorder" aria-label="Drag to reorder">⠿</button>
  <button type="button" data-action="block-editor#duplicateBlock"
          class="flex items-center justify-center w-7 h-7 text-muted-foreground hover:text-foreground hover:bg-muted rounded opacity-0 group-hover:opacity-100 transition-opacity"
          title="Duplicate" aria-label="Duplicate block">⧉</button>
  <button type="button" data-action="block-editor#removeBlock"
          class="flex items-center justify-center w-7 h-7 text-muted-foreground hover:text-red-500 hover:bg-red-50 rounded opacity-0 group-hover:opacity-100 transition-opacity"
          title="Delete block" aria-label="Delete block">✕</button>
</div>
