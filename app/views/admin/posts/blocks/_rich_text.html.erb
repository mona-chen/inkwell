<div data-block-editor-target="block" data-type="rich_text"
     data-controller="rich-text"
     class="group relative py-1.5 px-1 -mx-1 rounded transition-colors hover:bg-white/5">
  <%= render "admin/posts/blocks/toolbar" %>
  <input type="hidden" data-rich-text-target="hiddenField" data-field="json"
         data-action="change->block-editor#serialize"
         value="<%= html_escape(local_assigns[:data]&.dig("json")) %>">

  <%# WYSIWYG toolbar — hidden by default, shown on hover/focus via CSS %>
  <div data-rich-text-target="toolbar" class="composer-formatting" role="toolbar" aria-label="Text formatting">
    <% [
      [["setParagraph", nil, "pilcrow", "Paragraph"], ["toggleHeading", 1, "heading_1", "Heading 1"], ["toggleHeading", 2, "heading_2", "Heading 2"], ["toggleHeading", 3, "heading_3", "Heading 3"]],
      [["toggleBold", nil, "bold", "Bold"], ["toggleItalic", nil, "italic", "Italic"], ["toggleUnderline", nil, "underline", "Underline"], ["toggleStrike", nil, "strikethrough", "Strikethrough"], ["toggleCode", nil, "code", "Inline code"]],
      [["toggleBulletList", nil, "list", "Bullet list"], ["toggleOrderedList", nil, "list_ordered", "Numbered list"], ["toggleBlockquote", nil, "quote", "Quote"], ["toggleCodeBlock", nil, "square_code", "Code block"], ["setHorizontalRule", nil, "minus", "Divider"]],
      [["toggleLink", nil, "link", "Insert link"], ["unsetLink", nil, "unlink", "Remove link"]]
    ].each do |group| %>
      <div class="composer-format-group">
        <% group.each do |command, argument, icon, label| %>
          <button type="button" data-command="<%= command %>" <%= "data-arg=#{argument}" if argument %> title="<%= label %>" aria-label="<%= label %>" class="rich-text-btn"><%= render Ink::Icon.new(icon, size: :sm) %></button>
        <% end %>
      </div>
    <% end %>
  </div>

  <div data-rich-text-target="editor" class="rich-text text-sm leading-relaxed"></div>
  <dialog data-rich-text-target="linkDialog" class="composer-link-dialog" aria-label="Edit link">
    <h3>Insert a link</h3>
    <p>Give your readers somewhere useful to go.</p>
    <label>Link address
      <input type="text" data-rich-text-target="linkUrl" data-action="keydown->rich-text#linkKeydown" placeholder="https://example.com" autocomplete="off">
    </label>
    <p data-rich-text-target="linkError" class="composer-link-error" role="alert"></p>
    <div><button type="button" data-action="rich-text#closeLink" class="composer-save">Cancel</button><button type="button" data-action="rich-text#applyLink" class="composer-publish-button">Apply link</button></div>
  </dialog>
</div>
