<%# Gutenberg-style image block. Empty state = upload / media library / paste-URL drop zone.
    Populated state = large preview with Replace/Remove + revealed alt/caption fields. The
    chosen value always lands in the hidden data-field="url" input, so the block editor
    serializes it exactly like before. The picker frame id is unique per block so multiple
    image blocks on the page never collide. %>
<% frame_id = "media-picker-frame-#{SecureRandom.hex(4)}" %>
<div data-block-editor-target="block" data-type="image"
     data-controller="image-block"
     class="ink-image-block group relative min-w-0 max-w-full py-1.5 px-1 -mx-1 rounded transition-colors hover:bg-white/5">
  <%= render "admin/posts/blocks/toolbar" %>
  <input type="hidden" data-field="url" data-image-block-target="url"
         data-action="input->block-editor#serialize"
         value="<%= html_escape(local_assigns[:data]&.dig("url")) %>">

  <%# Empty state: drop zone with upload + media library + paste-URL %>
  <div data-image-block-target="empty">
    <div data-image-block-target="dropzone"
         data-action="dragover->image-block#dragOver dragleave->image-block#dragLeave drop->image-block#drop"
         class="rounded-lg border-2 border-dashed border-border bg-muted p-8 text-center transition-colors hover:border-foreground">
      <p class="text-sm font-medium text-muted-foreground">Drag &amp; drop an image here</p>
      <div class="mt-4 flex items-center justify-center gap-2">
        <button type="button" data-action="image-block#pickFile"
                class="inline-flex items-center gap-1.5 rounded-md bg-canvas px-3 py-1.5 text-xs font-medium text-white shadow-sm hover:bg-foreground transition-colors">
          Upload
        </button>
        <button type="button" data-action="image-block#openPicker"
                class="inline-flex items-center gap-1.5 rounded-md border border-border bg-background px-3 py-1.5 text-xs font-medium text-muted-foreground hover:bg-muted transition-colors">
          Media library
        </button>
      </div>
      <div class="mt-4 mx-auto max-w-xs">
        <input type="text" data-action="change->image-block#applyUrl"
               placeholder="…or paste an image URL" class="w-full rounded-md border border-border px-2 py-1.5 text-xs focus:outline-none">
      </div>
    </div>
    <input type="file" accept="image/*" class="hidden" data-image-block-target="file"
           data-action="change->image-block#upload">
  </div>

  <%# Populated state: large preview + replace/remove + alt/caption %>
  <div data-image-block-target="populated" class="hidden">
    <div class="ink-image-block__preview relative overflow-hidden rounded-lg bg-muted border border-border">
      <img data-image-block-target="preview" src="" alt=""
           data-action="load->image-block#loaded error->image-block#failed"
           class="mx-auto block max-h-96 max-w-full object-contain">
      <div data-image-block-target="error" class="hidden min-h-36 items-center justify-center p-6 text-center" role="status">
        <div class="max-w-md">
          <p class="text-sm font-medium text-foreground">Image unavailable</p>
          <p class="mt-1 text-xs leading-5 text-muted-foreground">The source could not be loaded. Replace it, remove it, or correct the saved URL.</p>
          <p data-image-block-target="errorUrl" class="mt-2 truncate font-mono text-[10px] text-muted-foreground"></p>
        </div>
      </div>
    </div>
    <div class="mt-2 flex items-center gap-2">
      <button type="button" data-action="image-block#openPicker"
              class="rounded-md border border-border bg-background px-2.5 py-1 text-xs font-medium text-muted-foreground hover:bg-muted transition-colors">Replace</button>
      <button type="button" data-action="image-block#remove"
              class="rounded-md border border-danger/30 bg-danger/10 px-2.5 py-1 text-xs font-medium text-danger hover:bg-danger/20 transition-colors">Remove</button>
      <span class="text-xs text-muted-foreground">Drag &amp; drop to replace</span>
    </div>
    <div class="mt-3 space-y-2">
      <input type="text" data-field="alt" data-image-block-target="alt"
             data-action="input->block-editor#serialize" placeholder="Alt text (for screen readers)"
             value="<%= html_escape(local_assigns[:data]&.dig("alt")) %>"
              class="w-full rounded-md border border-border px-2 py-1.5 text-sm focus:outline-none">
      <input type="text" data-field="caption" data-image-block-target="caption"
             data-action="input->block-editor#serialize" placeholder="Caption (optional)"
             value="<%= html_escape(local_assigns[:data]&.dig("caption")) %>"
             class="w-full rounded-md border border-border px-2 py-1.5 text-sm focus:outline-none">
    </div>
  </div>

  <%# Media picker dialog (frame id unique per block so picker events scope correctly) %>
  <dialog data-image-block-target="dialog" data-action="click->image-block#backdropClose"
          class="m-auto w-[42rem] max-w-full rounded-2xl border border-border bg-background p-0 shadow-2xl backdrop:bg-black/40">
    <div class="flex items-center justify-between border-b border-border px-4 py-3">
      <h3 class="text-sm font-semibold text-foreground">Media library</h3>
      <button type="button" data-action="image-block#closePicker" class="rounded-md p-1 text-muted-foreground hover:bg-muted hover:text-foreground" aria-label="Close">✕</button>
    </div>
    <div class="max-h-[60vh] overflow-y-auto">
      <turbo-frame id="<%= frame_id %>" data-image-block-target="frame"
                   data-src="<%= admin_media_path(picker: 1) %>">
        <div class="p-4 text-center text-sm text-muted-foreground">Loading…</div>
      </turbo-frame>
    </div>
  </dialog>
</div>
