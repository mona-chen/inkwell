<div data-block-editor-target="block" data-type="image"
     data-action="focusin->block-editor#selectBlock"
     class="group relative border border-gray-200 rounded-lg p-4 bg-white hover:border-gray-300 transition-colors"
     data-controller="media-picker">
  <%= render "admin/posts/blocks/toolbar" %>
  <div class="flex gap-4 items-start">
    <div class="w-32 h-32 bg-gray-100 rounded-md flex items-center justify-center overflow-hidden shrink-0" data-media-picker-target="preview">
      <% if local_assigns[:data]&.dig("url").present? %>
        <img src="<%= data["url"] %>" class="w-full h-full object-cover">
      <% else %>
        <span class="text-gray-400 text-xs">No image</span>
      <% end %>
    </div>
    <div class="flex-1 space-y-2">
      <input data-field="url" data-media-picker-target="urlField" data-action="input->block-editor#serialize" type="text"
             value="<%= local_assigns[:data]&.dig("url") %>" placeholder="Image URL (or pick from media library)"
             class="w-full text-sm border rounded px-2 py-1">
      <button type="button" data-action="media-picker#open" class="text-xs text-gray-900 hover:underline">Choose from media library</button>
      <input data-field="alt" data-media-picker-target="altField" data-action="input->block-editor#serialize" type="text"
             value="<%= local_assigns[:data]&.dig("alt") %>" placeholder="Alt text"
             class="w-full text-sm border rounded px-2 py-1">
      <input data-field="caption" data-action="input->block-editor#serialize" type="text"
             value="<%= local_assigns[:data]&.dig("caption") %>" placeholder="Caption (optional)"
             class="w-full text-sm border rounded px-2 py-1">
    </div>
  </div>

  <%# Media picker dialog: loads the picker grid in a Turbo Frame %>
  <dialog data-media-picker-target="dialog" data-action="click->media-picker#backdropClose"
          class="m-auto w-[42rem] max-w-full rounded-2xl border border-gray-200 bg-white p-0 shadow-2xl backdrop:bg-black/40">
    <div class="flex items-center justify-between border-b border-gray-100 px-4 py-3">
      <h3 class="text-sm font-semibold text-gray-900">Media library</h3>
      <button type="button" data-action="media-picker#close" class="rounded-md p-1 text-gray-400 hover:bg-gray-100 hover:text-gray-700" aria-label="Close">
        ✕
      </button>
    </div>
    <div class="max-h-[60vh] overflow-y-auto">
      <turbo-frame id="media-picker-frame" data-media-picker-target="frame"
                   data-src="<%= admin_media_path(picker: 1) %>">
        <div class="p-4 text-center text-sm text-gray-400">Loading…</div>
      </turbo-frame>
    </div>
  </dialog>
</div>
