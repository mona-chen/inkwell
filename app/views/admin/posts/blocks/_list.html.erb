<div data-block-editor-target="block" data-type="list"
     class="group relative py-1.5 px-1 -mx-1 rounded transition-colors hover:bg-white/5">
  <%= render "admin/posts/blocks/toolbar" %>
  <div data-controller="choice-field list-block" data-action="input->list-block#render" class="space-y-2">
    <input type="checkbox" data-field="ordered" data-choice-field-target="input" class="hidden"
           <%= "checked" if local_assigns[:data]&.dig("ordered") %>>
    <div class="choice-field" role="radiogroup" aria-label="List style">
      <button type="button" data-choice-field-target="button" data-value="false"
              data-action="choice-field#choose" role="radio" aria-label="Bulleted list"
              class="choice-btn">• Bulleted</button>
      <button type="button" data-choice-field-target="button" data-value="true"
              data-action="choice-field#choose" role="radio" aria-label="Numbered list"
              class="choice-btn">1. Numbered</button>
    </div>
    <textarea data-field="items" data-list-block-target="items"
              data-action="input->block-editor#onInput input->list-block#render keydown->block-editor#onKeydown"
              rows="3" placeholder="One item per line&#10;Like this&#10;And this"
              class="w-full resize-none rounded-lg border border-border/70 bg-background/40 px-3 py-2 text-sm leading-6 text-foreground placeholder:text-muted-foreground focus:border-primary/50 focus:outline-none focus:ring-2 focus:ring-primary/10"><%= local_assigns[:data]&.dig("items") %></textarea>
    <%# Keep the controller target for serialization without duplicating the authored list. %>
    <div data-list-block-target="preview" class="hidden" aria-hidden="true"></div>
  </div>
</div>
