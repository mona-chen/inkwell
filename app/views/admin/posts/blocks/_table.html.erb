<% data = local_assigns[:data] || {} %>
<div data-block-editor-target="block" data-type="table" class="group relative py-1.5 px-1 -mx-1 rounded transition-colors">
  <%= render "admin/posts/blocks/toolbar" %>
  <div class="ink-sblock ink-sblock--table" data-controller="table-block">
    <%= render "admin/posts/blocks/block_label", type: "table", hint: "Paste cells from Sheets or Excel · ☆ highlights a column" %>
    <input type="text" data-field="caption" data-action="input->block-editor#serialize" value="<%= data["caption"] %>" placeholder="Table title (e.g. Ruut vs Intercom at a glance)" class="ink-sblock__title" aria-label="Table title">
    <input type="hidden" data-field="columns" data-field-format="json" data-table-block-target="columns" data-action="input->block-editor#serialize" value="<%= data["columns"].present? ? data["columns"].to_json : "" %>">
    <input type="hidden" data-field="rows" data-field-format="json" data-table-block-target="rows" data-action="input->block-editor#serialize" value="<%= data["rows"].present? ? data["rows"].to_json : "" %>">
    <input type="hidden" data-field="highlight" data-field-format="int" data-table-block-target="highlight" value="<%= data["highlight"] %>">
    <div class="ink-table-editor" data-table-block-target="grid"></div>
    <div class="ink-sblock__bar">
      <button type="button" class="ink-items__add" data-action="table-block#addRow">+ Row</button>
      <button type="button" class="ink-items__add" data-action="table-block#addColumn">+ Column</button>
      <label class="ink-sblock__check"><input type="checkbox" data-field="row_headers" data-action="change->block-editor#serialize" <%= "checked" unless data.key?("row_headers") && !ActiveModel::Type::Boolean.new.cast(data["row_headers"]) %>> First column is row labels</label>
    </div>
    <input type="text" data-field="note" data-action="input->block-editor#serialize" value="<%= data["note"] %>" placeholder="Footnote — sources and date checked (supports **bold** and [links](https://…))" class="ink-sblock__note" aria-label="Table footnote">
    <p class="ink-sblock__hint">Tip: type ✓, ✗, yes, no or partial in a cell to show an icon.</p>
  </div>
</div>
