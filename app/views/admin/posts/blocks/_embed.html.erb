<% data = local_assigns[:data] || {} %>
<div data-block-editor-target="block" data-type="embed" class="group relative py-1.5 px-1 -mx-1 rounded transition-colors">
  <%= render "admin/posts/blocks/toolbar" %>
  <div class="ink-sblock ink-sblock--embed">
    <%= render "admin/posts/blocks/block_label", type: "embed", hint: "YouTube, Vimeo or Loom" %>
    <input type="text" data-field="url" data-action="input->block-editor#serialize" value="<%= data["url"] %>" placeholder="Paste a video link — https://www.youtube.com/watch?v=…" inputmode="url" class="ink-sblock__title" aria-label="Video URL">
    <div class="ink-sblock__pair ink-sblock__pair--2">
      <input type="text" data-field="title" data-action="input->block-editor#serialize" value="<%= data["title"] %>" placeholder="Accessible title (e.g. Product walkthrough)" aria-label="Video title">
      <input type="text" data-field="caption" data-action="input->block-editor#serialize" value="<%= data["caption"] %>" placeholder="Caption (optional)" aria-label="Caption">
    </div>
  </div>
</div>
