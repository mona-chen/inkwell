<div data-block-editor-target="block" data-type="button"
     data-action="focusin->block-editor#selectBlock"
     class="group relative border border-gray-200 rounded-lg p-4 bg-white hover:border-gray-300 transition-colors">
  <%= render "admin/posts/blocks/toolbar" %>
  <div class="flex items-center gap-3">
    <select data-field="style" data-action="change->block-editor#serialize" class="text-xs border rounded px-2 py-1">
      <option value="primary" <%= "selected" if local_assigns[:data]&.dig("style") != "secondary" %>>Primary</option>
      <option value="secondary" <%= "selected" if local_assigns[:data]&.dig("style") == "secondary" %>>Secondary</option>
    </select>
    <input data-field="label" data-action="input->block-editor#onInput keydown->block-editor#onKeydown" type="text"
           value="<%= local_assigns[:data]&.dig("label") %>" placeholder="Button label" class="flex-1 border-0 focus:ring-0 text-sm font-medium p-0">
    <input data-field="url" data-action="input->block-editor#serialize" type="text"
           value="<%= local_assigns[:data]&.dig("url") %>" placeholder="https://…" class="flex-1 border-0 focus:ring-0 text-sm text-gray-500 p-0">
  </div>
</div>
