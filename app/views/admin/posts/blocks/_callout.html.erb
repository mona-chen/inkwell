<div data-block-editor-target="block" data-type="callout"
     data-action="focusin->block-editor#selectBlock"
     class="group relative border border-gray-200 rounded-lg p-4 bg-white hover:border-gray-300 transition-colors">
  <%= render "admin/posts/blocks/toolbar" %>
  <div class="flex items-center gap-3 mb-2">
    <select data-field="tone" data-action="change->block-editor#serialize" class="text-xs border rounded px-2 py-1">
      <% %w[info success warning danger].each do |tone| %>
        <option value="<%= tone %>" <%= "selected" if local_assigns[:data]&.dig("tone") == tone %>>Tone · <%= tone %></option>
      <% end %>
    </select>
  </div>
  <textarea data-field="text" data-action="input->block-editor#onInput keydown->block-editor#onKeydown" rows="2"
            placeholder="Callout text" class="w-full border-0 focus:ring-0 resize-none text-sm leading-relaxed p-0"><%= local_assigns[:data]&.dig("text") %></textarea>
</div>
