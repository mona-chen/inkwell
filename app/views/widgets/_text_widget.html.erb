<%# text widget — title + HTML body %>
<div class="widget widget-text">
  <% if widget.title.present? %>
    <h3 class="text-xs font-semibold uppercase tracking-widest text-gray-400"><%= widget.title %></h3>
  <% end %>
  <div class="prose prose-sm mt-3 text-sm leading-relaxed text-gray-600">
    <%= raw widget.config["body"].to_s %>
  </div>
</div>
