<%# Core fallback 404 (used if no theme ships an errors/not_found template). %>
<section class="mx-auto max-w-xl px-5 py-24 text-center">
  <p class="text-sm font-semibold uppercase tracking-widest text-gray-400">404</p>
  <h1 class="mt-4 text-3xl font-bold tracking-tight">Page not found</h1>
  <p class="mt-4 text-gray-500">The page you were looking for doesn't exist.</p>
  <p class="mt-8"><a href="<%= root_path %>" class="text-gray-900 underline underline-offset-2">Back home</a></p>
</section>
